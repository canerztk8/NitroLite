<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tiny helper that empties the Windows standby list and exits. NitroLite copies it to
    C:\Program Files\NitroLite\StandbyPurge (admin-only write) during a one-time setup and registers a
    scheduled task that runs it with highest privileges, so the purge needs no UAC prompt afterwards.
    WinExe: no console window flashes when the task runs.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NitroLite.StandbyPurge</AssemblyName>
    <RootNamespace>NitroLite.StandbyPurge</RootNamespace>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Built next to NitroLite.exe, in a StandbyPurge sub folder, for the setup to copy from. -->
    <OutDir>$(MSBuildThisFileDirectory)..\NitroLite\bin\$(Configuration)\net10.0-windows\StandbyPurge\</OutDir>
  </PropertyGroup>

</Project>
