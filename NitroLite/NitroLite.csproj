<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationTitle>NitroLite - Acer Nitro Suite</ApplicationTitle>
    <Version>1.2.5-f</Version>
    <Authors>NitroLite Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (Window Icon="app.ico" resolves it as a resource), so the single-file package needs no loose file.
         The tray icon uses the exe's own icon (ApplicationIcon) when app.ico is not on disk. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything platform-independent: the hardware contract, the thermal and school-mode rules, the model table
         and the language catalogues. It targets plain net10.0 so a Linux front end can load the same assembly. -->
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />

    <!-- The Windows hardware and system services. They live in their own assembly so the Avalonia front end can use
         them on Windows without referencing this WPF project, which is what makes one UI serve both platforms. -->
    <ProjectReference Include="..\NitroLite.Windows\NitroLite.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The theme cards' previews: one screenshot of the app per palette, captured from the English UI by
         scripts/theme-previews.ps1. Embedded for the same reason as the catalogues, and because a card that
         reads a loose file would show an empty frame in the single-file package. -->
    <Resource Include="Assets\themes\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NitroLite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
