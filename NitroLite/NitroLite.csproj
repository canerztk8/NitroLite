<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationTitle>NitroLite - Acer Nitro Suite</ApplicationTitle>
    <Version>1.2.5</Version>
    <Authors>NitroLite Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (Window Icon="app.ico" resolves it as a resource), so the single-file package needs no loose file.
         The tray icon uses the exe's own icon (ApplicationIcon) when app.ico is not on disk. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- One catalogue per language, embedded so the single-file package needs no loose files. Loc.LoadCatalog
         finds them by the ".Lang.<code>.json" suffix. Turkish has no file: the source text is the key. -->
    <EmbeddedResource Include="Lang\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model table: sensor layouts, fan plausibility ceilings and known-broken WMI methods per Acer model.
         Embedded and read-only; a user override lives in the data folder as profiles.user.json and is validated
         as strictly as this one. ProfileCatalog finds it by the ".profiles.json" suffix. -->
    <EmbeddedResource Include="Core\Hardware\Profiles\profiles.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The theme cards' previews: one screenshot of the app per palette, captured from the English UI by
         scripts/theme-previews.ps1. Embedded for the same reason as the catalogues, and because a card that
         reads a loose file would show an empty frame in the single-file package. -->
    <Resource Include="Assets\themes\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NitroLite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
