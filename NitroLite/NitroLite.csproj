<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationTitle>NitroLite - Acer Nitro Suite</ApplicationTitle>
    <Version>1.2.0</Version>
    <Authors>NitroLite Team</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (Window Icon="app.ico" resolves it as a resource), so the single-file package needs no loose file.
         The tray icon uses the exe's own icon (ApplicationIcon) when app.ico is not on disk. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- One catalogue per language, embedded so the single-file package needs no loose files. Loc.LoadCatalog
         finds them by the ".Lang.<code>.json" suffix. Turkish has no file: the source text is the key. -->
    <EmbeddedResource Include="Lang\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build order only: the helper builds itself into bin\...\StandbyPurge for the one-time setup to copy. -->
    <!-- Publish settings (runtime, self-contained, single file) must not reach the helper: the release script
         builds it separately as a Native AOT exe (scripts/publish-release.ps1). -->
    <ProjectReference Include="..\NitroLite.StandbyPurge\NitroLite.StandbyPurge.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;RuntimeFrameworkVersion;PublishDir;DebugType" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NitroLite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
