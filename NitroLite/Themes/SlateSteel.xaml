<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cold anthracite. A blue-grey ground with ice blue as the single accent. The danger red is
         kept apart from it: a temperature warning and "this is the active choice" must never carry
         the same colour.
         Every brush is solid, exactly as in Themes/Light.xaml and Themes/Dark.xaml: no
         gradients, no effects, no transparency layers. The key set is identical to
         Themes/Dark.xaml, which ThemeDictionaryTests enforces. -->

    <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBg" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBgHover" Color="#263349" />
    <SolidColorBrush x:Key="BorderDark" Color="#334155" />
    <SolidColorBrush x:Key="BorderStrong" Color="#475569" />
    <SolidColorBrush x:Key="PanelBg" Color="#131C31" />
    <SolidColorBrush x:Key="RailBg" Color="#111A2E" />
    <SolidColorBrush x:Key="AccentRed" Color="#F43F5E" />
    <SolidColorBrush x:Key="AccentCyan" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Live" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentGreen" Color="#4ADE80" />
    <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMuted" Color="#7D8FA6" />
    <SolidColorBrush x:Key="OnAccent" Color="#0F172A" />
    <SolidColorBrush x:Key="WarnBg" Color="#2A1A22" />

    <!-- The world's own names, for the parts written fresh. -->
    <SolidColorBrush x:Key="Paper" Color="#0F172A" />
    <SolidColorBrush x:Key="PaperDeep" Color="#0B1120" />
    <SolidColorBrush x:Key="Ink" Color="#F1F5F9" />
    <SolidColorBrush x:Key="InkSoft" Color="#94A3B8" />
    <SolidColorBrush x:Key="InkFaint" Color="#7D8FA6" />
    <SolidColorBrush x:Key="Rule" Color="#334155" />
    <SolidColorBrush x:Key="RuleStrong" Color="#475569" />
    <SolidColorBrush x:Key="Vermilion" Color="#38BDF8" />
    <SolidColorBrush x:Key="Slate" Color="#7DD3FC" />
    <SolidColorBrush x:Key="Olive" Color="#4ADE80" />
    <SolidColorBrush x:Key="Link" Color="#7DD3FC" />

    <!-- The telemetry graph's wash: ink at 8 % over the paper. -->
    <SolidColorBrush x:Key="ChartFill" Color="#14F1F5F9" />

</ResourceDictionary>
