<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nord frost. Glacier turquoise over Nord's polar-night greys, with the palette's own red
         (#BF616A) kept for danger. The page is #242933 and Nord's #2E3440 becomes the card tone, so
         the card still separates from the page once the 1px rule is drawn.
         Every brush is solid, exactly as in Themes/Light.xaml and Themes/Dark.xaml: no
         gradients, no effects, no transparency layers. The key set is identical to
         Themes/Dark.xaml, which ThemeDictionaryTests enforces. -->

    <SolidColorBrush x:Key="BgDark" Color="#242933" />
    <SolidColorBrush x:Key="CardBg" Color="#2E3440" />
    <SolidColorBrush x:Key="CardBgHover" Color="#373E4C" />
    <SolidColorBrush x:Key="BorderDark" Color="#434C5E" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4C566A" />
    <SolidColorBrush x:Key="PanelBg" Color="#272C36" />
    <SolidColorBrush x:Key="RailBg" Color="#262B35" />
    <SolidColorBrush x:Key="AccentRed" Color="#BF616A" />
    <SolidColorBrush x:Key="AccentCyan" Color="#ECEFF4" />
    <SolidColorBrush x:Key="Live" Color="#88C0D0" />
    <SolidColorBrush x:Key="AccentGreen" Color="#A3BE8C" />
    <SolidColorBrush x:Key="AccentPurple" Color="#B48EAD" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#D8DEE9" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA5B8" />
    <SolidColorBrush x:Key="OnAccent" Color="#242933" />
    <SolidColorBrush x:Key="WarnBg" Color="#3A2A2E" />

    <!-- The world's own names, for the parts written fresh. -->
    <SolidColorBrush x:Key="Paper" Color="#242933" />
    <SolidColorBrush x:Key="PaperDeep" Color="#1E222A" />
    <SolidColorBrush x:Key="Ink" Color="#ECEFF4" />
    <SolidColorBrush x:Key="InkSoft" Color="#D8DEE9" />
    <SolidColorBrush x:Key="InkFaint" Color="#9AA5B8" />
    <SolidColorBrush x:Key="Rule" Color="#434C5E" />
    <SolidColorBrush x:Key="RuleStrong" Color="#4C566A" />
    <SolidColorBrush x:Key="Vermilion" Color="#88C0D0" />
    <SolidColorBrush x:Key="Slate" Color="#81A1C1" />
    <SolidColorBrush x:Key="Olive" Color="#A3BE8C" />
    <SolidColorBrush x:Key="Link" Color="#8FBCBB" />

    <!-- The telemetry graph's wash: ink at 8 % over the paper. -->
    <SolidColorBrush x:Key="ChartFill" Color="#14ECEFF4" />

</ResourceDictionary>
