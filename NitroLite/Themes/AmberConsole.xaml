<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Amber console. A warm coffee ground with gold as the single accent, so the readings read like
         phosphor on terminal paper. The danger colour is a red of the same warmth (#E5484D): a warning
         has to be distinguishable from the accent without leaving the palette.
         Every brush is solid, exactly as in Themes/Light.xaml and Themes/Dark.xaml: no
         gradients, no effects, no transparency layers. The key set is identical to
         Themes/Dark.xaml, which ThemeDictionaryTests enforces. -->

    <SolidColorBrush x:Key="BgDark" Color="#0E0C09" />
    <SolidColorBrush x:Key="CardBg" Color="#17140F" />
    <SolidColorBrush x:Key="CardBgHover" Color="#211D16" />
    <SolidColorBrush x:Key="BorderDark" Color="#362F23" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4D4332" />
    <SolidColorBrush x:Key="PanelBg" Color="#120F0B" />
    <SolidColorBrush x:Key="RailBg" Color="#100D0A" />
    <SolidColorBrush x:Key="AccentRed" Color="#E5484D" />
    <SolidColorBrush x:Key="AccentCyan" Color="#F3E8D2" />
    <SolidColorBrush x:Key="Live" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentGreen" Color="#A3B565" />
    <SolidColorBrush x:Key="AccentPurple" Color="#C4A484" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F3E8D2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B8A88A" />
    <SolidColorBrush x:Key="TextMuted" Color="#918268" />
    <SolidColorBrush x:Key="OnAccent" Color="#0E0C09" />
    <SolidColorBrush x:Key="WarnBg" Color="#2A1F12" />

    <!-- The world's own names, for the parts written fresh. -->
    <SolidColorBrush x:Key="Paper" Color="#0E0C09" />
    <SolidColorBrush x:Key="PaperDeep" Color="#090806" />
    <SolidColorBrush x:Key="Ink" Color="#F3E8D2" />
    <SolidColorBrush x:Key="InkSoft" Color="#B8A88A" />
    <SolidColorBrush x:Key="InkFaint" Color="#918268" />
    <SolidColorBrush x:Key="Rule" Color="#362F23" />
    <SolidColorBrush x:Key="RuleStrong" Color="#4D4332" />
    <SolidColorBrush x:Key="Vermilion" Color="#F59E0B" />
    <SolidColorBrush x:Key="Slate" Color="#A8B5C4" />
    <SolidColorBrush x:Key="Olive" Color="#A3B565" />
    <SolidColorBrush x:Key="Link" Color="#7FB3D5" />

    <!-- The telemetry graph's wash: ink at 8 % over the paper. -->
    <SolidColorBrush x:Key="ChartFill" Color="#14F3E8D2" />

</ResourceDictionary>
