<Window x:Class="NitroLite.OsdOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroLite OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False">

    <!-- No DropShadowEffect: on a layered (transparent) window every 1 s update would be re-rendered in software. -->
    <Border Background="#F20F1115" BorderBrush="#252B38" BorderThickness="1" CornerRadius="6" Padding="12,8">

        <StackPanel TextElement.FontFamily="Consolas, Cascadia Code, Courier New, monospace">
            <!-- CPU Row -->
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="CPU: " Foreground="#9BA5B7" FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="TxtOsdCpuTemp" Text="-- °C" Foreground="#0EA5E9" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdCpuPower" Text="-- W" Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdCpuFreq" Text="-- GHz" Foreground="#F1F4F9" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdCpuUsage" Text="-- %" Foreground="#9BA5B7" FontSize="11" />
            </StackPanel>

            <!-- GPU Row -->
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="GPU: " Foreground="#9BA5B7" FontSize="11" FontWeight="Bold" />
                <TextBlock x:Name="TxtOsdGpuTemp" Text="-- °C" Foreground="#EF4444" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdGpuPower" Text="-- W" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdGpuFreq" Text="-- MHz" Foreground="#F1F4F9" FontSize="11" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="11" />
                <TextBlock x:Name="TxtOsdVram" Text="VRAM: -- GB" Foreground="#0EA5E9" FontSize="11" FontWeight="Bold" />
            </StackPanel>

            <!-- RAM & Fan Row -->
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="RAM: " Foreground="#9BA5B7" FontSize="10" />
                <TextBlock x:Name="TxtOsdRam" Text="-- GB" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                <TextBlock Text=" | " Foreground="#3A4356" FontSize="10" />
                <TextBlock x:Name="TxtOsdFan" Text="FAN: -- RPM" Foreground="#9BA5B7" FontSize="10" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
