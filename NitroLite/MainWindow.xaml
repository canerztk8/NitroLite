                                            </StackPanel>

                                            <!-- Metric Selection Dropdown -->
                                            <ComboBox x:Name="CmbChartMetric" Width="240" SelectionChanged="CmbChartMetric_SelectionChanged" HorizontalAlignment="Right" VerticalAlignment="Center">
