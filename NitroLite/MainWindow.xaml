                                                <Button x:Name="BtnCleanRamCache" Grid.Column="1" Content="Bekleme Belleğini Boşalt" Click="BtnCleanRamCache_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" ToolTip="Windows bekleme listesini boşaltır (yönetici izni gerekir). Çalışan programların belleğini diske itmez." />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- REAL-TIME TELEMETRY HISTORY GRAPH CARD -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Telemetri Geçmiş Grafiği" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
