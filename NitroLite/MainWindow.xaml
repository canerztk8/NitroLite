<Window x:Class="NitroLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroLite" 
        Icon="app.ico"
        Height="730" Width="1060"
        MinHeight="730" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Paper}"
        Foreground="{DynamicResource Ink}"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <!-- Borderless look with native window behaviour: edge resizing, Aero Snap, double-click to maximize.
         No AllowsTransparency, so WPF renders on the GPU; Windows draws the shadow (and rounded corners on 11). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The palette lives in Themes/Light.xaml and Themes/Dark.xaml, merged into Application.Resources
             before this window is built, so every StaticResource below resolves to the chosen theme. The
             styles stay here: they are the same in both themes and only point at the brushes. -->

        <!-- Figures are recorded, labels are written: the margin scale and every readout are set in
             a tabular face, the prose stays in the platform's humanist sans. -->
        <FontFamily x:Key="FigureFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- Keyboard focus: a 1px vermilion rule drawn just outside the control. WPF shows a FocusVisualStyle only
             when the focus arrived from the keyboard, so a mouse user never sees it, and the ring never competes
             with the hover and selected states the templates already draw. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   Stroke="{StaticResource Vermilion}"
                                   StrokeThickness="1"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A printed label: small, uppercase, faint. Used for field names and captions. -->
        <Style x:Key="LabelCaps" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A recorded figure. -->
        <Style x:Key="Figure" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A section is a ruled band on the paper, never a card floating on it: one hairline above,
             generous space below. The 21 existing CardBorder usages inherit this language. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,14,0,0" />
        </Style>

        <!-- Flat button: no chrome, no bevel. Hover is a paper tone, never a colour. -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardBgHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PanelBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FLAT COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{StaticResource InkFaint}"
                          StrokeThickness="1.4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RuleStrong}" />
                    <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource Ink}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RuleStrong}" />
                    <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource Ink}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6,26,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Grid x:Name="dropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="260">
                                    <Border x:Name="dropDownBorder"
                                            Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource RuleStrong}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Margin="0,3,0,3">
                                        <ScrollViewer SnapsToDevicePixels="True" Margin="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2" Margin="2,1"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelBg}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <!-- The drop-down lives in a Popup, which has no adorner layer, so FocusVisualStyle
                                 would never draw here; the item marks keyboard focus on its own border instead.
                                 The 1px border is always reserved, so focusing an item never shifts its text. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Vermilion}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox: a small square that fills with the signal colour when set. -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="box" Width="14" Height="14" CornerRadius="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource RuleStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 0 3 L 2.5 5.5 L 7 0.5"
                                      Stroke="{StaticResource OnAccent}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button: same square language as the checkbox, so the two read as one family. -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="box" Width="14" Height="14" CornerRadius="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource RuleStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="dot" Width="6" Height="6" CornerRadius="0"
                                        Background="{StaticResource OnAccent}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: a 2px ruled track, the filled part in vermilion, a square ink thumb. -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="18" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Background="Transparent" Margin="4,0">
                            <Border Height="3" Background="{StaticResource Rule}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="3" Background="{StaticResource Ink}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{StaticResource Ink}" CornerRadius="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar: a 3px ruled track with a solid fill. The fill follows Foreground, which the
             code-behind swaps for severity, so the bar never needs a second template. -->
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar: a thin ruled thumb, no arrows, no track chrome. -->
        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{StaticResource RuleStrong}" CornerRadius="2" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <!-- Navigation: the current section is the sheet lifted off the rail, marked by a small
             vermilion time mark in the margin. No fill, no stripe. -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <!-- The rail is 200 px wide and a translated label can be longer than the Turkish one
                 ("Мониторинг оборудования"), so the label wraps instead of being clipped. -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="mark" Grid.Column="0" Width="5" Height="5"
                                               Fill="{StaticResource Ink}" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Paper}" />
                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A mode is a ruled row on the recording paper, not a card. The active row is marked by a
             3x18 vermilion time mark in the left margin (BorderBrush drives the mark), full ink type
             and a vermilion chip; the other rows drop to soft ink. State by de-emphasis, never by fill. -->
        <Style x:Key="ModeRowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource Rule}" />
                            <Border x:Name="hover" Grid.Row="1" Background="{StaticResource CardBgHover}" Opacity="0" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="mark" Grid.Column="0" Width="3" Height="18"
                                           Fill="{TemplateBinding BorderBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" Margin="0,12,14,12" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (fan mode, CPU boost). The selected option is the solid vermilion mark,
             the others stay flat paper; the code-behind swaps Background/Foreground. -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RuleStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The recording sheet: one paper ground, one hairline frame. -->
    <Border x:Name="RootBorder" Background="{StaticResource BgDark}" BorderBrush="{StaticResource Rule}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="44" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <!-- Dragging, snapping and double-click maximize are handled by WindowChrome (CaptionHeight="46"). -->
            <Border Grid.Row="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NitroLite" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtAppVersion" Text="v1.2" Foreground="{StaticResource InkFaint}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <!-- Appears only when GitHub reports a newer release; the update runs from here. -->
                        <Button x:Name="BtnUpdateNow" Click="BtnUpdateNow_Click" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource PanelBg}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="8,3" Cursor="Hand" FontSize="10" FontWeight="SemiBold" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="TxtUpdateNow" Text="Güncelle" />
                        </Button>
                    </StackPanel>

                    <!-- Right Controls: live figures + window buttons. No boxes: the figures sit on the
                         paper like a printed header. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="BadgeBattery" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtBatteryIcon" Text="PİL" Foreground="{StaticResource InkFaint}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBatteryHeader" Text="--%" Foreground="{StaticResource Ink}" FontFamily="{StaticResource FigureFont}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BadgeMode" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MOD" Foreground="{StaticResource InkFaint}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtModeHeader" Text="DENGELİ" Foreground="{StaticResource Live}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült">
                            <TextBlock Text="–" Foreground="{StaticResource InkSoft}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Büyüt">
                            <TextBlock x:Name="TxtMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource InkSoft}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Close Button (Minimizes to tray) -->
                        <Button Click="BtnClose_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Tepsiye gizle">
                            <TextBlock Text="✕" Foreground="{StaticResource InkSoft}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN BODY (Sidebar Nav + Tab Content) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR NAVIGATION -->
                <Border Grid.Column="0" Background="{StaticResource RailBg}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0" Padding="10,16,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="GEZİNTİ" Style="{StaticResource LabelCaps}" Margin="10,0,0,8" />
                            <RadioButton x:Name="NavModes" Style="{StaticResource NavButton}" Content="Çalışma Modları" IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavMonitoring" Style="{StaticResource NavButton}" Content="Donanım İzleme &amp; OSD" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavRgb" Style="{StaticResource NavButton}" Content="Klavye Aydınlatması" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavBattery" Style="{StaticResource NavButton}" Content="Pil &amp; Termal Sağlık" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDebloat" Style="{StaticResource NavButton}" Content="Sistem Servisleri &amp; Araçlar" Checked="Nav_Checked" />
                        </StackPanel>

                        <!-- The rail's readout: a ruled column of live figures, not a card. -->
                        <StackPanel Grid.Row="2">
                            <!-- The signature sits above the readout, centred on the rail's own width. -->
                            <TextBlock Margin="10,0,10,10" FontSize="10" TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="♥" Foreground="{StaticResource Vermilion}" />
                                <Run Text=" Made with love by · " Foreground="{StaticResource InkFaint}" />
                                <Hyperlink Click="LinkAuthor_Click" Cursor="Hand">
                                    <!-- A Hyperlink is a ContentElement, so FocusVisualStyle does not apply to it;
                                         it underlines itself when the keyboard reaches it instead. -->
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                            <Setter Property="Foreground" Value="{StaticResource Link}" />
                                            <Setter Property="TextDecorations" Value="None" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    <Run Text="Caner" />
                                </Hyperlink>
                            </TextBlock>
                            <Border Background="{StaticResource Rule}" Height="1" Margin="10,0,10,10" />
                            <TextBlock Text="SİSTEM" Style="{StaticResource LabelCaps}" Margin="10,0,0,6" />
                            <Grid Margin="10,3">
                                <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" />
                                <TextBlock x:Name="TxtSideCpuTemp" Text="-- °C" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="10,3">
                                <TextBlock Text="GPU" Style="{StaticResource LabelCaps}" />
                                <TextBlock x:Name="TxtSideGpuTemp" Text="-- °C" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="10,3">
                                <TextBlock Text="FAN" Style="{StaticResource LabelCaps}" />
                                <TextBlock x:Name="TxtSideCpuFan" Text="-- RPM" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="10,3">
                                <TextBlock Text="BOOST" Style="{StaticResource LabelCaps}" />
                                <TextBlock x:Name="TxtSideCpuBoost" Text="Agresif" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid x:Name="RowSideMouseProfile" Margin="10,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FARE" Style="{StaticResource LabelCaps}" />
                                <!-- Two columns + trimming: a long failure text used to overlap the label. -->
                                <TextBlock Grid.Column="1" x:Name="TxtSideMouseProfile" Text="Config 1" Foreground="{StaticResource Olive}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB CONTENT CONTAINER -->
                <Grid Grid.Column="1" Margin="26,20,26,0">
                    
                    <!-- TAB 1: MODES & FANS -->
                    <Grid x:Name="TabModes" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Çalışma Modları" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Donanım güç limitleri, fan profilleri ve oyuna özel yapılandırmalar." Foreground="{StaticResource InkSoft}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <!-- THE RECORDING: the last 60 seconds of CPU temperature as a continuous
                                     ink trace, a vermilion "now" edge, and a tick wherever the mode
                                     changed. This is the surface's signature move. -->
                                <Grid Margin="0,20,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtTraceSpan" Text="KAYIT" Style="{StaticResource LabelCaps}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="ARALIK" Style="{StaticResource LabelCaps}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtTraceRange" Text="--" Style="{StaticResource Figure}" Foreground="{StaticResource InkFaint}" FontSize="10" Margin="0,0,16,0" />
                                            <TextBlock Text="ŞİMDİ" Style="{StaticResource LabelCaps}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtTraceValue" Text="-- °C" Style="{StaticResource Figure}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Height="72" Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <Canvas x:Name="CanvasModeTrace" ClipToBounds="True">
                                                <Polyline x:Name="TraceLine" Stroke="{StaticResource Ink}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                                <Canvas x:Name="TraceMarks" />
                                                <Line x:Name="TraceNow" Stroke="{StaticResource Vermilion}" StrokeThickness="1" StrokeDashArray="2 2" />
                                            </Canvas>
                                            <TextBlock x:Name="TxtTraceEmpty" Text="Kayıt bekleniyor" Style="{StaticResource LabelCaps}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Modes as ruled rows on the recording paper: the active row carries a
                                     3px vermilion time mark above it and full ink, the others drop back.
                                     Texts follow NitroSense's own mode descriptions. -->
                                <StackPanel Margin="0,18,0,0">
                                    <!-- QUIET -->
                                    <Button x:Name="BtnModeQuiet" Style="{StaticResource ModeRowButton}" Click="BtnMode_Click" Tag="Quiet">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Sessiz" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Olabildiğince sessiz; toplantı, ders, internet gibi hafif kullanım" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="IndQuiet" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="1" Padding="7,2" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock x:Name="TxtIndQuiet" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- BALANCED / DEFAULT -->
                                    <Button x:Name="BtnModeDefault" Style="{StaticResource ModeRowButton}" Click="BtnMode_Click" Tag="Default">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Dengeli" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Günlük kullanım için önerilen; ofis ve genel işler" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="IndDefault" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="1" Padding="7,2" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock x:Name="TxtIndDefault" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- PERFORMANCE / EXTREME -->
                                    <Button x:Name="BtnModeExtreme" Style="{StaticResource ModeRowButton}" Click="BtnMode_Click" Tag="Extreme">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Performans" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Oyun için; CPU ve GPU hız aşırtmalı, fan devri sınırlı" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="IndExtreme" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="1" Padding="7,2" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock x:Name="TxtIndExtreme" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- TURBO -->
                                    <Button x:Name="BtnModeTurbo" Style="{StaticResource ModeRowButton}" Click="BtnMode_Click" Tag="Turbo">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Turbo" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Sınırsız oyun; en yüksek hız aşırtma ve fan devri" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="IndTurbo" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="1" Padding="7,2" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock x:Name="TxtIndTurbo" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- ECO (reported by AASSvc as mode 6; NitroSense offers it on battery) -->
                                    <Button x:Name="BtnModeEco" Style="{StaticResource ModeRowButton}" Click="BtnMode_Click" Tag="Eco">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Eco" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="En düşük güç tüketimi; pilde daha uzun kullanım" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="IndEco" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="1" Padding="7,2" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock x:Name="TxtIndEco" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource Rule}" Margin="0,0,0,0" />
                                
                                <TextBlock x:Name="TxtModeLockNote" Visibility="Collapsed" Foreground="{StaticResource AccentRed}" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,0" />
                                <Border Height="10" />


                                <!-- ROW: FAN CONTROL & GLOBAL CPU BOOST -->
                                <!-- FAN: a ruled section. Readouts on the left, the choice on the right. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <TextBlock Text="FAN" Style="{StaticResource LabelCaps}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnFanAuto" Style="{StaticResource SegButton}" Content="Otomatik" Click="BtnFanAuto_Click" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" />
                                                <Button x:Name="BtnFanMax" Style="{StaticResource SegButton}" Content="Maksimum" Click="BtnFanMax_Click" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" />
                                                <Button x:Name="BtnFanCustom" Style="{StaticResource SegButton}" Content="Özel" Click="BtnFanCustom_Click" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" ToolTip="CPU ve GPU fanını sabit bir hızda (%30–100) çalıştırır." />
                                                <Button x:Name="BtnFanCurve" Style="{StaticResource SegButton}" Content="Eğri" Click="BtnFanCurve_Click" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" FontSize="11" ToolTip="Fan hızını CPU sıcaklığına göre kendisi ayarlar." />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the section is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,7">
                                                    <TextBlock x:Name="TxtCpuFanRpm" Text="3089 RPM" Style="{StaticResource Figure}" FontSize="20" FontWeight="SemiBold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarCpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Value="50" Maximum="6000" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="GPU" Style="{StaticResource LabelCaps}" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the section is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,7">
                                                    <TextBlock x:Name="TxtGpuFanRpm" Text="3075 RPM" Style="{StaticResource Figure}" FontSize="20" FontWeight="SemiBold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarGpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Value="50" Maximum="6000" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- CUSTOM FAN SPEEDS (shown in "Özel" mode) -->
                                        <Grid x:Name="PnlCustomFan" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" Margin="0,0,10,0" />
                                            <Slider x:Name="SliderFanCpu" Grid.Column="1" Minimum="30" Maximum="100" Value="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderCustomFan_ValueChanged" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtFanCpuPercent" Grid.Column="2" Text="%50" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="GPU" Style="{StaticResource LabelCaps}" Margin="0,8,10,0" />
                                            <Slider x:Name="SliderFanGpu" Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" Value="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderCustomFan_ValueChanged" VerticalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock x:Name="TxtFanGpuPercent" Grid.Row="1" Grid.Column="2" Text="%50" Style="{StaticResource Figure}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Sabit hız: fan yüke göre hızlanmaz. Ağır yükte sıcaklığı izleyin; ısınırsa Otomatik'e dönün." Foreground="{StaticResource InkFaint}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </Grid>

                                        <!-- SOFTWARE FAN CURVE (shown in "Eğri" mode) -->
                                        <StackPanel x:Name="PnlFanCurve" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Border Height="1" Background="{StaticResource Rule}" Margin="0,0,0,12" />
                                            <Grid>
                                                <TextBlock Text="FAN EĞRİSİ" Style="{StaticResource LabelCaps}" />
                                                <TextBlock x:Name="TxtFanCurveStatus" Text="--" HorizontalAlignment="Right" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" />
                                            </Grid>
                                            <!-- The trace: temperature across, fan speed up. Drawn in code so it always matches the sliders. -->
                                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" Margin="0,8,0,0" Background="{StaticResource PaperDeep}">
                                                <Grid Height="92">
                                                    <Canvas x:Name="CanvasFanCurveGrid" ClipToBounds="True" />
                                                    <Canvas x:Name="CanvasFanCurve" ClipToBounds="True" SizeChanged="CanvasFanCurve_SizeChanged">
                                                        <Polyline x:Name="FanCurveLine" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        <Rectangle x:Name="FanCurveMarker" Width="5" Height="5" Fill="{StaticResource Vermilion}" Visibility="Collapsed" />
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="40°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve0" Grid.Column="1" Minimum="30" Maximum="100" Value="30" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve0" Grid.Column="2" Text="%30" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="50°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve1" Grid.Column="1" Minimum="30" Maximum="100" Value="32" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve1" Grid.Column="2" Text="%32" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="60°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve2" Grid.Column="1" Minimum="30" Maximum="100" Value="36" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve2" Grid.Column="2" Text="%36" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="70°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve3" Grid.Column="1" Minimum="30" Maximum="100" Value="42" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve3" Grid.Column="2" Text="%42" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid Grid.Row="2" Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="80°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve4" Grid.Column="1" Minimum="30" Maximum="100" Value="62" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve4" Grid.Column="2" Text="%62" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="2" Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="90°" Style="{StaticResource Figure}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve5" Grid.Column="1" Minimum="30" Maximum="100" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve5" Grid.Column="2" Text="%100" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Text="Eğri CPU sıcaklığını izler: sıcaklık yükselince fan hemen hızlanır, düşünce histerezis kadar bekleyip yavaşlar. Oyun oturumu sırasında oyun profilinin fan ayarı geçerlidir." Foreground="{StaticResource InkFaint}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CPU BOOST: the same ruled section, the choice on the right. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="CPU BOOST" Style="{StaticResource LabelCaps}" />
                                                <TextBlock x:Name="TxtBoostStatusBadge" Text="(--)" Style="{StaticResource LabelCaps}" Foreground="{StaticResource InkSoft}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnBoostAggressive" Style="{StaticResource SegButton}" Content="Agresif" Click="BtnBoost_Click" Tag="Aggressive" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" ToolTip="Windows boost değeri 2: işlemci yükte mümkün olan en yüksek frekansa çıkar" />
                                                <Button x:Name="BtnBoostEfficient" Style="{StaticResource SegButton}" Content="Verimli" Click="BtnBoost_Click" Tag="Efficient" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" ToolTip="Windows boost değeri 4 (Efficient Aggressive): boost açık, verimlilik öncelikli; frekans sabit bir değerle sınırlanmaz" />
                                                <Button x:Name="BtnBoostDisabled" Style="{StaticResource SegButton}" Content="Devre Dışı" Click="BtnBoost_Click" Tag="Disabled" Background="Transparent" Foreground="{StaticResource InkSoft}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,5" FontSize="11" ToolTip="Windows boost değeri 0: işlemci taban frekansının üzerine çıkmaz (7840HS için yaklaşık 3.8 GHz)" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Windows güç planı işlemci saat frekansı davranışı." Foreground="{StaticResource InkFaint}" FontSize="11" Margin="0,8,0,0" />
                                    </Grid>
                                </Border>

                                <!-- GPU OPERATING MODE / MUX SWITCH CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GPU Çalışma Modu (MUX Switch)" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                <Border x:Name="BadgeGpuMode" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                                                    <TextBlock x:Name="TxtGpuModeBadge" Text="Yükleniyor..." Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Ekran kartı bağlantı modu. Harici GPU doğrudan ekrana bağlanarak gecikmeyi düşürür ve maksimum FPS sağlar." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtGpuModeNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Items are filled only from the modes AASSvc reports as supported (SUPPORT_GPU_MODE_CAPABILITY). -->
                                            <ComboBox x:Name="CmbGpuMode" MinWidth="230" MaxWidth="340" Margin="0,0,8,0" IsEnabled="False" />
                                            <Button x:Name="BtnApplyGpuMode" IsEnabled="False" Content="Modu Uygula" Click="BtnApplyGpuMode_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçilen GPU modunu uygular." />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ENHANCED PER-GAME PROFILE & AUTO DETECTION -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Header & Active Game Live Badge -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Oyun Profili Yönetimi" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                    <Border x:Name="BadgeGameStatus" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                                                        <TextBlock x:Name="TxtGameStatus" Text="Durum: Beklemede (Aktif oyun yok)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Yürütülebilir dosya algılandığında ilgili mod ve fan yapılandırması otomatik uygulanır." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Auto Mode Global Switch -->
                                            <CheckBox x:Name="ChkAutoGameMode" Content="Otomatik oyun algılamayı etkinleştir" IsChecked="True" Checked="ChkAutoGameMode_Changed" Unchecked="ChkAutoGameMode_Changed" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Desktop / Default Mouse Profile Card -->
                                        <Border x:Name="CardDefaultMouseProfile" Visibility="Collapsed" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Masaüstü &amp; Varsayılan Fare Profili:" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
                                                        <Border x:Name="BadgeDefaultMouseProfile" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtDefaultMouseProfileStatus" Text="Config 1 (Aktif)" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Oyunlar kapandığında veya masaüstü kullanımında farenin otomatik döneceği varsayılan donanım profili." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="CmbDefaultAtkMouseProfile" MinWidth="180" MaxWidth="320" Margin="0,0,8,0" SelectionChanged="CmbDefaultAtkMouseProfile_SelectionChanged">
                                                        <ComboBoxItem Content="Config 1 (Önerilen)" Tag="1" />
                                                        <ComboBoxItem Content="Config 2" Tag="2" />
                                                        <ComboBoxItem Content="Config 3" Tag="3" />
                                                        <ComboBoxItem Content="Config 4" Tag="4" />
                                                        <ComboBoxItem Content="Son Kullanılanı Koru" Tag="0" />
                                                    </ComboBox>
                                                    <Button x:Name="BtnApplyDefaultMouseProfile" Content="Uygula" Click="BtnApplyDefaultMouseProfile_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili varsayılan profili fare donanımına anında uygular ve kaydeder." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Game Selection, Auto Scan, Add Custom Game, Delete -->
                                        <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="320" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Select Game Dropdown -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Yapılandırılacak Oyun:" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CmbConfiguredGames" SelectionChanged="CmbConfiguredGames_SelectionChanged" />
                                                </StackPanel>

                                                <!-- Action Buttons: Scan, Add, Delete -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Button x:Name="BtnScanGames" Content="Yüklü Oyunları Tara" Click="BtnScanGames_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Steam ve Epic Games kütüphanelerindeki oyunları listeye ekler." />
                                                    <Button x:Name="BtnAddCustomGame" Content="Oyun Ekle (.exe)" Click="BtnAddCustomGame_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Çalıştırılabilir dosya seçerek özel profil tanımlar." />
                                                    <Button x:Name="BtnDeleteGame" Content="Profili Sil" Click="BtnDeleteGame_Click" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili oyun profilini kayıtlı yapılandırmadan siler." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: Per-Game Detailed Configuration Grid -->
                                        <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Seçili Oyun Yapılandırması:" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock x:Name="TxtSelectedGameNameBadge" Text=" [Counter-Strike 2]" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtSelectedGameExePath" Text="cs2.exe" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                </Grid>

                                                <UniformGrid x:Name="GridGameSettingsRow" Columns="3" Margin="0,0,0,12">
                                                    <!-- Target Operating Mode -->
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Çalışma Modu:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetMode">
                                                            <ComboBoxItem Content="Turbo (Yüksek Güç Sınırı)" IsSelected="True" Tag="Turbo" />
                                                            <ComboBoxItem Content="Performans" Tag="Extreme" />
                                                            <ComboBoxItem Content="Dengeli (Varsayılan)" Tag="Default" />
                                                            <ComboBoxItem Content="Sessiz (Düşük Güç)" Tag="Quiet" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target CPU Boost Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="CPU Boost Davranışı:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetCpuBoost">
                                                            <ComboBoxItem Content="Devre Dışı (taban frekans)" IsSelected="True" Tag="Disabled" />
                                                            <ComboBoxItem Content="Verimli" Tag="Efficient" />
                                                            <ComboBoxItem Content="Agresif" Tag="Aggressive" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target Fan Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="Fan Profili:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetFan">
                                                            <ComboBoxItem Content="Otomatik Fan Eğrisi" IsSelected="True" Tag="Auto" />
                                                            <ComboBoxItem Content="Maksimum Devir (Sabit)" Tag="Max" />
                                                            <ComboBoxItem Content="Özel Hız (fan kartındaki ayar)" Tag="Custom" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- ATK Mouse Profile -->
                                                    <StackPanel x:Name="PnlGameAtkMouseProfile" Visibility="Collapsed" Margin="6,0,0,0">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="ATK Fare Profili:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Button x:Name="BtnTestMouseProfile" Content="Dene" Click="BtnTestMouseProfile_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="Seçili fare profilini donanım üzerinde anında test eder." />
                                                        </Grid>
                                                        <ComboBox x:Name="CmbGameAtkMouseProfile">
                                                            <ComboBoxItem Content="Değiştirme (Pasif)" IsSelected="True" Tag="0" />
                                                            <ComboBoxItem Content="Config 1 (Profil 1)" Tag="1" />
                                                            <ComboBoxItem Content="Config 2 (Profil 2)" Tag="2" />
                                                            <ComboBoxItem Content="Config 3 (Profil 3)" Tag="3" />
                                                            <ComboBoxItem Content="Config 4 (Profil 4)" Tag="4" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <!-- Per-game fan curve: this profile can run its own shape instead of a fixed speed -->
                                                <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <CheckBox x:Name="ChkGameFanCurve" Content="Bu oyun için fan eğrisi kullan" Checked="ChkGameFanCurve_Changed" Unchecked="ChkGameFanCurve_Changed" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="Sabit bir fan hızı yerine sıcaklığa göre değişen bir eğri uygular. Kapalıyken yukarıdaki fan profili geçerlidir." />
                                                        <StackPanel x:Name="PnlGameFanCurve" Visibility="Collapsed" Margin="0,8,0,0">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="OYUN FAN EĞRİSİ" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                                                <Button x:Name="BtnGameCurveCopyDesktop" Content="Masaüstü eğrisini kopyala" Click="BtnGameCurveCopyDesktop_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="8,2" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="Fan kartındaki eğriyi bu oyunun profiline kopyalar." />
                                                            </Grid>
                                                            <UniformGrid Columns="3">
                                                                <Grid Margin="0,0,22,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="40°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve0" Grid.Column="1" Minimum="30" Maximum="100" Value="30" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve0" Grid.Column="2" Text="%30" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="50°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve1" Grid.Column="1" Minimum="30" Maximum="100" Value="32" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve1" Grid.Column="2" Text="%32" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="60°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve2" Grid.Column="1" Minimum="30" Maximum="100" Value="36" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve2" Grid.Column="2" Text="%36" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="70°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve3" Grid.Column="1" Minimum="30" Maximum="100" Value="42" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve3" Grid.Column="2" Text="%42" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="80°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve4" Grid.Column="1" Minimum="30" Maximum="100" Value="62" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve4" Grid.Column="2" Text="%62" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="90°" Style="{StaticResource Figure}" FontSize="10" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve5" Grid.Column="1" Minimum="30" Maximum="100" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve5" Grid.Column="2" Text="%100" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Save Profile Action Button & Description -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="ChkGameAutoApply" Grid.Column="0" Content="Otomatik uygula" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" ToolTip="Kapalıysa bu oyun başladığında profil uygulanmaz; yalnızca elle çalıştırılabilir." />
                                                    <TextBlock Grid.Column="1" Text="Oyun açılışında ilgili ayarlar otomatik uygulanır, kapanışta masaüstü profili geri yüklenir." Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="Wrap" />
                                                    <Button x:Name="BtnSaveGameProfile" Grid.Column="2" Content="Yapılandırmayı Kaydet" Click="BtnSaveGameProfile_Click" Background="{StaticResource AccentCyan}" Foreground="{StaticResource OnAccent}" FontWeight="Bold" Padding="14,8" HorizontalAlignment="Right" Cursor="Hand" FontSize="11" BorderThickness="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: LIVE MONITORING & OSD -->
                    <Grid x:Name="TabMonitoring" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Donanım Telemetrisi ve OSD Göstergesi" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="AASSvc ve NVML sensör arabirimlerinden gerçek zamanlı donanım telemetrisi." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- OSD Overlay Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleOsd" Content="Ekran Üstü Gösterge (OSD)" Click="BtnToggleOsd_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="Oyun esnasında donanım kullanım verilerini ekranda gösterir." />
                                        <Button x:Name="BtnCycleOsdCorner" Content="Konum Değiştir" Click="BtnCycleOsdCorner_Click" Margin="8,0,0,0" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="10,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="OSD katmanını ekran köşeleri arasında taşır." />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <!-- CPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <!-- The CPU name is a full marketing string ("AMD Ryzen 7 7840HS w/ Radeon 780M
                                                 Graphics") and the core count follows it. In a horizontal StackPanel
                                                 neither is constrained, so the pair ran past the card edge; the star
                                                 column wraps the name at a word boundary and keeps the count whole. -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="TxtMonCpuName" Text="İşlemci" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" x:Name="TxtCpuCoreCount" Text=" (16 Çekirdek)" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Top" />
                                            </Grid>
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuTemp" Height="4" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Paket Güç Tüketimi:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuPower" Text="-- W" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuPower" Height="4" Maximum="80" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="İşlemci Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuUsage" Text="-- %" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuUsage" Height="4" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Clock in GHz -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Saat Frekansı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuFreqGhz" Text="-- GHz" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuFreq" Height="4" Maximum="5100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtMonGpuName" Text="Ekran Kartı" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuTemp" Height="4" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- TGP Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="TGP Güç Tüketimi:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuPower" Text="-- W" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuPower" Height="4" Maximum="140" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="GPU Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuUsage" Text="-- %" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuUsage" Height="4" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- VRAM -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="VRAM Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonVram" Text="-- GB / 8.0 GB" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonVram" Height="4" Maximum="8192" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- RAM & SYSTEM TEMP CARD WITH RAM CACHE CLEANER -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Sistem Belleği (RAM)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" />
                                                <Grid Margin="0,6">
                                                    <TextBlock x:Name="TxtMonRamDetail" Text="-- GB / -- GB" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtMonRamPercent" Text="-- %" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar x:Name="BarMonRam" Height="5" Maximum="100" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" />
                                                <TextBlock x:Name="TxtMonRamInfo" Text="--" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Sistem Sıcaklığı" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtMonSysTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                <TextBlock Text="Acer servisinin SYS1 sensörü (konumu Acer tarafından belirtilmiyor)" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- RAM CACHE / STANDBY LIST CLEANER BAR -->
                                        <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Bekleme Belleğini Boşaltma" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtRamCleanStatus" Text=" (Hazır)" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtRamCleanNote" Text="Windows'un önbellekte tuttuğu (bekleme listesi) belleği boş belleğe çevirir; çalışan programların belleğine dokunmaz, bu yüzden kullanılan RAM çubuğu değişmez." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <Button x:Name="BtnGetMemoryCleaner" Content="WinMemoryCleaner'ı indir (ücretsiz, GPL-3.0)" Click="BtnGetMemoryCleaner_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Link}" FontSize="10" Cursor="Hand" ToolTip="NitroLite bu aracı paketlemez; resmi GitHub sürüm sayfasını açar." />
                                                </StackPanel>

                                                <Button x:Name="BtnCleanRamCache" Grid.Column="1" Content="Bekleme Belleğini Boşalt" Click="BtnCleanRamCache_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" ToolTip="WinMemoryCleaner ile Windows bekleme listesini boşaltır. Yönetici izni ister. Çalışan programların belleğini diske itmez." />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- REAL-TIME TELEMETRY HISTORY GRAPH CARD -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Telemetri Geçmiş Grafiği" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Text="Seçili metriğin son 60 saniyesi. Ölçüm olmayan anlar (ör. ekran kartı uykudayken) grafiğe ve değerlere dahil edilmez." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Metric Selection Dropdown -->
                                            <ComboBox Grid.Column="1" x:Name="CmbChartMetric" MinWidth="240" MaxWidth="340" SelectionChanged="CmbChartMetric_SelectionChanged" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBoxItem Content="CPU Sıcaklığı (°C)" Tag="CPU_TEMP" IsSelected="True" />
                                                <ComboBoxItem Content="GPU Sıcaklığı (°C)" Tag="GPU_TEMP" />
                                                <ComboBoxItem Content="CPU Güç Tüketimi (W, tahmini)" Tag="CPU_WATT" />
                                                <ComboBoxItem Content="GPU Güç Tüketimi (W)" Tag="GPU_WATT" />
                                                <ComboBoxItem Content="CPU Saat Frekansı (GHz)" Tag="CPU_GHZ" />
                                                <ComboBoxItem Content="CPU Kullanımı (%)" Tag="CPU_USAGE" />
                                                <ComboBoxItem Content="GPU Kullanımı (%)" Tag="GPU_USAGE" />
                                                <ComboBoxItem Content="RAM Kullanımı (%)" Tag="RAM_USAGE" />
                                                <ComboBoxItem Content="VRAM Kullanımı (GB)" Tag="VRAM_GB" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- The Graph Canvas. The pen is ink; only the leading dot is the live
                                             signal. The scale sits in its own gutter so the trace never runs
                                             through a label. -->
                                        <Border Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="2" Height="200" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,36,0,0" />
                                                    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,100,0,0" />
                                                    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,164,0,0" />

                                                    <Canvas x:Name="CanvasHistoryChart" ClipToBounds="True">
                                                        <Polygon x:Name="ChartArea" Fill="{StaticResource ChartFill}" StrokeThickness="0" />
                                                        <Polyline x:Name="ChartLine" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        <Ellipse x:Name="ChartDot" Width="7" Height="7" Fill="{StaticResource Live}" Stroke="{StaticResource PaperDeep}" StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Grid>

                                                <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                                                    <Grid>
                                                        <TextBlock x:Name="TxtChartGridTop" Text="--" Foreground="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,20,0,0" />
                                                        <TextBlock x:Name="TxtChartGridMid" Text="--" Foreground="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,84,0,0" />
                                                        <TextBlock x:Name="TxtChartGridBottom" Text="--" Foreground="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,148,0,0" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Live statistics as one readout strip, not four cards: a rule, then
                                             label/value pairs. The current reading is the only coloured one. -->
                                        <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                            <UniformGrid Columns="4">
                                                <StackPanel>
                                                    <TextBlock Text="Mevcut" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartCurrentVal" Text="-- °C" Style="{StaticResource Figure}" Foreground="{StaticResource Vermilion}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Minimum (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMinVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Maksimum (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMaxVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Ortalama (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartAvgVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: KEYBOARD RGB -->
                    <Grid x:Name="TabRgb" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Klavye RGB Aydınlatma Kontrolü" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Dört bölgeli RGB renk dizilimi, dinamik aydınlatma efektleri ve donanım profilleri." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnTurnOffLights" Content="Aydınlatmayı Kapat" Click="BtnTurnOffLights_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <!-- Shown only when the Acer service explicitly reports no controllable lighting. -->
                                <Border x:Name="BannerLightingUnsupported" Visibility="Collapsed" Background="{StaticResource WarnBg}" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                    <TextBlock x:Name="TxtLightingUnsupported" TextWrapping="Wrap" Foreground="{StaticResource AccentRed}" FontSize="11" />
                                </Border>

                                <!-- 4 Zones Visual Preview -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Dört Bölgeli Aydınlatma Düzeni (rengini değiştirmek için bölgeye tıklayın)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                                        <UniformGrid Columns="4">
                                            <StackPanel>
                                                <Border x:Name="PreviewZone1" Tag="0" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="{StaticResource AccentCyan}" Height="40" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" />
                                                <TextBlock Text="Bölge 1 (Sol)" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Border x:Name="PreviewZone2" Tag="1" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="{StaticResource AccentCyan}" Height="40" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" />
                                                <TextBlock Text="Bölge 2 (Orta Sol)" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Border x:Name="PreviewZone3" Tag="2" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="{StaticResource AccentCyan}" Height="40" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" />
                                                <TextBlock Text="Bölge 3 (Orta Sağ)" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <Border x:Name="PreviewZone4" Tag="3" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="{StaticResource AccentCyan}" Height="40" BorderBrush="{StaticResource RuleStrong}" BorderThickness="1" />
                                                <TextBlock Text="Bölge 4 (Sayısal)" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock x:Name="TxtZonePreviewNote" Text="" Visibility="Collapsed" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="3,8,3,0" />
                                    </StackPanel>
                                </Border>

                                <!-- MODULE 4: RGB PRESET MANAGER CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Aydınlatma Profilleri" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Ön tanımlı aydınlatma temalarını uygulayabilir veya özel konfigürasyon kaydedebilirsiniz." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="320" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Preset Dropdown. The list is left unselected when the keyboard is in a
                                                 state no preset describes, which used to read as an empty, broken
                                                 control; the hint is a sibling shown only while nothing is selected. -->
                                            <Grid Grid.Column="0">
                                                <ComboBox x:Name="CmbRgbPresets" SelectionChanged="CmbRgbPresets_SelectionChanged" VerticalAlignment="Center" />
                                                <TextBlock Text="Profil seçilmedi" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CmbRgbPresets}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Save Custom Preset input. The hint is a sibling, not a watermark, so it
                                                 can never end up inside a saved profile name. -->
                                            <Grid Grid.Column="1" Margin="10,0">
                                                <TextBox x:Name="TxtCustomPresetName" Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="10,7" FontSize="11" VerticalAlignment="Center" ToolTip="Yeni profil adı" FocusVisualStyle="{StaticResource FocusRing}" />
                                                <TextBlock Text="Yeni profil adı" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtCustomPresetName}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnSaveCustomPreset" Content="Profili Kaydet" Click="BtnSaveCustomPreset_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                                <Button x:Name="BtnDeleteCustomPreset" Content="Profili Sil" Click="BtnDeleteCustomPreset_Click" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Color Presets & Turn Off Controls -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Hızlı Renk Seçimi" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="BtnPresetColor_Click" Tag="#00E5FF" Background="#00E5FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Camgöbeği (Cyan)" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FF2A55" Background="#FF2A55" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kırmızı" />
                                        <Button Click="BtnPresetColor_Click" Tag="#00FFA3" Background="#00FFA3" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Yeşil" />
                                        <Button Click="BtnPresetColor_Click" Tag="#BD00FF" Background="#BD00FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Mor" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FFAA00" Background="#FFAA00" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Turuncu" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FFFFFF" Background="#FFFFFF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Beyaz" />
                                        <Button Click="BtnPresetColor_Click" Tag="#000000" Background="#000000" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kapalı" />
                                        <Button x:Name="BtnCustomColor" Content="Özel Renk…" Click="BtnCustomColor_Click" Height="36" Padding="12,0" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold" ToolTip="Herhangi bir renk seçin (tüm bölgeler)" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Controls: Effect, Brightness, Speed, Timeout -->
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Aydınlatma Efekti:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbRgbEffect" SelectionChanged="CmbRgbEffect_SelectionChanged" Margin="0,0,0,12" MaxWidth="360" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="STATIC (Sabit Renk)" IsSelected="True" />
                                                <ComboBoxItem Content="WAVE (Dalga)" />
                                                <ComboBoxItem Content="BREATHING (Nefes)" />
                                                <ComboBoxItem Content="NEON (Neon Geçiş)" />
                                                <ComboBoxItem Content="SHIFTING (Renk Kayması)" />
                                                <ComboBoxItem Content="ZOOM (Büyüme)" />
                                                <ComboBoxItem Content="METEOR (Kayan Işık)" />
                                                <ComboBoxItem Content="TWINKLING (Yıldız Parıltısı)" />
                                                <ComboBoxItem Content="OFF (Işık Kapalı)" />
                                            </ComboBox>
                                            <TextBlock x:Name="TxtRgbEffectNote" Text="" Visibility="Collapsed" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,-6,0,10" />

                                            <StackPanel x:Name="PnlRgbDirection" Visibility="Collapsed" Margin="0,0,0,10">
                                                <TextBlock Text="Efekt Yönü:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <ComboBox x:Name="CmbRgbDirection" SelectionChanged="CmbRgbDirection_SelectionChanged" MaxWidth="360" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <CheckBox x:Name="ChkBacklightTimeout" Content="30 saniye boşta kaldığında aydınlatmayı kapat" Checked="ChkBacklightTimeout_Changed" Unchecked="ChkBacklightTimeout_Changed" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Parlaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBrightnessVal" Text="5 / 9" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderBrightness" Minimum="0" Maximum="9" Value="5" ValueChanged="SliderBrightness_ValueChanged" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Efekt Hızı:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtSpeedVal" Text="3 / 9" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderSpeed" Minimum="1" Maximum="9" Value="3" ValueChanged="SliderSpeed_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 4: BATTERY HEALTH & SAFE DISCHARGE -->
                    <Grid x:Name="TabBattery" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Pil Şarj Sınırı ve Güvenli Deşarj" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Donanım pil sağlığını korumak için şarj sınırını %80 seviyesinde tutar ve kontrollü deşarj sağlar." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap" />

                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- BATTERY STATUS CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Şarj Durumu" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <TextBlock x:Name="TxtBatLevelBig" Text="--%" Foreground="{StaticResource AccentGreen}" FontSize="32" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBatStateDesc" Text="Adaptöre Bağlı" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>

                                            <ProgressBar x:Name="BarBatBig" Height="6" Maximum="100" Value="80" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" Margin="0,6,0,12" />

                                            <!-- Live Real-Time Discharge / Charge Rate Indicator -->
                                            <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,0,10">
                                                <!-- Two columns, not one cell with a right-aligned sibling: a translated
                                                     "remaining time" is longer than the Turkish one and used to run under
                                                     the card's edge. The star column keeps the figure clear of it. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Anlık Güç Akışı:" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtBatDischargeRate" Text="0.0 W (Adaptörde)" Foreground="{StaticResource AccentCyan}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" x:Name="TxtBatRemainingTime" Text="Kalan Süre: --" Foreground="{StaticResource TextSecondary}" FontSize="11" MaxWidth="200" Margin="12,0,0,0" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <CheckBox x:Name="ChkWatchdog" Content="%80 şarj koruma sınırını uygula" Checked="ChkWatchdog_Changed" Unchecked="ChkWatchdog_Changed" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,4" />
                                            <TextBlock Text="Şarj sınırı Acer Care Center üzerinden ayarlanır ve bilgisayar yeniden başlasa da korunur." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />

                                            <Separator Background="{StaticResource BorderDark}" Margin="0,8,0,8" />
                                            <TextBlock Text="Pilde Çalışma Güç Profili (DC Modu):" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbDcPowerMode" SelectionChanged="CmbDcPowerMode_SelectionChanged" Background="{StaticResource RailBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" FontSize="11" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Eco Modu (60Hz + Sessiz Fan + Güç Tasarrufu)" Tag="Eco" IsSelected="True" />
                                                <ComboBoxItem Content="Dengeli Mod (Mevcut Ayarları Koru)" Tag="Balanced" />
                                            </ComboBox>
                                            <CheckBox x:Name="ChkAutoRefreshRate" Checked="ChkAutoRefreshRate_Changed" Unchecked="ChkAutoRefreshRate_Changed" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,2">
                                                <!-- A CheckBox renders a string Content on one unbroken line; the German
                                                     sentence is twice the Turkish one and was clipped mid-word. -->
                                                <TextBlock Text="Pilde laptop ekranını 60 Hz'e al (adaptörde önceki hıza döner; harici monitörlere dokunmaz)" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- SAFE DISCHARGE CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Hedef Seviyeye Deşarj" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                                            <TextBlock Text="Pildeyken işlemciye hafif yük vererek pili %80'e indirir ve otomatik durur. Isı üretir; şarj sınırı açıksa pil zaten %80'i geçmediği için çoğu zaman gerekmez. Pil sağlığı için şart değildir." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                            <Border x:Name="DischargeStatusBox" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,0,12">
                                                <TextBlock x:Name="TxtDischargeStatus" Text="Durum: Boşta" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>

                                            <Button x:Name="BtnToggleDischarge" Content="Deşarj İşlemini Başlat" Click="BtnToggleDischarge_Click" Background="{StaticResource Ink}" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" FontSize="11" Padding="16,9" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- MODULE 3: BATTERY HEALTH & WEAR REPORT CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Batarya Kapasite ve Aşınma Durumu" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock x:Name="TxtBatIdentity" Text="Windows (WMI) üzerinden okunan kapasite ve gerilim." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <UniformGrid Columns="4">
                                            <!-- Health -->
                                            <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil Sağlığı" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatHealthPercent" Text="--" Foreground="{StaticResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatHealthNote" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Wear Level -->
                                            <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Aşınma Seviyesi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatWearPercent" Text="--" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatWearNote" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Capacity Comparison -->
                                            <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Tam Şarj Kapasitesi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatFullChargeCap" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,6,0,2" />
                                                    <TextBlock x:Name="TxtBatDesignCap" Text="Fabrika: --" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtBatCycleCount" Text="Döngü: --" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Voltage -->
                                            <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil Gerilimi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatVoltage" Text="--" Foreground="{StaticResource AccentPurple}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatChemistry" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- ALT BİLEŞEN TERMAL TELEMETRİ MATRİSİ (VRM, NVMe SSD'ler, PİL) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Bileşen Sıcaklık Matrisi" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Acer servisi, Windows ve disk sürücülerinden; okunamayan değerler hiç gösterilmez." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="16,0,0,0" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <UniformGrid Columns="4">
                                            <!-- Motherboard / VRM -->
                                            <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sistem (SYS1)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubMoboTemp" Text="" Visibility="Collapsed" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                    <TextBlock Text="Acer servisi sensörü" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                </StackPanel>
                                            </Border>

                                            <!-- NVMe SSD 1 (990 Pro) -->
                                            <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtSubSsd1Label" Text="Disk 1" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubSsd1Temp" Text="" Visibility="Collapsed" Foreground="{StaticResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                    <TextBlock x:Name="TxtSubSsd1Name" Text="--" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                </StackPanel>
                                            </Border>

                                            <!-- NVMe SSD 2 (PM9A1) -->
                                            <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtSubSsd2Label" Text="Disk 2" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubSsd2Temp" Text="" Visibility="Collapsed" Foreground="{StaticResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                    <TextBlock x:Name="TxtSubSsd2Name" Text="--" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Battery Pack: no temperature line. The pack reports no sensor, and an
                                                 empty degree placeholder would read as a broken reading. -->
                                            <Border Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubBatteryName" Text="Pil" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- STORAGE HEALTH & CAPACITY BARS (NVMe SSD SAĞLIK & DOLULUK) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Depolama Sürücüleri" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Windows'un bildirdiği disk durumu ve doluluk; aşınma ve sıcaklık sayaçları yönetici izni gerektirir." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtStorageBadge" Text="--" Foreground="{StaticResource InkSoft}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel x:Name="PanelStorageDrives">
                                            <!-- DRIVE 0: C: -->
                                            <Border x:Name="CardDrive0" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive0Letter" Text="[C:] " Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Name" Text="--" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Bus" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive0Temp" Text="" Visibility="Collapsed" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive0HealthBadge" Text="--" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive0Detail" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive0Free" Text="--" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive0" Height="5" Maximum="100" Value="25.7" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- DRIVE 1: D: -->
                                            <Border x:Name="CardDrive1" Background="Transparent" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive1Letter" Text="[D:] " Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Name" Text="--" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Bus" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive1Temp" Text="" Visibility="Collapsed" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive1HealthBadge" Text="--" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive1Detail" Text="--" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive1Free" Text="--" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive1" Height="5" Maximum="100" Value="18.1" Background="{StaticResource Rule}" Foreground="{StaticResource Ink}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Overcharge Warning Banner (Hidden by default) -->
                                <Border x:Name="BannerOvercharge" Visibility="Collapsed" Background="{StaticResource WarnBg}" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="[ ! ]" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Şarj Eşiği Aşıldı" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock x:Name="TxtOverchargeMsg" Text="Pil seviyesi %80 sınırının üzerindedir. Dilerseniz hedef seviyeye deşarj işlemini başlatabilirsiniz." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: DEBLOAT HUB & SETTINGS -->
                    <Grid x:Name="TabDebloat" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Sistem Servisleri ve Başlangıç Ayarları" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Gereksiz Acer arka plan servislerini kapatın, NitroSense'i yönetin ve NitroLite'ın başlangıç davranışını ayarlayın." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap" />

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Acer Arka Plan Servisleri" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="Servis bileşeni, sistem izleme, cihaz bilgisi, Experience Zone ve cihaz etkinleştirme servisleri. NitroLite'ın kullandığı Acer Agent, Care Center ve Lighting servislerine dokunulmaz. Ayarlar değiştirilmeden önce yedeklenir." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button x:Name="BtnApplyDebloat" Click="BtnApplyDebloat_Click" Content="Devre Dışı Bırak" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11" />
                                                <Button x:Name="BtnRestoreServices" Click="BtnRestoreServices_Click" Content="Servisleri Geri Yükle" Background="{StaticResource PanelBg}" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Service Status List -->
                                        <ItemsControl x:Name="ListServiceStatuses">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Name}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- NITROSENSE -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="NitroSense" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock x:Name="TxtNitroSenseRunningBadge" Text="--" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="NitroSense açıkken klavye ışığını ve mod tuşunu NitroSense yönetir, NitroLite karışmaz. Bu buton NitroSense'i ve yardımcı işlemlerini kapatır." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtNitroSenseLauncherState" Text="--" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="BtnKillNitroSense" Grid.Column="1" Content="NitroSense'i Kapat" Click="BtnKillNitroSense_Click" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,8" Cursor="Hand" VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                </Border>

                                <!-- SYSTEM & SERVICE REPAIR TOOLS (UNIFIED ENGINE) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Sistem ve Donanım Onarım Araçları" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Acer servis uyuşmazlıkları, klavye aydınlatma sorunları, MUX switch ve sistem arka plan optimizasyonlarını harici betiklere veya ayrı exe'lere gerek kalmadan doğrudan uygulayın." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Tool 1: Fix Keyboard Lighting -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Klavye RGB Servisini Onar" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="AcerLightingService kaydını sürücü deposuyla eşitler, klavye RGB servisini yeniden başlatır." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="BtnFixLighting" Grid.Column="1" Content="Servisi Onar" Click="BtnFixLighting_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 2: Fix Acer Central / Agent Services -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Acer &amp; NitroSense Servislerini Onar" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="AASSvc ve Acer Central servislerini en güncel sürücü paketine bağlar, arka plan çakışmalarını giderir." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="BtnFixAcerServices" Grid.Column="1" Content="Servisleri Onar" Click="BtnFixAcerServices_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 3: Restore MUX Switch Registry -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="MUX Switch Kaydını Onar" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="discrete_gpu_support kayıt defteri anahtarını doğrular, gereksiz eski oturum açılış görevlerini kaldırır." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="BtnRestoreMux" Grid.Column="1" Content="Kaydı Onar" Click="BtnRestoreMux_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 4: Optimize PC & Background Debloat -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Windows &amp; Sistem Optimizasyonu" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Gereksiz telemetri görevlerini kapatır, HAGS (GPU donanım zamanlama) açar, NVMe TRIM ve arka plan temizliği yapar. Değiştirilen her ayar yedeklenir; HAGS yeniden başlatmadan sonra etkin olur." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="BtnRestoreOptimize" Grid.Column="1" Content="Geri Al" Click="BtnRestoreOptimize_Click" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Optimizasyonun değiştirdiği servis, HAGS ve görev ayarlarını yedekten geri yükler." />
                                            <Button x:Name="BtnOptimizePc" Grid.Column="2" Content="Optimize Et" Click="BtnOptimizePc_Click" Background="{StaticResource PanelBg}" Foreground="{StaticResource AccentGreen}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock x:Name="TxtRepairToolsStatus" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- APP STARTUP SETTINGS -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,48,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <TextBlock Text="Windows açılışında otomatik çalıştır" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Oturum açıldığında NitroLite başlatılır (yönetici izni gerekmez)." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoStart" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <Grid>
                                            <StackPanel Margin="0,0,48,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <TextBlock Text="Windows açılışında tepside başlat" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Otomatik başlatmada pencere gösterilmez, NitroLite sistem tepsisinde çalışır. Elle açtığınızda pencere her zaman görünür." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkStartMinimized" Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,12" />

                                        <Grid>
                                            <StackPanel Margin="0,0,16,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <TextBlock Text="ATK Fare Entegrasyonu (ATK A9 vb.)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="ATK fare donanım protokolünü, profil geçişlerini ve oyuna özel fare profili atamalarını etkinleştirir." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAtkMouseIntegration" Checked="ChkAtkMouseIntegration_Changed" Unchecked="ChkAtkMouseIntegration_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NITROLITE SETTINGS: language, theme, update checks, feedback -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="NitroLite Ayarları" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Arayüz dili, tema, güncelleme denetimi ve geri bildirim." Style="{StaticResource BodyText}" Margin="0,2,0,14" />

                                        <!-- Language -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Arayüz dili" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Değiştirdiğinizde NitroLite yeni dille yeniden başlar. Oyun sırasında bir sonraki açılışa bırakılır." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Theme -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Tema" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Sistem varsayılanı Windows'un açık/koyu ayarını izler. Tema değiştiğinde NitroLite yeniden başlar." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="CmbTheme_SelectionChanged" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Automatic update check -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Güncellemeleri otomatik denetle" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Açılıştan 30 saniye sonra ve 6 saatte bir GitHub'a bakar. İnternet yoksa sessizce geçer." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoUpdateCheck" Checked="ChkAutoUpdateCheck_Changed" Unchecked="ChkAutoUpdateCheck_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Version and a manual check -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Sürüm" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock x:Name="TxtSettingsVersion" Text="v1.2" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BtnCheckUpdates" Content="Şimdi denetle" Click="BtnCheckUpdates_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Feedback: a prefilled GitHub issue, no telemetry -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Hata bildir" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="GitHub'da bir hata kaydı açar; sürüm, Windows sürümü ve laptop modeli önceden doldurulur. Kullanıcı adınız veya dosya yolunuz eklenmez." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="BtnOpenLogs" Content="Günlük klasörünü aç" Click="BtnOpenLogs_Click" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" Margin="0,0,8,0" />
                                                <Button x:Name="BtnReportBug" Content="Hata bildir" Click="BtnReportBug_Click" Background="{StaticResource PanelBg}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,12,0,12" />

                                        <!-- Diagnostics: the file a maintainer asks for when a model-specific bug is reported -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Donanım raporu" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Model, BIOS, Acer servisleri ve WMI durumunu bir dosyaya yazar. Hata bildirirken bu dosyayı ekleyin. Seri numarası, kullanıcı adı ve dosya yolu içermez." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="BtnHardwareReport" Grid.Column="1" Content="Raporu dışa aktar" Click="BtnHardwareReport_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- MINIMALIST NON-BLOCKING TOAST NOTIFICATION BANNER -->
            <Border x:Name="ToastBanner" Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="4" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtToastIcon" Text="●" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtToastMessage" Text="İşlem tamamlandı." Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
