<Window x:Class="NitroLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroLite" 
        Icon="app.ico"
        Height="730" Width="1060"
        MinHeight="730" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0F1115"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <!-- Borderless look with native window behaviour: edge resizing, Aero Snap, double-click to maximize.
         No AllowsTransparency, so WPF renders on the GPU; Windows draws the shadow (and rounded corners on 11). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Design System: Solid High-Contrast Dark Surfaces & Semantic Accents -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1115" />
        <SolidColorBrush x:Key="CardBg" Color="#171B24" />
        <SolidColorBrush x:Key="CardBgHover" Color="#1E232F" />
        <SolidColorBrush x:Key="BorderDark" Color="#252B38" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F4F9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9BA5B7" />
        <SolidColorBrush x:Key="TextMuted" Color="#667085" />

        <!-- FLAT REFINED COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <!-- Clean Chevron Dropdown Arrow -->
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{StaticResource TextSecondary}"
                          StrokeThickness="1.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#3A4356" />
                    <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#3A4356" />
                    <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- REFINED DESKTOP COMBOBOX STYLE -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#171B24" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6,28,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid x:Name="dropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="260">
                                    <Border x:Name="dropDownBorder"
                                            Background="#171B24"
                                            BorderBrush="{StaticResource BorderDark}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.5" ShadowDepth="2" />
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" Margin="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3A4356" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#3A4356" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- REFINED COMBOBOX ITEM STYLE -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#171B24" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222733" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,2" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A202C" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Crisp 1px Border & Subtle Elevation -->
    <Border x:Name="RootBorder" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="46" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CUSTOM SLEEK TITLE BAR -->
            <!-- Dragging, snapping and double-click maximize are handled by WindowChrome (CaptionHeight="46"). -->
            <Border Grid.Row="0" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NitroLite" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Border Background="#1A202C" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Right Controls: Status Badges + Window Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="BadgeBattery" Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtBatteryIcon" Text="BAT:" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBatteryHeader" Text="--%" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BadgeMode" Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtModeHeader" Text="BALANCED" Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </Border>

                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült">
                            <TextBlock Text="–" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Büyüt">
                            <TextBlock x:Name="TxtMaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Close Button (Minimizes to tray) -->
                        <Button Click="BtnClose_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Tepsiye gizle">
                            <TextBlock Text="✕" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN BODY (Sidebar Nav + Tab Content) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR NAVIGATION -->
                <Border Grid.Column="0" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="12,16">
                    <StackPanel>
                        <TextBlock Text="Gezinti" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="12,0,0,8" />
                        <RadioButton x:Name="NavModes" Style="{StaticResource NavButton}" Content="Çalışma Modları" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavMonitoring" Style="{StaticResource NavButton}" Content="Donanım İzleme &amp; OSD" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavRgb" Style="{StaticResource NavButton}" Content="Klavye Aydınlatması" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavBattery" Style="{StaticResource NavButton}" Content="Pil &amp; Termal Sağlık" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDebloat" Style="{StaticResource NavButton}" Content="Sistem Servisleri &amp; Ayarlar" Checked="Nav_Checked" />

                        <Separator Background="{StaticResource BorderDark}" Margin="8,16" />

                        <!-- Quick HW Status in Sidebar -->
                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Sistem Durumu" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                                <Grid Margin="0,3">
                                    <TextBlock Text="CPU Sıcaklığı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="TxtSideCpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="GPU Sıcaklığı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="TxtSideGpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Fan Hızı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="TxtSideCpuFan" Text="-- RPM" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="CPU Boost:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="TxtSideCpuBoost" Text="Agresif" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="RowSideMouseProfile" Margin="0,3" Visibility="Collapsed">
                                    <TextBlock Text="Fare Profili:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="TxtSideMouseProfile" Text="Config 1" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TAB CONTENT CONTAINER -->
                <Grid Grid.Column="1" Margin="20">
                    
                    <!-- TAB 1: MODES & FANS -->
                    <Grid x:Name="TabModes" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Çalışma Modları ve Fan Kontrolü" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Donanım güç limitleri, fan profilleri ve oyuna özel yapılandırmalar." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" />

                                <!-- Mode Selection Cards (texts follow NitroSense's own mode descriptions) -->
                                <UniformGrid Columns="5" Margin="0,0,0,6">
                                    <!-- QUIET -->
                                    <Button x:Name="BtnModeQuiet" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Quiet" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Sessiz" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Olabildiğince sessiz; toplantı, ders, internet gibi hafif kullanım" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" MinHeight="44" />
                                            <Border x:Name="IndQuiet" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtIndQuiet" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- BALANCED / DEFAULT -->
                                    <Button x:Name="BtnModeDefault" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Default" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Dengeli" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Günlük kullanım için önerilen; ofis ve genel işler" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" MinHeight="44" />
                                            <Border x:Name="IndDefault" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtIndDefault" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- PERFORMANCE / EXTREME -->
                                    <Button x:Name="BtnModeExtreme" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Extreme" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Performans" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Oyun için; CPU ve GPU hız aşırtmalı, fan devri sınırlı" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" MinHeight="44" />
                                            <Border x:Name="IndExtreme" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtIndExtreme" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- TURBO -->
                                    <Button x:Name="BtnModeTurbo" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Turbo" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Turbo" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentRed}" />
                                            <TextBlock Text="Sınırsız oyun; en yüksek hız aşırtma ve fan devri" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" MinHeight="44" />
                                            <Border x:Name="IndTurbo" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtIndTurbo" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- ECO (reported by AASSvc as mode 6; NitroSense offers it on battery) -->
                                    <Button x:Name="BtnModeEco" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Eco" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="Eco" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentGreen}" />
                                            <TextBlock Text="En düşük güç tüketimi; pilde daha uzun kullanım" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" MinHeight="44" />
                                            <Border x:Name="IndEco" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtIndEco" Text="SEÇ" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <TextBlock x:Name="TxtModeLockNote" Visibility="Collapsed" Foreground="{StaticResource AccentRed}" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,0" />
                                <Border Height="10" />


                                <!-- ROW: FAN CONTROL & GLOBAL CPU BOOST -->
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- FAN CONTROL CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- CPU FAN -->
                                            <StackPanel Grid.Column="0" Margin="4,0,8,0">
                                                <TextBlock Text="CPU Fanı" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the card is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4">
                                                    <TextBlock x:Name="TxtCpuFanRpm" Text="3089 RPM" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarCpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Height="4" Value="50" Maximum="6000" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" />
                                            </StackPanel>

                                            <!-- GPU FAN -->
                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="GPU Fanı" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the card is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4">
                                                    <TextBlock x:Name="TxtGpuFanRpm" Text="3075 RPM" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarGpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Height="4" Value="50" Maximum="6000" Background="#222733" Foreground="{StaticResource AccentRed}" BorderThickness="0" />
                                            </StackPanel>

                                            <!-- FAN TOGGLES -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button x:Name="BtnFanAuto" Content="Otomatik" Click="BtnFanAuto_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,6" Margin="0,0,0,6" Cursor="Hand" FontSize="11" />
                                                <Button x:Name="BtnFanMax" Content="Maksimum" Click="BtnFanMax_Click" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- GLOBAL CPU BOOST CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="CPU Performans Artışı (Boost)" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBoostStatusBadge" Text=" (--)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Windows güç planı işlemci saat frekansı davranışı." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,10" />

                                            <UniformGrid Columns="3">
                                                <Button x:Name="BtnBoostAggressive" Content="Agresif" Click="BtnBoost_Click" Tag="Aggressive" Background="#222733" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6,8" Margin="2" Cursor="Hand" FontSize="11" ToolTip="Windows boost değeri 2: işlemci yükte mümkün olan en yüksek frekansa çıkar" />
                                                <Button x:Name="BtnBoostEfficient" Content="Verimli" Click="BtnBoost_Click" Tag="Efficient" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6,8" Margin="2" Cursor="Hand" FontSize="11" ToolTip="Windows boost değeri 4 (Efficient Aggressive): boost açık, verimlilik öncelikli; frekans sabit bir değerle sınırlanmaz" />
                                                <Button x:Name="BtnBoostDisabled" Content="Devre Dışı" Click="BtnBoost_Click" Tag="Disabled" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6,8" Margin="2" Cursor="Hand" FontSize="11" ToolTip="Windows boost değeri 0: işlemci taban frekansının üzerine çıkmaz (7840HS için yaklaşık 3.8 GHz)" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- GPU OPERATING MODE / MUX SWITCH CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="GPU Çalışma Modu (MUX Switch)" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                <Border x:Name="BadgeGpuMode" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock x:Name="TxtGpuModeBadge" Text="Yükleniyor..." Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Ekran kartı bağlantı modu. Harici GPU doğrudan ekrana bağlanarak gecikmeyi düşürür ve maksimum FPS sağlar." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtGpuModeNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource AccentRed}" FontSize="11" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Items are filled only from the modes AASSvc reports as supported (SUPPORT_GPU_MODE_CAPABILITY). -->
                                            <ComboBox x:Name="CmbGpuMode" Width="230" Margin="0,0,8,0" IsEnabled="False" />
                                            <Button x:Name="BtnApplyGpuMode" IsEnabled="False" Content="Modu Uygula" Click="BtnApplyGpuMode_Click" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="14,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçilen GPU modunu uygular." />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ENHANCED PER-GAME PROFILE & AUTO DETECTION -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Header & Active Game Live Badge -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Oyun Profili Yönetimi" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                    <Border x:Name="BadgeGameStatus" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock x:Name="TxtGameStatus" Text="Durum: Beklemede (Aktif oyun yok)" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Yürütülebilir dosya algılandığında ilgili mod ve fan yapılandırması otomatik uygulanır." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Auto Mode Global Switch -->
                                            <CheckBox x:Name="ChkAutoGameMode" Content="Otomatik oyun algılamayı etkinleştir" IsChecked="True" Checked="ChkAutoGameMode_Changed" Unchecked="ChkAutoGameMode_Changed" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Desktop / Default Mouse Profile Card -->
                                        <Border x:Name="CardDefaultMouseProfile" Visibility="Collapsed" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Masaüstü &amp; Varsayılan Fare Profili:" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
                                                        <Border x:Name="BadgeDefaultMouseProfile" Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                            <TextBlock x:Name="TxtDefaultMouseProfileStatus" Text="Config 1 (Aktif)" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Oyunlar kapandığında veya masaüstü kullanımında farenin otomatik döneceği varsayılan donanım profili." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="CmbDefaultAtkMouseProfile" Width="180" Margin="0,0,8,0" SelectionChanged="CmbDefaultAtkMouseProfile_SelectionChanged">
                                                        <ComboBoxItem Content="Config 1 (Önerilen)" Tag="1" />
                                                        <ComboBoxItem Content="Config 2" Tag="2" />
                                                        <ComboBoxItem Content="Config 3" Tag="3" />
                                                        <ComboBoxItem Content="Config 4" Tag="4" />
                                                        <ComboBoxItem Content="Son Kullanılanı Koru" Tag="0" />
                                                    </ComboBox>
                                                    <Button x:Name="BtnApplyDefaultMouseProfile" Content="Uygula" Click="BtnApplyDefaultMouseProfile_Click" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili varsayılan profili fare donanımına anında uygular ve kaydeder." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Game Selection, Auto Scan, Add Custom Game, Delete -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="320" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Select Game Dropdown -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Yapılandırılacak Oyun:" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CmbConfiguredGames" SelectionChanged="CmbConfiguredGames_SelectionChanged" />
                                                </StackPanel>

                                                <!-- Action Buttons: Scan, Add, Delete -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Button x:Name="BtnScanGames" Content="Yüklü Oyunları Tara" Click="BtnScanGames_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Steam ve Epic Games kütüphanelerindeki oyunları listeye ekler." />
                                                    <Button x:Name="BtnAddCustomGame" Content="Oyun Ekle (.exe)" Click="BtnAddCustomGame_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Çalıştırılabilir dosya seçerek özel profil tanımlar." />
                                                    <Button x:Name="BtnDeleteGame" Content="Profili Sil" Click="BtnDeleteGame_Click" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili oyun profilini kayıtlı yapılandırmadan siler." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: Per-Game Detailed Configuration Grid -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Seçili Oyun Yapılandırması:" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock x:Name="TxtSelectedGameNameBadge" Text=" [Counter-Strike 2]" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtSelectedGameExePath" Text="cs2.exe" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                </Grid>

                                                <UniformGrid x:Name="GridGameSettingsRow" Columns="3" Margin="0,0,0,12">
                                                    <!-- Target Operating Mode -->
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Çalışma Modu:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetMode">
                                                            <ComboBoxItem Content="Turbo (Yüksek Güç Sınırı)" IsSelected="True" Tag="Turbo" />
                                                            <ComboBoxItem Content="Performans" Tag="Extreme" />
                                                            <ComboBoxItem Content="Dengeli (Varsayılan)" Tag="Default" />
                                                            <ComboBoxItem Content="Sessiz (Düşük Güç)" Tag="Quiet" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target CPU Boost Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="CPU Boost Davranışı:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetCpuBoost">
                                                            <ComboBoxItem Content="Devre Dışı (taban frekans)" IsSelected="True" Tag="Disabled" />
                                                            <ComboBoxItem Content="Verimli" Tag="Efficient" />
                                                            <ComboBoxItem Content="Agresif" Tag="Aggressive" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target Fan Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="Fan Profili:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetFan">
                                                            <ComboBoxItem Content="Otomatik Fan Eğrisi" IsSelected="True" Tag="Auto" />
                                                            <ComboBoxItem Content="Maksimum Devir (Sabit)" Tag="Max" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- ATK Mouse Profile -->
                                                    <StackPanel x:Name="PnlGameAtkMouseProfile" Visibility="Collapsed" Margin="6,0,0,0">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="ATK Fare Profili:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Button x:Name="BtnTestMouseProfile" Content="Dene" Click="BtnTestMouseProfile_Click" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="Seçili fare profilini donanım üzerinde anında test eder." />
                                                        </Grid>
                                                        <ComboBox x:Name="CmbGameAtkMouseProfile">
                                                            <ComboBoxItem Content="Değiştirme (Pasif)" IsSelected="True" Tag="0" />
                                                            <ComboBoxItem Content="Config 1 (Profil 1)" Tag="1" />
                                                            <ComboBoxItem Content="Config 2 (Profil 2)" Tag="2" />
                                                            <ComboBoxItem Content="Config 3 (Profil 3)" Tag="3" />
                                                            <ComboBoxItem Content="Config 4 (Profil 4)" Tag="4" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <!-- Save Profile Action Button & Description -->
                                                <Grid>
                                                    <TextBlock Text="Oyun açılışında ilgili ayarlar otomatik uygulanır, kapanışta masaüstü profili geri yüklenir." Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,230,0" TextWrapping="Wrap" />
                                                    <Button x:Name="BtnSaveGameProfile" Content="Yapılandırmayı Kaydet" Click="BtnSaveGameProfile_Click" Background="{StaticResource AccentCyan}" Foreground="#0F1115" FontWeight="Bold" Padding="14,8" HorizontalAlignment="Right" Cursor="Hand" FontSize="11" BorderThickness="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: LIVE MONITORING & OSD -->
                    <Grid x:Name="TabMonitoring" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Donanım Telemetrisi ve OSD Göstergesi" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="AASSvc ve NVML sensör arabirimlerinden gerçek zamanlı donanım telemetrisi." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- OSD Overlay Controls -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleOsd" Content="Ekran Üstü Gösterge (OSD)" Click="BtnToggleOsd_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="Oyun esnasında donanım kullanım verilerini ekranda gösterir." />
                                        <Button x:Name="BtnCycleOsdCorner" Content="Konum Değiştir" Click="BtnCycleOsdCorner_Click" Margin="8,0,0,0" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="10,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="OSD katmanını ekran köşeleri arasında taşır." />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <!-- CPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtMonCpuName" Text="İşlemci" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock x:Name="TxtCpuCoreCount" Text=" (16 Çekirdek)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                            </StackPanel>
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuTemp" Height="4" Maximum="100" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Paket Güç Tüketimi:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuPower" Text="-- W" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuPower" Height="4" Maximum="80" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="İşlemci Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuUsage" Text="-- %" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuUsage" Height="4" Maximum="100" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Clock in GHz -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Saat Frekansı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuFreqGhz" Text="-- GHz" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuFreq" Height="4" Maximum="5100" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtMonGpuName" Text="Ekran Kartı" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuTemp" Height="4" Maximum="100" Background="#222733" Foreground="{StaticResource AccentRed}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- TGP Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="TGP Güç Tüketimi:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuPower" Text="-- W" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuPower" Height="4" Maximum="140" Background="#222733" Foreground="{StaticResource AccentRed}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="GPU Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuUsage" Text="-- %" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuUsage" Height="4" Maximum="100" Background="#222733" Foreground="{StaticResource AccentRed}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- VRAM -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="VRAM Kullanımı:" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonVram" Text="-- GB / 8.0 GB" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonVram" Height="4" Maximum="8192" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- RAM & SYSTEM TEMP CARD WITH RAM CACHE CLEANER -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Sistem Belleği (RAM)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" />
                                                <Grid Margin="0,6">
                                                    <TextBlock x:Name="TxtMonRamDetail" Text="-- GB / -- GB" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtMonRamPercent" Text="-- %" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar x:Name="BarMonRam" Height="5" Maximum="100" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderThickness="0" />
                                                <TextBlock x:Name="TxtMonRamInfo" Text="--" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Sistem Sıcaklığı" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtMonSysTemp" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                <TextBlock Text="Acer servisinin SYS1 sensörü (konumu Acer tarafından belirtilmiyor)" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- RAM CACHE / STANDBY LIST CLEANER BAR -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Bekleme Belleğini Boşaltma" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtRamCleanStatus" Text=" (Hazır)" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkAutoRamClean" Content="Otomatik: RAM %88 dolduğunda veya 2 GB'tan az boş kaldığında (oyun sırasında çalışmaz)" IsChecked="False" Checked="ChkAutoRamClean_Changed" Unchecked="ChkAutoRamClean_Changed" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="TxtRamCleanNote" Text="Windows'un önbellekte tuttuğu (bekleme listesi) belleği boşaltır. Çalışan programların belleğine dokunmaz. Yönetici izni gerekir." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
