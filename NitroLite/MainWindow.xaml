                                                <ComboBoxItem Content="GPU Sıcaklığı (°C)" Tag="GPU_TEMP" />
                                                <ComboBoxItem Content="CPU Güç Tüketimi (W, tahmini)" Tag="CPU_WATT" />
                                                <ComboBoxItem Content="GPU Güç Tüketimi (W)" Tag="GPU_WATT" />
                                                <ComboBoxItem Content="CPU Saat Frekansı (GHz)" Tag="CPU_GHZ" />
                                                <ComboBoxItem Content="CPU Kullanımı (%)" Tag="CPU_USAGE" />
                                                <ComboBoxItem Content="GPU Kullanımı (%)" Tag="GPU_USAGE" />
                                                <ComboBoxItem Content="RAM Kullanımı (%)" Tag="RAM_USAGE" />
                                                <ComboBoxItem Content="VRAM Kullanımı (GB)" Tag="VRAM_GB" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- The Graph Canvas -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Height="140" ClipToBounds="True">
                                            <Grid>
                                                <!-- Subtle Grid Guide Lines with Scale Reference Labels -->
                                                <Border BorderBrush="#1C212E" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,25,0,0" />
                                                <TextBlock x:Name="TxtChartGridTop" Text="--" Foreground="#475467" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,8,0" />

                                                <Border BorderBrush="#1C212E" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,70,0,0" />
                                                <TextBlock x:Name="TxtChartGridMid" Text="--" Foreground="#475467" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,59,8,0" />

                                                <Border BorderBrush="#1C212E" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,115,0,0" />
                                                <TextBlock x:Name="TxtChartGridBottom" Text="--" Foreground="#475467" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,104,8,0" />

                                                <Canvas x:Name="CanvasHistoryChart" ClipToBounds="True">
                                                    <Polygon x:Name="ChartArea" Fill="#180EA5E9" StrokeThickness="0" />
                                                    <Polyline x:Name="ChartLine" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                    <Ellipse x:Name="ChartDot" Width="7" Height="7" Fill="{StaticResource AccentCyan}" Stroke="#0F1115" StrokeThickness="1.5" />
                                                </Canvas>
                                            </Grid>
                                        </Border>

                                        <!-- Live Statistics Badges Below Graph -->
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Mevcut" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartCurrentVal" Text="-- °C" Foreground="{StaticResource AccentCyan}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Minimum (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMinVal" Text="-- °C" Foreground="{StaticResource AccentGreen}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Maksimum (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMaxVal" Text="-- °C" Foreground="{StaticResource AccentRed}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Ortalama (60 sn)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartAvgVal" Text="-- °C" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: KEYBOARD RGB -->
                    <Grid x:Name="TabRgb" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Klavye RGB Aydınlatma Kontrolü" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Dört bölgeli RGB renk dizilimi, dinamik aydınlatma efektleri ve donanım profilleri." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" />

                                <!-- 4 Zones Visual Preview -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Dört Bölgeli Aydınlatma Düzeni (rengini değiştirmek için bölgeye tıklayın)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                                        <UniformGrid Columns="4" Height="64">
                                            <Border x:Name="PreviewZone1" Tag="0" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="#0EA5E9" CornerRadius="4" Margin="3" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="Bölge 1 (Sol)" Foreground="#0F1115" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PreviewZone2" Tag="1" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="#0EA5E9" CornerRadius="4" Margin="3" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="Bölge 2 (Orta Sol)" Foreground="#0F1115" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PreviewZone3" Tag="2" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="#0EA5E9" CornerRadius="4" Margin="3" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="Bölge 3 (Orta Sağ)" Foreground="#0F1115" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PreviewZone4" Tag="3" MouseLeftButtonUp="PreviewZone_Click" Cursor="Hand" ToolTip="Bu bölgenin rengini seçmek için tıklayın (Sabit Renk efektinde)" Background="#0EA5E9" CornerRadius="4" Margin="3" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="Bölge 4 (Sayısal)" Foreground="#0F1115" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock x:Name="TxtZonePreviewNote" Text="" Visibility="Collapsed" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="3,8,3,0" />
                                    </StackPanel>
                                </Border>

                                <!-- MODULE 4: RGB PRESET MANAGER CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Aydınlatma Profilleri" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Ön tanımlı aydınlatma temalarını uygulayabilir veya özel konfigürasyon kaydedebilirsiniz." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Preset Dropdown -->
                                            <ComboBox x:Name="CmbRgbPresets" Grid.Column="0" SelectionChanged="CmbRgbPresets_SelectionChanged" VerticalAlignment="Center" />

                                            <!-- Save Custom Preset input -->
                                            <TextBox x:Name="TxtCustomPresetName" Grid.Column="1" Margin="10,0" Background="#13161D" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="10,7" FontSize="11" VerticalAlignment="Center" ToolTip="Yeni profil adı" />

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnSaveCustomPreset" Content="Profili Kaydet" Click="BtnSaveCustomPreset_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                                <Button x:Name="BtnDeleteCustomPreset" Content="Profili Sil" Click="BtnDeleteCustomPreset_Click" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Color Presets & Turn Off Controls -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Hızlı Renk Seçimi" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button x:Name="BtnTurnOffLights" Content="Aydınlatmayı Kapat" Click="BtnTurnOffLights_Click" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="BtnPresetColor_Click" Tag="#00E5FF" Background="#00E5FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Camgöbeği (Cyan)" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FF2A55" Background="#FF2A55" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kırmızı" />
                                        <Button Click="BtnPresetColor_Click" Tag="#00FFA3" Background="#00FFA3" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Yeşil" />
                                        <Button Click="BtnPresetColor_Click" Tag="#BD00FF" Background="#BD00FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Mor" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FFAA00" Background="#FFAA00" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Turuncu" />
                                        <Button Click="BtnPresetColor_Click" Tag="#FFFFFF" Background="#FFFFFF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Beyaz" />
                                        <Button Click="BtnPresetColor_Click" Tag="#000000" Background="#000000" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kapalı" />
                                        <Button x:Name="BtnCustomColor" Content="Özel Renk…" Click="BtnCustomColor_Click" Height="36" Padding="12,0" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold" ToolTip="Herhangi bir renk seçin (tüm bölgeler)" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Controls: Effect, Brightness, Speed, Timeout -->
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Aydınlatma Efekti:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbRgbEffect" SelectionChanged="CmbRgbEffect_SelectionChanged" Margin="0,0,0,12">
                                                <ComboBoxItem Content="STATIC (Sabit Renk)" IsSelected="True" />
                                                <ComboBoxItem Content="WAVE (Dalga)" />
                                                <ComboBoxItem Content="BREATHING (Nefes)" />
                                                <ComboBoxItem Content="NEON (Neon Geçiş)" />
                                                <ComboBoxItem Content="SHIFTING (Renk Kayması)" />
                                                <ComboBoxItem Content="ZOOM (Büyüme)" />
                                                <ComboBoxItem Content="METEOR (Kayan Işık)" />
                                                <ComboBoxItem Content="TWINKLING (Yıldız Parıltısı)" />
                                                <ComboBoxItem Content="OFF (Işık Kapalı)" />
                                            </ComboBox>
                                            <TextBlock x:Name="TxtRgbEffectNote" Text="" Visibility="Collapsed" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,-6,0,10" />

                                            <StackPanel x:Name="PnlRgbDirection" Visibility="Collapsed" Margin="0,0,0,10">
                                                <TextBlock Text="Efekt Yönü:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <ComboBox x:Name="CmbRgbDirection" SelectionChanged="CmbRgbDirection_SelectionChanged" />
                                            </StackPanel>

                                            <CheckBox x:Name="ChkBacklightTimeout" Content="30 saniye boşta kaldığında aydınlatmayı kapat" Checked="ChkBacklightTimeout_Changed" Unchecked="ChkBacklightTimeout_Changed" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Parlaklık:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBrightnessVal" Text="5 / 9" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderBrightness" Minimum="0" Maximum="9" Value="5" ValueChanged="SliderBrightness_ValueChanged" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Efekt Hızı:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtSpeedVal" Text="3 / 9" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderSpeed" Minimum="1" Maximum="9" Value="3" ValueChanged="SliderSpeed_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 4: BATTERY HEALTH & SAFE DISCHARGE -->
                    <Grid x:Name="TabBattery" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Pil Şarj Sınırı ve Güvenli Deşarj" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Donanım pil sağlığını korumak için şarj sınırını %80 seviyesinde tutar ve kontrollü deşarj sağlar." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" />

                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- BATTERY STATUS CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Şarj Durumu" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <TextBlock x:Name="TxtBatLevelBig" Text="--%" Foreground="{StaticResource AccentGreen}" FontSize="32" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBatStateDesc" Text="Adaptöre Bağlı" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>

                                            <ProgressBar x:Name="BarBatBig" Height="6" Maximum="100" Value="80" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderThickness="0" Margin="0,6,0,12" />

                                            <!-- Live Real-Time Discharge / Charge Rate Indicator -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Anlık Güç Akışı:" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtBatDischargeRate" Text="0.0 W (Adaptörde)" Foreground="{StaticResource AccentCyan}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtBatRemainingTime" Text="Kalan Süre: --" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <CheckBox x:Name="ChkWatchdog" Content="%80 şarj koruma sınırını uygula" Checked="ChkWatchdog_Changed" Unchecked="ChkWatchdog_Changed" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,4" />
                                            <TextBlock Text="Şarj sınırı Acer Care Center üzerinden ayarlanır ve bilgisayar yeniden başlasa da korunur." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />

                                            <Separator Background="{StaticResource BorderDark}" Margin="0,8,0,8" />
                                            <TextBlock Text="Pilde Çalışma Güç Profili (DC Modu):" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbDcPowerMode" SelectionChanged="CmbDcPowerMode_SelectionChanged" Background="#13161D" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" FontSize="11" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Eco Modu (60Hz + Sessiz Fan + Güç Tasarrufu)" Tag="Eco" IsSelected="True" />
                                                <ComboBoxItem Content="Dengeli Mod (Mevcut Ayarları Koru)" Tag="Balanced" />
                                            </ComboBox>
                                            <CheckBox x:Name="ChkAutoRefreshRate" Content="Otomatik ekran tazeleme hızı (60Hz / 165Hz)" Checked="ChkAutoRefreshRate_Changed" Unchecked="ChkAutoRefreshRate_Changed" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,2" />
                                        </StackPanel>
                                    </Border>

                                    <!-- SAFE DISCHARGE CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Hedef Seviyeye Deşarj" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                                            <TextBlock Text="Adaptör bağlantısı kesildiğinde kontrollü işlemci yükü oluşturarak pili %80 hedef seviyesine indirir ve otomatik durur." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                            <Border x:Name="DischargeStatusBox" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                                <TextBlock x:Name="TxtDischargeStatus" Text="Durum: Boşta" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>

                                            <Button x:Name="BtnToggleDischarge" Content="Deşarj İşlemini Başlat" Click="BtnToggleDischarge_Click" Background="{StaticResource AccentCyan}" Foreground="#0F1115" FontWeight="Bold" FontSize="12" Padding="12,9" BorderThickness="0" Cursor="Hand" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- MODULE 3: BATTERY HEALTH & WEAR REPORT CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Batarya Kapasite ve Aşınma Durumu" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="WMI donanım arabirimi üzerinden okunan kapasite ve gerilim telemetrisi." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BtnRefreshBatHealth" Content="Verileri Güncelle" Click="BtnRefreshBatHealth_Click" Background="#222733" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="10,6" HorizontalAlignment="Right" Cursor="Hand" FontSize="11" />
                                        </Grid>

                                        <UniformGrid Columns="4">
                                            <!-- Health -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Pil Sağlığı" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatHealthPercent" Text="92.3 %" Foreground="{StaticResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock Text="Nominal" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Wear Level -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Aşınma Seviyesi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatWearPercent" Text="7.7 %" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock Text="Düşük Aşınma (&lt; %10)" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Capacity Comparison -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Tam Şarj Kapasitesi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatFullChargeCap" Text="83.637 mWh" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,6,0,2" />
                                                    <TextBlock x:Name="TxtBatDesignCap" Text="Tasarım: 90.614 mWh" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Voltage -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Hücre Gerilimi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatVoltage" Text="16.50 V" Foreground="{StaticResource AccentPurple}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock Text="4 Hücreli Lityum-İyon" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- TERMAL MACUN, PUTTY & FAN SAĞLIK RAPORU (ÖMÜR & TREND) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Termal İletkenlik ve Soğutma Analizi" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="İşlemci termal direnci, fan çalışma süreleri ve çok günlük termal kararlılık trendi." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtThermalBadge" Text="Termal Direnç: Nominal" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </Grid>

                                        <UniformGrid Columns="4" Margin="0,0,0,12">
                                            <!-- Paste / Thermal Putty Health -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Termal İletkenlik Durumu" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtPasteHealthPercent" Text="98.5 %" Foreground="{StaticResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtThermalResistance" Text="Direnç Oranı: 2.15 °C/W" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Active Fan Run Hours -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Aktif Fan Çalışma Süresi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtActiveFanHours" Text="-- Saat" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtAvgFanRpm" Text="Ortalama: 2650 RPM" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Passive / Silent Zero RPM Hours -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Pasif Soğutma Süresi" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtPassiveFanHours" Text="-- Saat" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock Text="0 RPM (Pasif Profil)" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Fan Bearing & Motor Health -->
                                            <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Fan Motor / Rulman Sağlığı" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtFanBearingHealth" Text="99.4 %" Foreground="{StaticResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock Text="Hesaplanan MTBF: 30.000 Saat" Foreground="{StaticResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- 14 / 30 GÜN TERMAL KARARLILIK & YAŞLANMA TRENDİ GÖSTERGESİ -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Termal Kararlılık ve Trend Analizi" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtStabilityDaysSubtitle" Text=" (30 Günlük Veri)" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <RadioButton x:Name="RadioTrend14Days" Content="14 Gün" Tag="14" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,12,0" Checked="RadioTrendPeriod_Checked" />
                                                        <RadioButton x:Name="RadioTrend30Days" Content="30 Gün" Tag="30" Foreground="{StaticResource TextSecondary}" FontSize="11" IsChecked="True" Checked="RadioTrendPeriod_Checked" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtStabilityScore" Text="%98.7" Foreground="{StaticResource AccentGreen}" FontSize="16" FontWeight="Bold" Margin="0,0,10,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtStabilityStatus" Text="Kararlı, Termal iletkenlik nominal" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                            <TextBlock x:Name="TxtStabilitySlope" Text="Eğim: +0.001 °C/W/gün (Kararlı)" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtStabilityBadge" Text="Nominal" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="10" />
                                                    </Border>
                                                </Grid>

                                                <ProgressBar x:Name="BarStabilityScore" Height="5" Maximum="100" Value="98.7" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderThickness="0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- ALT BİLEŞEN TERMAL TELEMETRİ MATRİSİ (VRM, NVMe SSD'ler, PİL) -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Bileşen Sıcaklık Matrisi" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" />
                                                    <TextBlock Text="ACPI, SMART ve AcerAgent arabirimlerinden canlı veriler." Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right" />
                                                </Grid>

                                                <UniformGrid Columns="4">
                                                    <!-- Motherboard / VRM -->
                                                    <Border Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="3">
                                                        <StackPanel>
                                                            <TextBlock Text="Anakart / VRM" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock x:Name="TxtSubMoboTemp" Text="54 °C" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                            <TextBlock Text="SYS1 (ACPI)" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- NVMe SSD 1 (990 Pro) -->
                                                    <Border Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="3">
                                                        <StackPanel>
                                                            <TextBlock Text="NVMe SSD 1 (C:)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock x:Name="TxtSubSsd1Temp" Text="42 °C" Foreground="{StaticResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                            <TextBlock Text="Samsung 990 PRO" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- NVMe SSD 2 (PM9A1) -->
                                                    <Border Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="3">
                                                        <StackPanel>
                                                            <TextBlock Text="NVMe SSD 2 (D:)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock x:Name="TxtSubSsd2Temp" Text="39 °C" Foreground="{StaticResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                            <TextBlock Text="Samsung PM9A1" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Battery Pack -->
                                                    <Border Background="#171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="3">
                                                        <StackPanel>
                                                            <TextBlock Text="Batarya Hücreleri" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                            <TextBlock x:Name="TxtSubBatteryTemp" Text="29.5 °C" Foreground="{StaticResource AccentCyan}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                            <TextBlock Text="LGC AP21A8T (WMI)" Foreground="{StaticResource TextSecondary}" FontSize="9" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Analysis & Proactive Maintenance Recommendation Box -->
                                        <Border Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Termal Durum Özeti:" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="TxtThermalRecommendation" Text="Termal direnç ve ısı transferi nominal tolerans sınırları içindedir. Bakım gerekmemektedir." Foreground="{StaticResource TextPrimary}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- STORAGE HEALTH & CAPACITY BARS (NVMe SSD SAĞLIK & DOLULUK) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="NVMe Depolama Sürücüleri" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="PCIe Gen 4x4 NVMe SSD donanım sağlığı, SMART yıpranma verileri ve doluluk oranları." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Background="#1E232F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtStorageBadge" Text="Sürücüler Sağlıklı" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </Grid>

                                        <StackPanel x:Name="PanelStorageDrives">
                                            <!-- DRIVE 0: C: -->
                                            <Border x:Name="CardDrive0" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive0Letter" Text="[C:] " Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Name" Text="Samsung SSD 990 PRO 2TB" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Bus" Text=" (NVMe Gen 4x4)" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive0Temp" Text="42 °C" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive0HealthBadge" Text="Sağlık: %99 (Nominal)" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive0Detail" Text="514.0 GB / 1999.3 GB (%25.7 Dolu)" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive0Free" Text="1485.3 GB Boş" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive0" Height="5" Maximum="100" Value="25.7" Background="#222733" Foreground="{StaticResource AccentCyan}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- DRIVE 1: D: -->
                                            <Border x:Name="CardDrive1" Background="#13161D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive1Letter" Text="[D:] " Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Name" Text="SAMSUNG MZVL21T0HCLR-00B07 1TB" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Bus" Text=" (NVMe Gen 4x4)" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive1Temp" Text="39 °C" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive1HealthBadge" Text="Sağlık: %98 (Nominal)" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive1Detail" Text="185.8 GB / 1024.2 GB (%18.1 Dolu)" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive1Free" Text="838.4 GB Boş" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive1" Height="5" Maximum="100" Value="18.1" Background="#222733" Foreground="{StaticResource AccentGreen}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Overcharge Warning Banner (Hidden by default) -->
                                <Border x:Name="BannerOvercharge" Visibility="Collapsed" Background="#2A1B28" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="[ ! ]" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Şarj Eşiği Aşıldı" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock x:Name="TxtOverchargeMsg" Text="Pil seviyesi %80 sınırının üzerindedir. Dilerseniz hedef seviyeye deşarj işlemini başlatabilirsiniz." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: DEBLOAT HUB & SETTINGS -->
                    <Grid x:Name="TabDebloat" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Sistem Servisleri ve Başlangıç Ayarları" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Gereksiz OEM telemetri servislerini devre dışı bırakın ve başlangıç davranışını yapılandırın." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16" />

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="OEM Telemetri Servislerini Devre Dışı Bırak (Tier 1)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="AcerServiceSvc, ASMSvc, AcerDIAgentSvis, AcerEZSvc, AcerDeviceInfoAgentService, ADESv2" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Click="BtnApplyDebloat_Click" Content="Servisleri Devre Dışı Bırak (~214 MB)" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11" />
                                                <Button Click="BtnRestoreServices_Click" Content="Varsayılan Servisleri Etkinleştir" Background="#222733" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Service Status List -->
                                        <ItemsControl x:Name="ListServiceStatuses">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- NITROSENSE BACKGROUND SUPPRESSION & RAM CLEANER -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="NitroSense Arka Plan Yürütme Kısıtlaması" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock x:Name="TxtNitroSenseRunningBadge" Text=" (Devre Dışı)" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="NitroSense kapatıldığında arka plan servislerinin çalışmaya devam etmesini ve bellek tüketmesini engeller." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="BtnKillNitroSense" Grid.Column="1" Content="NitroSense İşlemlerini Sonlandır" Click="BtnKillNitroSense_Click" Background="#2A1B28" Foreground="{StaticResource AccentRed}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,8" Cursor="Hand" VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                </Border>

                                <!-- APP STARTUP SETTINGS -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Windows başlangıcında otomatik çalıştır" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Kullanıcı oturumu açıldığında arka planda başlatılır." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoStart" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,12" />

                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Sistem tepsisinde simge durumunda başlat" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="Uygulama açılışta ana pencereyi görüntülemeden sistem tepsisine küçülür." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkStartMinimized" Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{StaticResource BorderDark}" Margin="0,12" />

                                        <Grid>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="ATK Fare Entegrasyonu (ATK A9 vb.)" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="ATK fare donanım protokolünü, profil geçişlerini ve oyuna özel fare profili atamalarını etkinleştirir." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAtkMouseIntegration" Checked="ChkAtkMouseIntegration_Changed" Unchecked="ChkAtkMouseIntegration_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- MINIMALIST NON-BLOCKING TOAST NOTIFICATION BANNER -->
            <Border x:Name="ToastBanner" Grid.Row="1" Background="#F0171B24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtToastIcon" Text="●" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtToastMessage" Text="İşlem tamamlandı." Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
