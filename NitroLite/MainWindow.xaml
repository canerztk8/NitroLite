<Window x:Class="NitroLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NitroLite" 
        Icon="app.ico"
        Height="730" Width="1060"
        MinHeight="730" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Paper}"
        Foreground="{DynamicResource Ink}"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <!-- Borderless look with native window behaviour: edge resizing, Aero Snap, double-click to maximize.
         No AllowsTransparency, so WPF renders on the GPU; Windows draws the shadow (and rounded corners on 11). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The palette lives in Themes/Light.xaml and Themes/Dark.xaml, merged into Application.Resources
             before this window is built, so every StaticResource below resolves to the chosen theme. The
             styles stay here: they are the same in both themes and only point at the brushes. -->

        <!-- Figures are recorded, labels are written: the margin scale and every readout are set in
             a tabular face, the prose stays in the platform's humanist sans. -->
        <FontFamily x:Key="FigureFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- Keyboard focus: a 1px vermilion rule drawn just outside the control. WPF shows a FocusVisualStyle only
             when the focus arrived from the keyboard, so a mouse user never sees it, and the ring never competes
             with the hover and selected states the templates already draw. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   Stroke="{DynamicResource Vermilion}"
                                   StrokeThickness="1"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A printed label: small, uppercase, faint. Used for field names and captions. -->
        <Style x:Key="LabelCaps" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A recorded figure. -->
        <Style x:Key="Figure" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Vector glyphs from the Windows icon font. Segoe Fluent Icons ships with Windows 11; the MDL2 fallback
             covers Windows 10, where the same code points exist. No icon package, no image assets. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="NavIcon" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style x:Key="CardIcon" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- The heading scale is fixed so a card never has to guess: 15 for a section, 13.5 for a row inside it,
             11.5 for the one line of prose under either. The heading is always full ink; the prose is always faint.
             Before this, a 12px hint under a 13px title read as two headings fighting. -->
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row heading inside a card: one step down from the section title, still full ink. -->
        <Style x:Key="RowTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A section is a card on the paper: a ground one tone off the page, one hairline frame, an
             8px corner. The 21 existing CardBorder usages inherit this language, so every page groups
             its content the same way. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- The title bar's live figures are printed, not boxed. The MOD figure is the one that is also a control, so
             it takes a hover tone and a hand cursor and nothing else: no frame at rest. -->
        <Style x:Key="TitleBadgeButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBgHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A zone swatch is a control, not a colour chip: it answers the pointer with an ink frame so it is obvious
             that clicking it opens the picker. When the lights are off the swatch shows the empty paper tone instead
             of a solid ink block, which read as a dead black rectangle in the light theme and a white one in the dark. -->
        <Style x:Key="ZonePreview" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A reading in the left rail. It reads as a figure, but it is also the shortcut to the page that owns it:
             the hand cursor and the hover tone say so before the tooltip does. Not a card — a 2px corner and a
             transparent frame that only appears under the pointer, so the rail keeps its printed look at rest. -->
        <Style x:Key="SideStatRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBgHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A section's one-line summary. Smaller and fainter than the title, so the heading and the
             figures carry the hierarchy and the prose stays out of the way. -->
        <Style x:Key="SectionHint" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource InkFaint}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The (?) badge: a quiet ring that holds the detail a one-line summary leaves out. It answers a hover
             almost immediately (the default 400ms felt like nothing happened) and it also answers a click, which
             opens the same text in a popup for anyone who does not think to hover. -->
        <Style x:Key="InfoBadge" TargetType="{x:Type ContentControl}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <EventSetter Event="MouseLeftButtonUp" Handler="InfoBadge_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <Border x:Name="ring" Width="15" Height="15" CornerRadius="7.5"
                                Background="Transparent"
                                BorderBrush="{DynamicResource RuleStrong}" BorderThickness="1">
                            <TextBlock Text="?" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkFaint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                <Setter TargetName="ring" Property="Background" Value="{DynamicResource CardBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat button: no chrome, no bevel. Hover is a paper tone, never a colour. -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBgHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FLAT COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{DynamicResource InkFaint}"
                          StrokeThickness="1.4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Ink}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBgHover}" />
                    <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Ink}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6,26,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Grid x:Name="dropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="260">
                                    <Border x:Name="dropDownBorder"
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource RuleStrong}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Margin="0,3,0,3">
                                        <ScrollViewer SnapsToDevicePixels="True" Margin="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2" Margin="2,1"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <!-- The drop-down lives in a Popup, which has no adorner layer, so FocusVisualStyle
                                 would never draw here; the item marks keyboard focus on its own border instead.
                                 The 1px border is always reserved, so focusing an item never shifts its text. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Vermilion}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox: a small square that fills with the signal colour when set. -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="box" Width="14" Height="14" CornerRadius="1"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource RuleStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 0 3 L 2.5 5.5 L 7 0.5"
                                      Stroke="{DynamicResource OnAccent}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button: same square language as the checkbox, so the two read as one family. -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="box" Width="14" Height="14" CornerRadius="1"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource RuleStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="dot" Width="6" Height="6" CornerRadius="0"
                                        Background="{DynamicResource OnAccent}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: a 2px ruled track, the filled part in vermilion, a square ink thumb. -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="18" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Background="Transparent" Margin="4,0">
                            <Border Height="3" Background="{DynamicResource Rule}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="3" Background="{DynamicResource Ink}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource Ink}" CornerRadius="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar: a 3px ruled track with a solid fill. The fill follows Foreground, which the
             code-behind swaps for severity, so the bar never needs a second template. -->
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{DynamicResource Rule}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar: a thin ruled thumb, no arrows, no track chrome. -->
        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource RuleStrong}" CornerRadius="2" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <!-- Navigation: the current section is the sheet lifted off the rail, marked by a small
             vermilion time mark in the margin. No fill, no stripe. -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <!-- The label is a panel now (glyph + text), so the presenter renders it directly. The text inside it
                 still wraps, which is what keeps a long translated label from being clipped. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="mark" Grid.Column="0" Width="5" Height="5"
                                               Fill="{DynamicResource Ink}" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Paper}" />
                                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A mode is a compact tile, not a full-width row: the name, a two-word label and the state
             chip. The active tile is marked by the vermilion frame the code-behind writes into
             BorderBrush, plus the chip; the fill never changes, so state is still built by
             de-emphasis rather than by a coloured band. -->
        <Style x:Key="ModeCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- The resting frame is always drawn; the accent frame sits on top of it
                                 and is transparent until the mode becomes the active one. -->
                            <Border x:Name="ground"
                                    Background="{DynamicResource Paper}"
                                    BorderBrush="{DynamicResource Rule}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="accent"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter Margin="11,9" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ground" Property="Background" Value="{DynamicResource CardBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (fan mode, CPU boost). The selected option is the solid vermilion mark,
             the others stay flat paper; the code-behind swaps Background/Foreground. -->
        <Style x:Key="SegButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource RuleStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A checkbox as a switch: the square tick read as a form field next to the flat buttons around it.
             The track is the only thing that fills, and it fills with the accent, so "on" is legible at a glance
             without a second colour. The label stays outside the template, so a translated label still wraps. -->
        <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="34" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Rule}"
                                    BorderBrush="{DynamicResource RuleStrong}" BorderThickness="1"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Grid>
                                    <Ellipse x:Name="thumb" Width="12" Height="12"
                                             Fill="{DynamicResource Paper}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Vermilion}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Vermilion}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A segmented control: one frame around a row of options, so the four fan modes read as one choice
             rather than four unrelated buttons. The frame is drawn here; the items carry no border of their own
             and the code-behind fills the selected one. -->
        <Style x:Key="SegmentedGroup" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PaperDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="SegmentedItem" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="seg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail's resize handle: invisible at rest so the rail keeps its printed edge, a 1px accent rule
             under the pointer so it is discoverable. 5px wide is the smallest target that is still easy to grab. -->
        <Style x:Key="RailSplitter" TargetType="{x:Type GridSplitter}">
            <Setter Property="Width" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border x:Name="grip" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="line" Width="1" HorizontalAlignment="Center"
                                       Fill="{DynamicResource Vermilion}" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="line" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="line" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A theme preview: five swatches of the palette it names, so the choice is made by looking rather
             than by reading seven names. The active card is marked by the accent frame the code-behind writes
             into BorderBrush, the same rule the mode tiles follow. -->
        <Style x:Key="ThemeCard" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="ground" Background="{DynamicResource Paper}"
                                    BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="8"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="accent" Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter Margin="9,7" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ground" Property="Background" Value="{DynamicResource CardBgHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The recording sheet: one paper ground, one hairline frame. -->
    <Border x:Name="RootBorder" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Rule}" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="44" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <!-- Dragging, snapping and double-click maximize are handled by WindowChrome (CaptionHeight="46"). -->
            <Border Grid.Row="0" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NitroLite" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtAppVersion" Text="v1.2" Foreground="{DynamicResource InkFaint}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <!-- Appears only when GitHub reports a newer release; the update runs from here. -->
                        <Button x:Name="BtnUpdateNow" Click="BtnUpdateNow_Click" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="8,3" Cursor="Hand" FontSize="10" FontWeight="SemiBold" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="TxtUpdateNow" Text="Güncelle" />
                        </Button>
                        <!-- The notes for that same release, 6px to its right. It is the second half of one notice, so
                             it never shows on its own: UpdateNotice.Apply moves both, and nothing else touches this. -->
                        <Button x:Name="BtnReleaseNotes" Click="BtnReleaseNotes_Click" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="8,3" Cursor="Hand" FontSize="10" FontWeight="SemiBold" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Bu sürümün GitHub sayfasını tarayıcıda açar">
                            <TextBlock Text="Sürüm Notları" />
                        </Button>
                    </StackPanel>

                    <!-- Right Controls: live figures + window buttons. No boxes: the figures sit on the
                         paper like a printed header. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="BadgeBattery" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtBatteryIcon" Text="PİL" Foreground="{DynamicResource InkFaint}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBatteryHeader" Text="--%" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource FigureFont}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- The mode figure doubles as the quickest way to change it: the same list the tray menu
                             offers, filtered by the same capability and battery rules. -->
                        <Border x:Name="BadgeMode" Style="{StaticResource TitleBadgeButton}" Margin="0,0,14,0"
                                MouseLeftButtonUp="BadgeMode_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Çalışma modunu değiştir">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MOD" Foreground="{DynamicResource InkFaint}" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtModeHeader" Text="DENGELİ" Foreground="{DynamicResource Live}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Küçült">
                            <TextBlock Text="–" Foreground="{DynamicResource InkSoft}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Büyüt">
                            <TextBlock x:Name="TxtMaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource InkSoft}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Close Button (Minimizes to tray) -->
                        <Button Click="BtnClose_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Tepsiye gizle">
                            <TextBlock Text="✕" Foreground="{DynamicResource InkSoft}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN BODY (Sidebar Nav + Tab Content) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- The rail is resizable: a translated label can be longer than the Turkish one, and the
                         live readout under it has to stay on one line. The width is restored from settings. -->
                    <ColumnDefinition x:Name="ColSidebar" Width="215" MinWidth="175" MaxWidth="290" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR NAVIGATION -->
                <Border Grid.Column="0" Background="{DynamicResource RailBg}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" Padding="10,16,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="GEZİNTİ" Style="{StaticResource LabelCaps}" Margin="10,0,0,8" />
                            <RadioButton x:Name="NavModes" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D9;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="Çalışma Modları" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavMonitoring" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D2;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="Donanım İzleme &amp; OSD" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavRgb" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE765;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="Klavye Aydınlatması" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavBattery" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE83F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="Pil &amp; Termal Sağlık" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavDebloat" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE90F;" Style="{StaticResource NavIcon}" />
                                    <TextBlock Grid.Column="1" Text="Sistem Servisleri &amp; Araçlar" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- The live readout: a small card on the rail, so the figures read as one block rather
                             than as loose lines under the navigation. -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Rule}"
                                BorderThickness="1" CornerRadius="6" Padding="6,7,6,4" Margin="0,0,0,10">
                            <StackPanel>

                                <TextBlock Text="SİSTEM" Style="{StaticResource LabelCaps}" Margin="4,0,0,6" />
                                <!-- Each reading is a shortcut to the page that owns it. The figures keep their names and
                                     their place; only the frame around them answers the pointer. -->
                                <Border Style="{StaticResource SideStatRow}" Tag="Monitoring" MouseLeftButtonUp="SideStatRow_Click" ToolTip="Donanım izleme sayfasını açar">
                                    <Grid>
                                        <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" />
                                        <TextBlock x:Name="TxtSideCpuTemp" Text="-- °C" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SideStatRow}" Tag="Monitoring" MouseLeftButtonUp="SideStatRow_Click" ToolTip="Donanım izleme sayfasını açar">
                                    <Grid>
                                        <TextBlock Text="GPU" Style="{StaticResource LabelCaps}" />
                                        <TextBlock x:Name="TxtSideGpuTemp" Text="-- °C" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SideStatRow}" Tag="Modes" MouseLeftButtonUp="SideStatRow_Click" ToolTip="Fan kontrolü için çalışma modlarına gider">
                                    <Grid>
                                        <TextBlock Text="FAN" Style="{StaticResource LabelCaps}" />
                                        <TextBlock x:Name="TxtSideCpuFan" Text="-- RPM" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SideStatRow}" Tag="Boost" MouseLeftButtonUp="SideStatRow_Click" ToolTip="CPU Boost modunu seç">
                                    <Grid>
                                        <TextBlock Text="BOOST" Style="{StaticResource LabelCaps}" />
                                        <TextBlock x:Name="TxtSideCpuBoost" Text="Agresif" Foreground="{DynamicResource Ink}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border x:Name="RowSideMouseProfile" Style="{StaticResource SideStatRow}" Tag="Mouse" MouseLeftButtonUp="SideStatRow_Click" Visibility="Collapsed" ToolTip="Fare profilini seç">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="FARE" Style="{StaticResource LabelCaps}" />
                                        <!-- Two columns + trimming: a long failure text used to overlap the label. -->
                                        <TextBlock Grid.Column="1" x:Name="TxtSideMouseProfile" Text="Config 1" Foreground="{DynamicResource Olive}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- The signature sits at the very bottom of the rail, under the readout. Without the
                             explicit row it lands in row 0 and prints over the GEZİNTİ caption. -->
                        <TextBlock Grid.Row="3" Margin="10,0,10,10" FontSize="10" TextWrapping="Wrap" TextAlignment="Center">
                            <Run Text="♥" Foreground="{DynamicResource Vermilion}" />
                            <Run Text=" Made with love by · " Foreground="{DynamicResource InkFaint}" />
                            <Hyperlink Click="LinkAuthor_Click" Cursor="Hand">
                                <!-- A Hyperlink is a ContentElement, so FocusVisualStyle does not apply to it;
                                     it underlines itself when the keyboard reaches it instead. -->
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Setter Property="Foreground" Value="{DynamicResource Link}" />
                                        <Setter Property="TextDecorations" Value="None" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                                <Run Text="Caner" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- The rail's edge: drag to resize, double-click to reset. The reset listens on the preview event
                     because Thumb marks the mouse-down handled and captures the mouse, so MouseDoubleClick never
                     reaches a GridSplitter. -->
                <GridSplitter Grid.Column="1" Style="{StaticResource RailSplitter}"
                              DragCompleted="RailSplitter_DragCompleted"
                              PreviewMouseLeftButtonDown="RailSplitter_PreviewMouseLeftButtonDown"
                              ToolTip="Kenar çubuğu genişliğini sürükleyerek ayarla; çift tıkla varsayılana döndür" />

                <!-- TAB CONTENT CONTAINER -->
                <Grid Grid.Column="2" Margin="26,20,26,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Standing note while the Acer service is unreachable. The toast alone is gone after three
                         seconds, and a window whose every hardware control silently does nothing reads as broken. -->
                    <Border x:Name="ServiceBanner" Grid.Row="0" Visibility="Collapsed"
                            Background="{DynamicResource PaperDeep}" BorderBrush="{DynamicResource Rule}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Vermilion}" />
                            <StackPanel Grid.Column="1" Margin="12,9,12,10">
                                <TextBlock x:Name="TxtServiceBannerTitle" Style="{StaticResource LabelCaps}"
                                           Foreground="{DynamicResource Vermilion}" Text="ACER SERVİSİNE ULAŞILAMIYOR" />
                                <TextBlock x:Name="TxtServiceBannerBody" Foreground="{DynamicResource InkSoft}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TAB 1: MODES & FANS -->
                    <Grid x:Name="TabModes" Grid.Row="1" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Çalışma Modları" Foreground="{DynamicResource Ink}" FontSize="18" FontWeight="SemiBold" />

                                <!-- THE RECORDING: the last 60 seconds of CPU temperature as a continuous
                                     ink trace, a vermilion "now" edge, and a tick wherever the mode
                                     changed. This is the surface's signature move. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtTraceSpan" Text="60 SANİYE" Style="{StaticResource LabelCaps}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="ARALIK" Style="{StaticResource LabelCaps}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtTraceRange" Text="--" Style="{StaticResource Figure}" Foreground="{DynamicResource InkFaint}" FontSize="10" Margin="0,0,16,0" />
                                            <TextBlock Text="ŞİMDİ" Style="{StaticResource LabelCaps}" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtTraceValue" Text="-- °C" Style="{StaticResource Figure}" FontSize="11" />
                                            <!-- The strip is the tallest thing above the game profiles. One click folds it
                                                 away and the choice is remembered. -->
                                            <Button x:Name="BtnToggleTrace" Click="BtnToggleTrace_Click" Background="Transparent" BorderThickness="0" Padding="8,0,0,0" Margin="10,0,0,0" Cursor="Hand" ToolTip="Grafiği gizle">
                                                <TextBlock x:Name="TxtToggleTrace" Text="GİZLE" Style="{StaticResource LabelCaps}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 36px: enough for the trace to keep its shape, thin enough that the game profiles
                                         below it are reachable without scrolling. -->
                                    <Border x:Name="TraceChartBorder" Grid.Row="1" Height="36" Background="{DynamicResource PaperDeep}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                        <Grid>
                                            <Canvas x:Name="CanvasModeTrace" ClipToBounds="True">
                                                <Polyline x:Name="TraceLine" Stroke="{DynamicResource Ink}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                                                <Canvas x:Name="TraceMarks" />
                                                <Line x:Name="TraceNow" Stroke="{DynamicResource Vermilion}" StrokeThickness="1" StrokeDashArray="2 2" />
                                            </Canvas>
                                            <TextBlock x:Name="TxtTraceEmpty" Text="Kayıt bekleniyor" Style="{StaticResource LabelCaps}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- MODES: four compact tiles in one row instead of four full-width rows,
                                     so the game profile below is reachable without scrolling. Eco joins
                                     them on battery, where the high-power pair is hidden. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE945;" Style="{StaticResource CardIcon}" Foreground="{DynamicResource AccentCyan}" />
                                            <TextBlock Text="Güç Modları" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <UniformGrid Columns="4" Margin="0,0,-6,-6">
                                            <!-- QUIET -->
                                            <Button x:Name="BtnModeQuiet" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Quiet" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="LedQuiet" Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Vermilion}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="&#xE708;" Style="{StaticResource CardIcon}" />
                                                            <TextBlock Text="Sessiz" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border x:Name="IndQuiet" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Vermilion}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtIndQuiet" Text="AKTİF" Foreground="{DynamicResource Vermilion}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="Hafif kullanım" Style="{StaticResource SectionHint}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- BALANCED / DEFAULT -->
                                            <Button x:Name="BtnModeDefault" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Default" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="LedDefault" Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Vermilion}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9D2;" Style="{StaticResource CardIcon}" />
                                                            <TextBlock Text="Dengeli" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border x:Name="IndDefault" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Vermilion}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtIndDefault" Text="AKTİF" Foreground="{DynamicResource Vermilion}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="Günlük önerilen" Style="{StaticResource SectionHint}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- PERFORMANCE / EXTREME -->
                                            <Button x:Name="BtnModeExtreme" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Extreme" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="LedExtreme" Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Vermilion}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource CardIcon}" />
                                                            <TextBlock Text="Performans" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border x:Name="IndExtreme" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Vermilion}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtIndExtreme" Text="AKTİF" Foreground="{DynamicResource Vermilion}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="Yüksek oyun gücü" Style="{StaticResource SectionHint}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- TURBO -->
                                            <Button x:Name="BtnModeTurbo" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Turbo" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="LedTurbo" Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Vermilion}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="&#xE945;" Style="{StaticResource CardIcon}" />
                                                            <TextBlock Text="Turbo" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border x:Name="IndTurbo" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Vermilion}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtIndTurbo" Text="AKTİF" Foreground="{DynamicResource Vermilion}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="Maksimum performans" Style="{StaticResource SectionHint}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- ECO (reported by AASSvc as mode 6; NitroSense offers it on battery) -->
                                            <Button x:Name="BtnModeEco" Style="{StaticResource ModeCardButton}" Click="BtnMode_Click" Tag="Eco" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="LedEco" Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource Vermilion}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8AB;" Style="{StaticResource CardIcon}" />
                                                            <TextBlock Text="Eco" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border x:Name="IndEco" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource Vermilion}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtIndEco" Text="AKTİF" Foreground="{DynamicResource Vermilion}" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="En düşük tüketim" Style="{StaticResource SectionHint}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="TxtModeLockNote" Visibility="Collapsed" Foreground="{DynamicResource AccentRed}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />


                                <!-- FAN: readouts on the left, the choice on the right. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource CardIcon}" Foreground="{DynamicResource AccentCyan}" />
                                                <TextBlock Text="Fan Kontrolü" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <!-- One frame around the four options: they are one choice, not four buttons. -->
                                            <Border Style="{StaticResource SegmentedGroup}" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnFanAuto" Style="{StaticResource SegmentedItem}" Content="Otomatik" Click="BtnFanAuto_Click" />
                                                    <Button x:Name="BtnFanMax" Style="{StaticResource SegmentedItem}" Content="Maksimum" Click="BtnFanMax_Click" />
                                                    <Button x:Name="BtnFanCustom" Style="{StaticResource SegmentedItem}" Content="Özel" Click="BtnFanCustom_Click" ToolTip="CPU ve GPU fanını sabit bir hızda (%30–100) çalıştırır." />
                                                    <Button x:Name="BtnFanCurve" Style="{StaticResource SegmentedItem}" Content="Eğri" Click="BtnFanCurve_Click" ToolTip="Fan hızını CPU sıcaklığına göre kendisi ayarlar." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the section is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,7">
                                                    <TextBlock x:Name="TxtCpuFanRpm" Text="3089 RPM" Style="{StaticResource Figure}" FontSize="20" FontWeight="SemiBold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarCpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Value="50" Maximum="6000" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="GPU" Style="{StaticResource LabelCaps}" />
                                                <!-- Shrinks instead of clipping "2364 RPM (%39)" when the section is narrow -->
                                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,7">
                                                    <TextBlock x:Name="TxtGpuFanRpm" Text="3075 RPM" Style="{StaticResource Figure}" FontSize="20" FontWeight="SemiBold" />
                                                </Viewbox>
                                                <ProgressBar x:Name="BarGpuFan" ToolTip="Çubuk yaklaşık olarak 6000 RPM tavana göre çizilir; Acer gerçek azami devri bildirmiyor." Value="50" Maximum="6000" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- CUSTOM FAN SPEEDS (shown in "Özel" mode) -->
                                        <Grid x:Name="PnlCustomFan" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="CPU" Style="{StaticResource LabelCaps}" Margin="0,0,10,0" />
                                            <Slider x:Name="SliderFanCpu" Grid.Column="1" Minimum="30" Maximum="100" Value="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderCustomFan_ValueChanged" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtFanCpuPercent" Grid.Column="2" Text="%50" Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="GPU" Style="{StaticResource LabelCaps}" Margin="0,8,10,0" />
                                            <Slider x:Name="SliderFanGpu" Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" Value="50" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderCustomFan_ValueChanged" VerticalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock x:Name="TxtFanGpuPercent" Grid.Row="1" Grid.Column="2" Text="%50" Style="{StaticResource Figure}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Sabit hız: fan yüke göre hızlanmaz." Style="{StaticResource SectionHint}" ToolTip="Ağır yükte sıcaklığı izleyin; ısınırsa Otomatik'e dönün." Margin="0,8,0,0" />
                                        </Grid>

                                        <!-- SOFTWARE FAN CURVE (shown in "Eğri" mode) -->
                                        <StackPanel x:Name="PnlFanCurve" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Border Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,12" />
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="FAN EĞRİSİ" Style="{StaticResource LabelCaps}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Eğri CPU sıcaklığını izler: sıcaklık yükselince fan hemen hızlanır, düşünce histerezis kadar bekleyip yavaşlar. 85 °C ve üstünde fan hiçbir zaman %60'ın altına inmez. Oyun oturumu sırasında oyun profilinin fan ayarı geçerlidir." />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtFanCurveStatus" Text="--" HorizontalAlignment="Right" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" />
                                            </Grid>
                                            <!-- Templates: one click fills the six anchors below. A preset is a shortcut, not a
                                                 mode, so moving a slider afterwards simply leaves it and the mark clears. -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ŞABLON" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel x:Name="PnlCurvePresets" Grid.Column="1" Orientation="Horizontal">
                                                    <Button Tag="balanced" Style="{StaticResource SegButton}" Click="BtnCurvePreset_Click" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,3" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" Cursor="Hand" />
                                                    <Button Tag="quiet" Style="{StaticResource SegButton}" Click="BtnCurvePreset_Click" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,3" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold" Cursor="Hand" />
                                                    <Button Tag="gaming" Style="{StaticResource SegButton}" Click="BtnCurvePreset_Click" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,3" FontSize="10" FontWeight="SemiBold" Cursor="Hand" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- The trace: temperature across, fan speed up. Drawn in code so it always matches the sliders. -->
                                            <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,8,0,0" Background="{DynamicResource PaperDeep}">
                                                <Grid Height="92">
                                                    <Canvas x:Name="CanvasFanCurveGrid" ClipToBounds="True" />
                                                    <Canvas x:Name="CanvasFanCurve" ClipToBounds="True" SizeChanged="CanvasFanCurve_SizeChanged">
                                                        <Polyline x:Name="FanCurveLine" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        <Rectangle x:Name="FanCurveMarker" Width="5" Height="5" Fill="{DynamicResource Vermilion}" Visibility="Collapsed" />
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="40°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve0" Grid.Column="1" Minimum="30" Maximum="100" Value="30" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve0" Grid.Column="2" Text="%30" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="50°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve1" Grid.Column="1" Minimum="30" Maximum="100" Value="32" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve1" Grid.Column="2" Text="%32" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="60°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve2" Grid.Column="1" Minimum="30" Maximum="100" Value="36" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve2" Grid.Column="2" Text="%36" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="70°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve3" Grid.Column="1" Minimum="30" Maximum="100" Value="42" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve3" Grid.Column="2" Text="%42" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid Grid.Row="2" Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="80°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve4" Grid.Column="1" Minimum="30" Maximum="100" Value="62" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve4" Grid.Column="2" Text="%62" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Row="2" Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="90°" Style="{StaticResource Figure}" FontSize="11" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                    <Slider x:Name="SliderCurve5" Grid.Column="1" Minimum="60" Maximum="100" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCurve5" Grid.Column="2" Text="%100" Style="{StaticResource Figure}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <!-- FAN STALL WATCHDOG: a fan that stops turning while the die is hot is a hardware
                                             fault, not a tuning choice, so the guard is offered in every fan mode. -->
                                        <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkFanStallProtection" Grid.Row="4" Margin="0,10,0,0"
                                                  Content="Fan arızasında otomatik koruma (Eco moduna geç)"
                                                  Checked="ChkFanStallProtection_Changed" Unchecked="ChkFanStallProtection_Changed"
                                                  Foreground="{DynamicResource InkSoft}" FontSize="11"
                                                  ToolTip="Bir fan 88 °C üzerinde 10 saniye boyunca 400 RPM altında kalırsa uyarır ve makineyi Eco moduna alır." />
                                    </Grid>
                                </Border>

                                <!-- GPU & CPU: one card, two rows. The boost behaviour on top, the MUX
                                     switch below, separated by a hairline instead of a second box. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE9D2;" Style="{StaticResource CardIcon}" Foreground="{DynamicResource AccentCyan}" />
                                            <TextBlock Text="GPU &amp; CPU" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>

                                        <!-- CPU BOOST -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="CPU BOOST" Style="{StaticResource LabelCaps}" />
                                                <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                ToolTip="Windows güç planındaki işlemci saat frekansı davranışı. Agresif en yüksek frekansa çıkar, Verimli boost'u açık tutar, Devre Dışı taban frekansta kalır." />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnBoostAggressive" Style="{StaticResource SegButton}" Content="Agresif" Click="BtnBoost_Click" Tag="Aggressive" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" ToolTip="Windows boost değeri 2: işlemci yükte mümkün olan en yüksek frekansa çıkar" />
                                                <Button x:Name="BtnBoostEfficient" Style="{StaticResource SegButton}" Content="Verimli" Click="BtnBoost_Click" Tag="Efficient" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14,5" Margin="0,0,6,0" FontSize="11" ToolTip="Windows boost değeri 4 (Efficient Aggressive): boost açık, verimlilik öncelikli; frekans sabit bir değerle sınırlanmaz" />
                                                <Button x:Name="BtnBoostDisabled" Style="{StaticResource SegButton}" Content="Devre Dışı" Click="BtnBoost_Click" Tag="Disabled" Background="Transparent" Foreground="{DynamicResource InkSoft}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14,5" FontSize="11" ToolTip="Windows boost değeri 0: işlemci taban frekansının üzerine çıkmaz" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,10,0,10" />

                                        <!-- MUX SWITCH -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="MUX Switch" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Ekran kartı bağlantı modunu seçer ve uygular. Değişiklik yeniden başlatmadan sonra geçerli olur." />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtGpuModeNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource InkSoft}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Items are filled only from the modes AASSvc reports as supported (SUPPORT_GPU_MODE_CAPABILITY). -->
                                                <ComboBox x:Name="CmbGpuMode" MinWidth="230" MaxWidth="340" Margin="0,0,8,0" IsEnabled="False" />
                                                <Button x:Name="BtnApplyGpuMode" IsEnabled="False" Content="Modu Uygula" Click="BtnApplyGpuMode_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçilen GPU modunu uygular." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ENHANCED PER-GAME PROFILE & AUTO DETECTION -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Header & Active Game Live Badge -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Oyun Profilleri" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold" />
                                                    <Border x:Name="BadgeGameStatus" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                                                        <!-- The badge carries a live game name, and a long one ("Tom Clancy's
                                                             Rainbow Six Siege") used to run under the checkbox on the right:
                                                             a horizontal StackPanel hands its children infinite width, so
                                                             the text could neither wrap nor trim. MaxWidth bounds it and
                                                             the tooltip, bound to the text itself, keeps the full string
                                                             readable without a second place to update. -->
                                                        <TextBlock x:Name="TxtGameStatus" Text="Durum: Beklemede (Aktif oyun yok)" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Auto Mode Global Switch -->
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkAutoGameMode" Content="Otomatik oyun algılamayı etkinleştir" IsChecked="True" Checked="ChkAutoGameMode_Changed" Unchecked="ChkAutoGameMode_Changed" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Kapatılırsa hiçbir oyun algılanmaz ve hiçbir profil kendiliğinden uygulanmaz." />
                                        </Grid>

                                        <!-- Desktop / Default Mouse Profile Card -->
                                        <Border x:Name="CardDefaultMouseProfile" Visibility="Collapsed" Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Varsayılan Fare Profili" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                                        <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                        ToolTip="Oyunlar kapandığında veya masaüstü kullanımında farenin otomatik döneceği varsayılan donanım profili." />
                                                        <!-- Only speaks when there is something to say: a pending apply, a rejection, a
                                                             failure reason. The combo box already shows which profile is chosen, so a
                                                             permanent "Config 1 (Aktif)" beside the title only repeated it. -->
                                                        <Border x:Name="BadgeDefaultMouseProfile" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0" Visibility="Collapsed">
                                                            <TextBlock x:Name="TxtDefaultMouseProfileStatus" Text="" Foreground="{DynamicResource AccentGreen}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="CmbDefaultAtkMouseProfile" MinWidth="180" MaxWidth="320" Margin="0,0,8,0" SelectionChanged="CmbDefaultAtkMouseProfile_SelectionChanged">
                                                        <ComboBoxItem Content="Config 1 (Önerilen)" Tag="1" />
                                                        <ComboBoxItem Content="Config 2" Tag="2" />
                                                        <ComboBoxItem Content="Config 3" Tag="3" />
                                                        <ComboBoxItem Content="Config 4" Tag="4" />
                                                        <ComboBoxItem Content="Son Kullanılanı Koru" Tag="0" />
                                                    </ComboBox>
                                                    <Button x:Name="BtnApplyDefaultMouseProfile" Content="Uygula" Click="BtnApplyDefaultMouseProfile_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili varsayılan profili fare donanımına anında uygular ve kaydeder." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Game Selection, Auto Scan, Add Custom Game, Delete -->
                                        <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="320" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Select Game Dropdown -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Yapılandırılacak Oyun:" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="CmbConfiguredGames" SelectionChanged="CmbConfiguredGames_SelectionChanged" />
                                                </StackPanel>

                                                <!-- Action Buttons: Scan, Add, Delete -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Button x:Name="BtnScanGames" Content="Yüklü Oyunları Tara" Click="BtnScanGames_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Steam ve Epic Games kütüphanelerindeki oyunları listeye ekler." />
                                                    <Button x:Name="BtnAddCustomGame" Content="Oyun Ekle (.exe)" Click="BtnAddCustomGame_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Çalıştırılabilir dosya seçerek özel profil tanımlar." />
                                                    <Button x:Name="BtnDeleteGame" Content="Profili Sil" Click="BtnDeleteGame_Click" Background="Transparent" Foreground="{DynamicResource AccentRed}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" ToolTip="Seçili oyun profilini kayıtlı yapılandırmadan siler." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: Per-Game Detailed Configuration Grid -->
                                        <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Seçili Oyun Yapılandırması:" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock x:Name="TxtSelectedGameNameBadge" Text=" [Counter-Strike 2]" Foreground="{DynamicResource AccentCyan}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtSelectedGameExePath" Text="cs2.exe" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                </Grid>

                                                <UniformGrid x:Name="GridGameSettingsRow" Columns="3" Margin="0,0,0,12">
                                                    <!-- Target Operating Mode -->
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Çalışma Modu:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetMode">
                                                            <ComboBoxItem Content="Turbo (Yüksek Güç Sınırı)" IsSelected="True" Tag="Turbo" />
                                                            <ComboBoxItem Content="Performans" Tag="Extreme" />
                                                            <ComboBoxItem Content="Dengeli (Varsayılan)" Tag="Default" />
                                                            <ComboBoxItem Content="Sessiz (Düşük Güç)" Tag="Quiet" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target CPU Boost Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="CPU Boost Davranışı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetCpuBoost">
                                                            <ComboBoxItem Content="Devre Dışı (taban frekans)" IsSelected="True" Tag="Disabled" />
                                                            <ComboBoxItem Content="Verimli" Tag="Efficient" />
                                                            <ComboBoxItem Content="Agresif" Tag="Aggressive" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Target Fan Mode -->
                                                    <StackPanel Margin="3,0,3,0">
                                                        <TextBlock Text="Fan Profili:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="CmbGameTargetFan">
                                                            <ComboBoxItem Content="Otomatik Fan Eğrisi" IsSelected="True" Tag="Auto" />
                                                            <ComboBoxItem Content="Maksimum Devir (Sabit)" Tag="Max" />
                                                            <ComboBoxItem Content="Özel Hız (fan kartındaki ayar)" Tag="Custom" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- ATK Mouse Profile -->
                                                    <StackPanel x:Name="PnlGameAtkMouseProfile" Visibility="Collapsed" Margin="6,0,0,0">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="ATK Fare Profili:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                            <Button x:Name="BtnTestMouseProfile" Content="Dene" Click="BtnTestMouseProfile_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="6,1" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="Seçili fare profilini donanım üzerinde anında test eder." />
                                                        </Grid>
                                                        <ComboBox x:Name="CmbGameAtkMouseProfile">
                                                            <ComboBoxItem Content="Değiştirme (Pasif)" IsSelected="True" Tag="0" />
                                                            <ComboBoxItem Content="Config 1 (Profil 1)" Tag="1" />
                                                            <ComboBoxItem Content="Config 2 (Profil 2)" Tag="2" />
                                                            <ComboBoxItem Content="Config 3 (Profil 3)" Tag="3" />
                                                            <ComboBoxItem Content="Config 4 (Profil 4)" Tag="4" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </UniformGrid>

                                                <!-- Per-game fan curve: this profile can run its own shape instead of a fixed speed -->
                                                <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkGameFanCurve" Content="Bu oyun için fan eğrisi kullan" Checked="ChkGameFanCurve_Changed" Unchecked="ChkGameFanCurve_Changed" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="Sabit bir fan hızı yerine sıcaklığa göre değişen bir eğri uygular. Kapalıyken yukarıdaki fan profili geçerlidir." />
                                                        <StackPanel x:Name="PnlGameFanCurve" Visibility="Collapsed" Margin="0,8,0,0">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="OYUN FAN EĞRİSİ" Style="{StaticResource LabelCaps}" VerticalAlignment="Center" />
                                                                <Button x:Name="BtnGameCurveCopyDesktop" Content="Masaüstü eğrisini kopyala" Click="BtnGameCurveCopyDesktop_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="8,2" FontSize="10" FontWeight="SemiBold" Cursor="Hand" ToolTip="Fan kartındaki eğriyi bu oyunun profiline kopyalar." />
                                                            </Grid>
                                                            <UniformGrid Columns="3">
                                                                <Grid Margin="0,0,22,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="40°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve0" Grid.Column="1" Minimum="30" Maximum="100" Value="30" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve0" Grid.Column="2" Text="%30" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="50°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve1" Grid.Column="1" Minimum="30" Maximum="100" Value="32" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve1" Grid.Column="2" Text="%32" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="60°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve2" Grid.Column="1" Minimum="30" Maximum="100" Value="36" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve2" Grid.Column="2" Text="%36" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="70°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve3" Grid.Column="1" Minimum="30" Maximum="100" Value="42" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve3" Grid.Column="2" Text="%42" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,22,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="80°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve4" Grid.Column="1" Minimum="30" Maximum="100" Value="62" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve4" Grid.Column="2" Text="%62" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="38" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="90°" Style="{StaticResource Figure}" FontSize="10" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                                                    <Slider x:Name="SliderGameCurve5" Grid.Column="1" Minimum="60" Maximum="100" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderGameFanCurve_ValueChanged" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="TxtGameCurve5" Grid.Column="2" Text="%100" Style="{StaticResource Figure}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Save Profile Action Button & Description -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkGameAutoApply" Grid.Column="0" Content="Bu oyun açılınca profili uygula" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Cursor="Hand" ToolTip="Yalnızca bu oyun için geçerli. Kapalıysa oyun algılanır ama bu profili kendiliğinden uygulamaz; elle çalıştırılabilir." />
                                                    <TextBlock Grid.Column="1" Text="Açılışta uygulanır, kapanışta geri alınır" Style="{StaticResource SectionHint}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <Button x:Name="BtnSaveGameProfile" Grid.Column="2" Content="Yapılandırmayı Kaydet" Click="BtnSaveGameProfile_Click" Background="{DynamicResource AccentCyan}" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" Padding="14,8" HorizontalAlignment="Right" Cursor="Hand" FontSize="11" BorderThickness="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: LIVE MONITORING & OSD -->
                    <Grid x:Name="TabMonitoring" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Donanım Telemetrisi ve OSD Göstergesi" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- OSD Overlay Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleOsd" Content="Ekran Üstü Gösterge (OSD)" Click="BtnToggleOsd_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="Oyun esnasında donanım kullanım verilerini ekranda gösterir." />
                                        <Button x:Name="BtnCycleOsdCorner" Content="Konum Değiştir" Click="BtnCycleOsdCorner_Click" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="OSD katmanını ekran köşeleri arasında taşır." />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <!-- CPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <!-- The CPU name is a full marketing string ("AMD Ryzen 7 7840HS w/ Radeon 780M
                                                 Graphics") and the core count follows it. In a horizontal StackPanel
                                                 neither is constrained, so the pair ran past the card edge; the star
                                                 column wraps the name at a word boundary and keeps the count whole. -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="TxtMonCpuName" Text="İşlemci" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" x:Name="TxtCpuCoreCount" Text=" (16 Çekirdek)" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Top" />
                                            </Grid>
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuTemp" Text="-- °C" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuTemp" Height="4" Maximum="100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Paket Güç Tüketimi:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuPower" Text="-- W" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuPower" Height="4" Maximum="80" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="İşlemci Kullanımı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuUsage" Text="-- %" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuUsage" Height="4" Maximum="100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Clock in GHz -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Saat Frekansı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonCpuFreqGhz" Text="-- GHz" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonCpuFreq" Height="4" Maximum="5100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtMonGpuName" Text="Ekran Kartı" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            
                                            <!-- Temp -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Sıcaklık:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuTemp" Text="-- °C" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuTemp" Height="4" Maximum="100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />
                                            
                                            <!-- TGP Wattage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="TGP Güç Tüketimi:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuPower" Text="-- W" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuPower" Height="4" Maximum="140" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- Usage -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="GPU Kullanımı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonGpuUsage" Text="-- %" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonGpuUsage" Height="4" Maximum="100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,0,0,6" />

                                            <!-- VRAM -->
                                            <Grid Margin="0,3">
                                                <TextBlock Text="VRAM Kullanımı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="TxtMonVram" Text="-- GB / 8.0 GB" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="BarMonVram" Height="4" Maximum="8192" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- RAM & SYSTEM TEMP CARD WITH RAM CACHE CLEANER -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="Sistem Belleği (RAM)" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold" />
                                                <Grid Margin="0,6">
                                                    <TextBlock x:Name="TxtMonRamDetail" Text="-- GB / -- GB" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtMonRamPercent" Text="-- %" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar x:Name="BarMonRam" Height="5" Maximum="100" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" />
                                                <TextBlock x:Name="TxtMonRamInfo" Text="--" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Sistem Sıcaklığı" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Sensörün konumu Acer tarafından belirtilmiyor." />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtMonSysTemp" Text="-- °C" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- RAM CACHE / STANDBY LIST CLEANER BAR -->
                                        <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Bekleme Belleğini Boşaltma" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                        <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                        ToolTip="Windows'un önbellekte tuttuğu bekleme listesini boşaltır. Çalışan programların belleğine dokunmaz; boş bellek azaldığında oluşan takılmalara karşı işe yarar." />
                                                        <TextBlock x:Name="TxtRamCleanStatus" Text=" (Hazır)" Foreground="{DynamicResource AccentGreen}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <Button x:Name="BtnGetMemoryCleaner" Content="WinMemoryCleaner'ı indir (ücretsiz, GPL-3.0)" Click="BtnGetMemoryCleaner_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource Link}" FontSize="10" Cursor="Hand" ToolTip="WinMemoryCleaner, NitroLite paketiyle birlikte gelir. Yalnızca dosya eksikse bu buton resmi GitHub indirme sayfasını açar." />
                                                </StackPanel>

                                                <Button x:Name="BtnCleanRamCache" Grid.Column="1" Content="Bekleme Belleğini Boşalt" Click="BtnCleanRamCache_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" FontWeight="SemiBold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" ToolTip="WinMemoryCleaner ile Windows bekleme listesini boşaltır. Yönetici izni ister. Çalışan programların belleğini diske itmez." />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- REAL-TIME TELEMETRY HISTORY GRAPH CARD -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Telemetri Geçmiş Grafiği" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Ölçüm olmayan anlar (ör. ekran kartı uykudayken) grafiğe ve değerlere dahil edilmez." />
                                                </StackPanel>
                                                <TextBlock Text="Seçili metriğin son 60 saniyesi" Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Metric Selection Dropdown -->
                                            <ComboBox Grid.Column="1" x:Name="CmbChartMetric" MinWidth="240" MaxWidth="340" SelectionChanged="CmbChartMetric_SelectionChanged" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBoxItem Content="CPU Sıcaklığı (°C)" Tag="CPU_TEMP" IsSelected="True" />
                                                <ComboBoxItem Content="GPU Sıcaklığı (°C)" Tag="GPU_TEMP" />
                                                <ComboBoxItem Content="CPU Güç Tüketimi (W, tahmini)" Tag="CPU_WATT" />
                                                <ComboBoxItem Content="GPU Güç Tüketimi (W)" Tag="GPU_WATT" />
                                                <ComboBoxItem Content="CPU Saat Frekansı (GHz)" Tag="CPU_GHZ" />
                                                <ComboBoxItem Content="CPU Kullanımı (%)" Tag="CPU_USAGE" />
                                                <ComboBoxItem Content="GPU Kullanımı (%)" Tag="GPU_USAGE" />
                                                <ComboBoxItem Content="RAM Kullanımı (%)" Tag="RAM_USAGE" />
                                                <ComboBoxItem Content="VRAM Kullanımı (GB)" Tag="VRAM_GB" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- The Graph Canvas. The pen is ink; only the leading dot is the live
                                             signal. The scale sits in its own gutter so the trace never runs
                                             through a label. -->
                                        <Border Background="{DynamicResource PaperDeep}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="2" Height="200" ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,36,0,0" />
                                                    <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,100,0,0" />
                                                    <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,164,0,0" />

                                                    <Canvas x:Name="CanvasHistoryChart" ClipToBounds="True">
                                                        <Polygon x:Name="ChartArea" Fill="{DynamicResource ChartFill}" StrokeThickness="0" />
                                                        <Polyline x:Name="ChartLine" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        <Ellipse x:Name="ChartDot" Width="7" Height="7" Fill="{DynamicResource Live}" Stroke="{DynamicResource PaperDeep}" StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Grid>

                                                <Border Grid.Column="1" BorderBrush="{DynamicResource Rule}" BorderThickness="1,0,0,0">
                                                    <Grid>
                                                        <TextBlock x:Name="TxtChartGridTop" Text="--" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,20,0,0" />
                                                        <TextBlock x:Name="TxtChartGridMid" Text="--" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,84,0,0" />
                                                        <TextBlock x:Name="TxtChartGridBottom" Text="--" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,148,0,0" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Live statistics as one readout strip, not four cards: a rule, then
                                             label/value pairs. The current reading is the only coloured one. -->
                                        <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                            <UniformGrid Columns="4">
                                                <StackPanel>
                                                    <TextBlock Text="Mevcut" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartCurrentVal" Text="-- °C" Style="{StaticResource Figure}" Foreground="{DynamicResource Vermilion}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Minimum (60 sn)" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMinVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Maksimum (60 sn)" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartMaxVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Ortalama (60 sn)" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtChartAvgVal" Text="-- °C" Style="{StaticResource Figure}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: KEYBOARD RGB -->
                    <Grid x:Name="TabRgb" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Klavye RGB Aydınlatma Kontrolü" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnTurnOffLights" Content="Aydınlatmayı Kapat" Click="BtnTurnOffLights_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" />
                                </Grid>

                                <!-- Shown only when the Acer service explicitly reports no controllable lighting. -->
                                <Border x:Name="BannerLightingUnsupported" Visibility="Collapsed" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                    <TextBlock x:Name="TxtLightingUnsupported" TextWrapping="Wrap" Foreground="{DynamicResource AccentRed}" FontSize="11" />
                                </Border>

                                <!-- 4 Zones Visual Preview -->
                                <Border x:Name="CardZonePreview" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Dört Bölgeli Aydınlatma Düzeni" Style="{StaticResource RowTitle}" />
                                        </StackPanel>
                                        <!-- The deck: the four zones sit on a darker ground with thin key rows
                                             beneath them, so the block reads as a keyboard rather than four
                                             swatches. The rows are decoration and never take a click. -->
                                        <Border Background="{DynamicResource PaperDeep}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="10,10,10,8">
                                            <StackPanel>
                                                <UniformGrid Columns="4">
                                                    <StackPanel Margin="0,0,6,0">
                                                        <Border x:Name="PreviewZone1" Tag="0" Style="{StaticResource ZonePreview}" MouseLeftButtonUp="PreviewZone_Click" ToolTip="Bölge rengini değiştirmek için tıklayın" Background="{DynamicResource AccentCyan}" />
                                                        <TextBlock Text="Bölge 1 (Sol)" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <Border x:Name="PreviewZone2" Tag="1" Style="{StaticResource ZonePreview}" MouseLeftButtonUp="PreviewZone_Click" ToolTip="Bölge rengini değiştirmek için tıklayın" Background="{DynamicResource AccentCyan}" />
                                                        <TextBlock Text="Bölge 2 (Orta Sol)" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <Border x:Name="PreviewZone3" Tag="2" Style="{StaticResource ZonePreview}" MouseLeftButtonUp="PreviewZone_Click" ToolTip="Bölge rengini değiştirmek için tıklayın" Background="{DynamicResource AccentCyan}" />
                                                        <TextBlock Text="Bölge 3 (Orta Sağ)" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <Border x:Name="PreviewZone4" Tag="3" Style="{StaticResource ZonePreview}" MouseLeftButtonUp="PreviewZone_Click" ToolTip="Bölge rengini değiştirmek için tıklayın" Background="{DynamicResource AccentCyan}" />
                                                        <TextBlock Text="Bölge 4 (Sayısal)" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <StackPanel IsHitTestVisible="False" Margin="0,10,0,0">
                                                    <UniformGrid Columns="12" Height="4" Margin="0,0,0,4">
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                    </UniformGrid>
                                                    <UniformGrid Columns="12" Height="4" Margin="0,0,0,4">
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                            <Border Background="{DynamicResource Rule}" CornerRadius="1" Margin="0,0,4,0" />
                                                    </UniformGrid>
                                                    <Border Height="4" Background="{DynamicResource Rule}" CornerRadius="1" Margin="46,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtZonePreviewNote" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="3,8,3,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TxtKeyboardCapabilityNote" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <!-- MODULE 4: RGB PRESET MANAGER CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Aydınlatma Profilleri" Style="{StaticResource RowTitle}" />
                                            </StackPanel>
                                        </Grid>
                                        
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="320" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Preset Dropdown. The list is left unselected when the keyboard is in a
                                                 state no preset describes, which used to read as an empty, broken
                                                 control; the hint is a sibling shown only while nothing is selected. -->
                                            <Grid Grid.Column="0">
                                                <ComboBox x:Name="CmbRgbPresets" SelectionChanged="CmbRgbPresets_SelectionChanged" VerticalAlignment="Center" />
                                                <TextBlock Text="Profil seçilmedi" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CmbRgbPresets}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Save Custom Preset input. The hint is a sibling, not a watermark, so it
                                                 can never end up inside a saved profile name. -->
                                            <Grid Grid.Column="1" Margin="10,0">
                                                <TextBox x:Name="TxtCustomPresetName" Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="10,7" FontSize="11" VerticalAlignment="Center" ToolTip="Yeni profil adı" FocusVisualStyle="{StaticResource FocusRing}" />
                                                <TextBlock Text="Yeni profil adı" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtCustomPresetName}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnSaveCustomPreset" Content="Profili Kaydet" Click="BtnSaveCustomPreset_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Margin="0,0,6,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                                <Button x:Name="BtnDeleteCustomPreset" Content="Profili Sil" Click="BtnDeleteCustomPreset_Click" Background="Transparent" Foreground="{DynamicResource AccentRed}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontWeight="SemiBold" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Color Presets & Turn Off Controls. Its own card, not a bare row between two
                                     cards: the swatches are a control group with a title, and a block that floats
                                     on the page ground reads as an accident. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE765;" Style="{StaticResource CardIcon}" Foreground="{DynamicResource AccentCyan}" />
                                            <TextBlock Text="Hızlı Renk Seçimi" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="BtnPresetColor_Click" Tag="#00E5FF" Background="#00E5FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Camgöbeği (Cyan)" />
                                            <Button Click="BtnPresetColor_Click" Tag="#FF2A55" Background="#FF2A55" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kırmızı" />
                                            <Button Click="BtnPresetColor_Click" Tag="#00FFA3" Background="#00FFA3" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Yeşil" />
                                            <Button Click="BtnPresetColor_Click" Tag="#BD00FF" Background="#BD00FF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Mor" />
                                            <Button Click="BtnPresetColor_Click" Tag="#FFAA00" Background="#FFAA00" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Turuncu" />
                                            <Button Click="BtnPresetColor_Click" Tag="#FFFFFF" Background="#FFFFFF" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Beyaz" />
                                            <Button Click="BtnPresetColor_Click" Tag="#000000" Background="#000000" Width="36" Height="36" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Cursor="Hand" ToolTip="Kapalı" />
                                            <Button x:Name="BtnCustomColor" Content="Özel Renk…" Click="BtnCustomColor_Click" Height="36" Padding="12,0" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold" ToolTip="Herhangi bir renk seçin (tüm bölgeler)" />
                                            <!-- Spreads the colour the user last chose over all four zones, which is the
                                                 one thing the per-zone picker cannot do in a single click. -->
                                            <Button x:Name="BtnApplyAllZones" Content="Tüm Bölgelere Uygula" Click="BtnApplyAllZones_Click" Height="36" Padding="12,0" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Cursor="Hand" FontSize="11" FontWeight="SemiBold" ToolTip="Seçili rengi dört bölgeye birden uygular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Controls: Effect, Brightness, Speed, Timeout -->
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Aydınlatma Efekti:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbRgbEffect" SelectionChanged="CmbRgbEffect_SelectionChanged" Margin="0,0,0,12" MaxWidth="360" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="STATIC (Sabit Renk)" IsSelected="True" />
                                                <ComboBoxItem Content="WAVE (Dalga)" />
                                                <ComboBoxItem Content="BREATHING (Nefes)" />
                                                <ComboBoxItem Content="NEON (Neon Geçiş)" />
                                                <ComboBoxItem Content="SHIFTING (Renk Kayması)" />
                                                <ComboBoxItem Content="ZOOM (Büyüme)" />
                                                <ComboBoxItem Content="METEOR (Kayan Işık)" />
                                                <ComboBoxItem Content="TWINKLING (Yıldız Parıltısı)" />
                                                <ComboBoxItem Content="OFF (Işık Kapalı)" />
                                            </ComboBox>
                                            <TextBlock x:Name="TxtRgbEffectNote" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,-6,0,10" />

                                            <StackPanel x:Name="PnlRgbDirection" Visibility="Collapsed" Margin="0,0,0,10">
                                                <TextBlock Text="Efekt Yönü:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                                <ComboBox x:Name="CmbRgbDirection" SelectionChanged="CmbRgbDirection_SelectionChanged" MaxWidth="360" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkBacklightTimeout" Content="30 saniye boşta kaldığında aydınlatmayı kapat" Checked="ChkBacklightTimeout_Changed" Unchecked="ChkBacklightTimeout_Changed" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Parlaklık:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBrightnessVal" Text="5 / 9" Foreground="{DynamicResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderBrightness" Minimum="0" Maximum="9" Value="5" ValueChanged="SliderBrightness_ValueChanged" Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Efekt Hızı:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtSpeedVal" Text="3 / 9" Foreground="{DynamicResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="SliderSpeed" Minimum="1" Maximum="9" Value="3" ValueChanged="SliderSpeed_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 4: BATTERY HEALTH & SAFE DISCHARGE -->
                    <Grid x:Name="TabBattery" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Pil Şarj Sınırı ve Sağlığı" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <!-- BATTERY STATUS CARD -->
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Şarj Durumu" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <TextBlock x:Name="TxtBatLevelBig" Text="--%" Foreground="{DynamicResource AccentGreen}" FontSize="32" FontWeight="Bold" />
                                                <TextBlock x:Name="TxtBatStateDesc" Text="Adaptöre Bağlı" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>

                                            <ProgressBar x:Name="BarBatBig" Height="6" Maximum="100" Value="80" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="0,6,0,12" />

                                            <!-- Live Real-Time Discharge / Charge Rate Indicator -->
                                            <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,0,10">
                                                <!-- Two columns, not one cell with a right-aligned sibling: a translated
                                                     "remaining time" is longer than the Turkish one and used to run under
                                                     the card's edge. The star column keeps the figure clear of it. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Anlık Güç Akışı:" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                        <TextBlock x:Name="TxtBatDischargeRate" Text="0.0 W (Adaptörde)" Foreground="{DynamicResource AccentCyan}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" x:Name="TxtBatRemainingTime" Text="Kalan Süre: --" Foreground="{DynamicResource TextSecondary}" FontSize="11" MaxWidth="200" Margin="12,0,0,0" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkWatchdog" Content="%80 şarj koruma sınırını uygula" Checked="ChkWatchdog_Changed" Unchecked="ChkWatchdog_Changed" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,4" />
                                            <TextBlock x:Name="TxtChargeLimitNote" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <!-- Only shown when the agent's certificate changed under us: the pin is
                                                 what refuses the connection, so the pin is what has to be dropped. -->
                                            <Button x:Name="BtnRetrustCareCenter" Content="Yeni sertifikaya güven" Click="BtnRetrustCareCenter_Click" Visibility="Collapsed" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,4" Cursor="Hand" FontSize="11" Margin="0,6,0,0" />

                                            <Separator Background="{DynamicResource BorderDark}" Margin="0,8,0,8" />
                                            <TextBlock Text="Pilde Çalışma Güç Profili (DC Modu):" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="CmbDcPowerMode" SelectionChanged="CmbDcPowerMode_SelectionChanged" Background="{DynamicResource RailBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" FontSize="11" Margin="0,0,0,6">
                                                <!-- The 60 Hz part is not in this label: it is the checkbox below, and it can be
                                                     switched off. A label that promised 60 Hz while the checkbox was off was
                                                     the reason Eco looked broken on battery. -->
                                                <ComboBoxItem Content="Eco Modu (Sessiz Fan + Güç Tasarrufu)" Tag="Eco" IsSelected="True" />
                                                <ComboBoxItem Content="Dengeli Mod (Mevcut Ayarları Koru)" Tag="Balanced" />
                                            </ComboBox>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkAutoRefreshRate" Checked="ChkAutoRefreshRate_Changed" Unchecked="ChkAutoRefreshRate_Changed" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,2">
                                                <!-- A CheckBox renders a string Content on one unbroken line; the German
                                                     sentence is twice the Turkish one and was clipped mid-word. -->
                                                <TextBlock Text="Eco modunda ekranı 60 Hz'e al" TextWrapping="Wrap" ToolTip="Adaptörde önceki hıza döner; harici monitörlere dokunmaz." />
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- SCHOOL MODE CARD. The forced-discharge card that used to sit above this one is
                                         gone: it burned CPU on battery to reach the 80 % limit, which normal use
                                         already does in about fifteen minutes, and the heat it added is the thing
                                         that actually ages a lithium cell. -->
                                    <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="Okul Modu" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Pilde en tasarruflu ayarlar: Eco mod, CPU boost kapalı, işlemci %60, pasif soğutma, pil tasarrufu açık, ekran 3 dk / uyku 10 dk, 60 Hz, %40 parlaklık, klavye ışığı kapalı. Kapatınca hepsi geri döner." />
                                                </StackPanel>
                                                <!-- "Etkin" reads as a state, so it is correct both checked and
                                                     unchecked; "Açık" read as an instruction and was wrong once
                                                     the box was on. -->
                                                <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkSchoolMode" Grid.Column="1" Checked="ChkSchoolMode_Changed" Unchecked="ChkSchoolMode_Changed" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Content="Etkin" />
                                            </Grid>
                                            <TextBlock x:Name="TxtSchoolModeStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- MODULE 3: BATTERY HEALTH & WEAR REPORT CARD -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Batarya Kapasite ve Aşınma Durumu" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                            </StackPanel>
                                        </Grid>

                                        <UniformGrid Columns="4">
                                            <!-- Health -->
                                            <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil Sağlığı" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatHealthPercent" Text="--" Foreground="{DynamicResource AccentGreen}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatHealthNote" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Wear Level -->
                                            <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Aşınma Seviyesi" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatWearPercent" Text="--" Foreground="{DynamicResource AccentCyan}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatWearNote" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Capacity Comparison -->
                                            <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Tam Şarj Kapasitesi" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatFullChargeCap" Text="--" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,6,0,2" />
                                                    <TextBlock x:Name="TxtBatDesignCap" Text="Fabrika: --" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtBatCycleCount" Text="Döngü: --" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Voltage -->
                                            <Border BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,0,20,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil Gerilimi" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtBatVoltage" Text="--" Foreground="{DynamicResource AccentPurple}" FontSize="18" FontWeight="Bold" Margin="0,4" />
                                                    <TextBlock x:Name="TxtBatChemistry" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- WEAR TREND: one reading a day, drawn as a line on the same paper.
                                             The numbers above say where the pack is now; this says which way it is
                                             going, which is the question a wear percentage alone cannot answer. -->
                                        <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                        <TextBlock Text="Aşınma Trendi" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock x:Name="TxtWearTrendSummary" Text="Henüz ölçüm yok." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock x:Name="TxtWearTrendNote" Text="" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <Button x:Name="BtnClearWearHistory" Grid.Column="1" Content="Geçmişi sil" Click="BtnClearWearHistory_Click" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="10,5" Cursor="Hand" FontSize="10" Visibility="Collapsed" />
                                                </Grid>

                                                <!-- The line is ink on paper, like every other trace in the app. The
                                                     canvas is hidden until there are two readings to join. -->
                                                <Canvas x:Name="CanvasWearTrend" Height="58" Margin="0,10,0,0" ClipToBounds="True" Visibility="Collapsed" SizeChanged="CanvasWearTrend_SizeChanged">
                                                    <Polyline x:Name="WearTrendLine" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                    <Canvas x:Name="WearTrendMarks" />
                                                </Canvas>

                                                <Grid x:Name="GridWearTrendAxis" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="TxtWearTrendFirstDate" Text="" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Left" />
                                                    <TextBlock x:Name="TxtWearTrendLastDate" Text="" Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ALT BİLEŞEN TERMAL TELEMETRİ MATRİSİ (VRM, NVMe SSD'ler, PİL) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Bileşen Sıcaklık Matrisi" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />

                                        <UniformGrid Columns="4">
                                            <!-- Motherboard / VRM -->
                                            <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock Text="Sistem (SYS1)" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubMoboTemp" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                </StackPanel>
                                            </Border>

                                            <!-- NVMe SSD 1 (990 Pro) -->
                                            <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtSubSsd1Label" Text="Disk 1" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubSsd1Temp" Text="" Visibility="Collapsed" Foreground="{DynamicResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                    <!-- Shown when the drive reports no temperature: the column keeps its
                                                         height and still says something true about the drive. -->
                                                    <TextBlock x:Name="TxtSubSsd1Smart" Text="NVMe · S.M.A.R.T. OK" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,3" />
                                                    <TextBlock x:Name="TxtSubSsd1Name" Text="--" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="9" />
                                                </StackPanel>
                                            </Border>

                                            <!-- NVMe SSD 2 (PM9A1) -->
                                            <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtSubSsd2Label" Text="Disk 2" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubSsd2Temp" Text="" Visibility="Collapsed" Foreground="{DynamicResource AccentGreen}" FontSize="15" FontWeight="Bold" Margin="0,3" />
                                                    <TextBlock x:Name="TxtSubSsd2Smart" Text="NVMe · S.M.A.R.T. OK" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,3" />
                                                    <TextBlock x:Name="TxtSubSsd2Name" Text="--" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="9" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Battery Pack: no temperature line. The pack reports no sensor, and an
                                                 empty degree placeholder would read as a broken reading. -->
                                            <Border Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,8,0,0" Margin="0,0,16,0">
                                                <StackPanel>
                                                    <TextBlock Text="Pil" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="TxtSubBatteryName" Text="Pil" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="9" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- STORAGE HEALTH & CAPACITY BARS (NVMe SSD SAĞLIK & DOLULUK) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Depolama Sürücüleri" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtStorageBadge" Text="--" Foreground="{DynamicResource InkSoft}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel x:Name="PanelStorageDrives">
                                            <!-- DRIVE 0: C: -->
                                            <Border x:Name="CardDrive0" Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive0Letter" Text="[C:] " Foreground="{DynamicResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Name" Text="--" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive0Bus" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive0Temp" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive0HealthBadge" Text="--" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive0Detail" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive0Free" Text="--" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive0" Height="5" Maximum="100" Value="25.7" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- DRIVE 1: D: -->
                                            <Border x:Name="CardDrive1" Background="Transparent" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="TxtDrive1Letter" Text="[D:] " Foreground="{DynamicResource AccentCyan}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Name" Text="--" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                                            <TextBlock x:Name="TxtDrive1Bus" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtDrive1Temp" Text="" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" />
                                                            <TextBlock x:Name="TxtDrive1HealthBadge" Text="--" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,2,0,4">
                                                        <TextBlock x:Name="TxtDrive1Detail" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                        <TextBlock x:Name="TxtDrive1Free" Text="--" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar x:Name="BarDrive1" Height="5" Maximum="100" Value="18.1" Background="{DynamicResource Rule}" Foreground="{DynamicResource Ink}" BorderThickness="0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Overcharge Warning Banner (Hidden by default) -->
                                <Border x:Name="BannerOvercharge" Visibility="Collapsed" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="[ ! ]" Foreground="{DynamicResource AccentRed}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="Şarj Eşiği Aşıldı" Foreground="{DynamicResource AccentRed}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock x:Name="TxtOverchargeMsg" Text="Pil seviyesi %80 sınırının üzerindedir. Dilerseniz hedef seviyeye deşarj işlemini başlatabilirsiniz." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: DEBLOAT HUB & SETTINGS -->
                    <Grid x:Name="TabDebloat" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock Text="Sistem Servisleri ve Başlangıç Ayarları" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Arka plan servisleri, onarım araçları ve başlangıç davranışı" Style="{StaticResource SectionHint}" Margin="0,4,0,16" />

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Acer Arka Plan Servisleri" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Kullanılmayan Acer arka plan servislerini kapatır. NitroLite'ın kullandığı Agent, Care Center ve Lighting servislerine dokunmaz; önce yedek alır." />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button x:Name="BtnApplyDebloat" Click="BtnApplyDebloat_Click" Content="Devre Dışı Bırak" Background="Transparent" Foreground="{DynamicResource AccentRed}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" FontSize="11" />
                                                <Button x:Name="BtnRestoreServices" Click="BtnRestoreServices_Click" Content="Servisleri Geri Yükle" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" Padding="12,7" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Service Status List -->
                                        <ItemsControl x:Name="ListServiceStatuses">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Name}" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" FontSize="11" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- NITROSENSE -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="NitroSense" Style="{StaticResource RowTitle}" />
                                                <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                ToolTip="NitroSense açıkken klavye ışığını ve mod tuşunu NitroSense yönetir, NitroLite karışmaz. Bu buton NitroSense'i ve yardımcı işlemlerini kapatır." />
                                                <TextBlock x:Name="TxtNitroSenseRunningBadge" Text="--" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtNitroSenseLauncherState" Text="--" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="BtnKillNitroSense" Grid.Column="1" Content="NitroSense'i Kapat" Click="BtnKillNitroSense_Click" Background="Transparent" Foreground="{DynamicResource AccentRed}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,8" Cursor="Hand" VerticalAlignment="Center" FontSize="11" />
                                    </Grid>
                                </Border>

                                <!-- SYSTEM & SERVICE REPAIR TOOLS (UNIFIED ENGINE) -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Sistem ve Donanım Onarım Araçları" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Servis uyuşmazlığını, klavye aydınlatmasını, MUX kaydını ve arka plan optimizasyonunu harici betik olmadan doğrudan uygular." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Tool 1: Fix Keyboard Lighting -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Klavye RGB Servisini Onar" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="AcerLightingService kaydını sürücü deposuyla eşitler, klavye RGB servisini yeniden başlatır." />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnFixLighting" Grid.Column="1" Content="Servisi Onar" Click="BtnFixLighting_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 2: Fix Acer Central / Agent Services -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Acer &amp; NitroSense Servislerini Onar" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="AASSvc ve Acer Central servislerini en güncel sürücü paketine bağlar, arka plan çakışmalarını giderir." />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnFixAcerServices" Grid.Column="1" Content="Servisleri Onar" Click="BtnFixAcerServices_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 3: Restore MUX Switch Registry -->
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="MUX Switch Kaydını Onar" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="discrete_gpu_support kayıt defteri anahtarını doğrular, gereksiz eski oturum açılış görevlerini kaldırır." />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnRestoreMux" Grid.Column="1" Content="Kaydı Onar" Click="BtnRestoreMux_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,8" />

                                        <!-- Tool 4: Optimize PC & Background Debloat -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Windows &amp; Sistem Optimizasyonu" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Telemetri görevlerini kapatır, HAGS'ı açar, NVMe TRIM uygular. Her ayar yedeklenir; HAGS yeniden başlatmada etkin olur." />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnRestoreOptimize" Grid.Column="1" Content="Geri Al" Click="BtnRestoreOptimize_Click" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Optimizasyonun değiştirdiği servis, HAGS ve görev ayarlarını yedekten geri yükler." />
                                            <Button x:Name="BtnOptimizePc" Grid.Column="2" Content="Optimize Et" Click="BtnOptimizePc_Click" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource AccentGreen}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock x:Name="TxtRepairToolsStatus" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- APP STARTUP SETTINGS -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,48,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <TextBlock Text="Windows açılışında otomatik çalıştır" Style="{StaticResource RowTitle}" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkAutoStart" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,12" />

                                        <Grid>
                                            <StackPanel Margin="0,0,48,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Windows açılışında tepside başlat" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Otomatik başlatmada pencere gösterilmez, tepside çalışır. Elle açtığınızda pencere görünür." />
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkStartMinimized" Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,12" />

                                        <Grid>
                                            <StackPanel Margin="0,0,16,0" MaxWidth="760" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ATK Fare Entegrasyonu" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="ATK A9 ve benzeri farelerin donanım protokolünü ve oyuna özel profil atamalarını etkinleştirir." />
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkAtkMouseIntegration" Checked="ChkAtkMouseIntegration_Changed" Unchecked="ChkAtkMouseIntegration_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NITROLITE SETTINGS: language, theme, update checks, feedback -->
                                <!-- The bottom margin is what keeps the last row off the window edge: the page's
                                     ScrollViewer has no padding of its own, so a card flush with the bottom had
                                     its final line clipped. -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource CardIcon}" Foreground="{DynamicResource AccentCyan}" />
                                            <TextBlock Text="NitroLite Ayarları" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Dil, tema, güncelleme ve geri bildirim" Style="{StaticResource SectionHint}" Margin="0,3,0,14" />

                                        <!-- Language -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Arayüz dili" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Değiştirdiğinizde NitroLite yeni dille yeniden başlar. Oyun sırasında bir sonraki açılışa bırakılır." />
                                                </StackPanel>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Theme: seven palettes as preview cards, so the choice is made by looking.
                                             The combo box stays in the tree, collapsed: it is the control the rest of
                                             the code reads and writes, and the cards drive it. -->
                                        <StackPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Tema" Style="{StaticResource RowTitle}" />
                                                <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                ToolTip="Seçim anında uygulanır, NitroLite yeniden başlamaz. Sistem varsayılanı Windows'un açık/koyu ayarını izler." />
                                            </StackPanel>
                                            <WrapPanel x:Name="PanelThemeCards" />
                                            <ComboBox x:Name="CmbTheme" Visibility="Collapsed" SelectionChanged="CmbTheme_SelectionChanged" />
                                        </StackPanel>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Automatic update check -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Güncellemeleri otomatik denetle" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Açılıştan 30 saniye sonra ve 6 saatte bir GitHub'a bakar. İnternet yoksa sessizce geçer." />
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" x:Name="ChkAutoUpdateCheck" Checked="ChkAutoUpdateCheck_Changed" Unchecked="ChkAutoUpdateCheck_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Version and a manual check -->
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Sürüm" Style="{StaticResource RowTitle}" />
                                                <TextBlock x:Name="TxtSettingsVersion" Text="v1.2" Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BtnCheckUpdates" Content="Şimdi denetle" Click="BtnCheckUpdates_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,12" />

                                        <!-- Feedback: a prefilled GitHub issue, no telemetry -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Hata bildir" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="GitHub'da önceden doldurulmuş bir hata kaydı açar; kullanıcı adı ve dosya yolu eklenmez." />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="BtnOpenLogs" Content="Günlük klasörünü aç" Click="BtnOpenLogs_Click" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" Margin="0,0,8,0" />
                                                <Button x:Name="BtnReportBug" Content="Hata bildir" Click="BtnReportBug_Click" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,12,0,12" />

                                        <!-- Diagnostics: the file a maintainer asks for when a model-specific bug is reported -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Donanım raporu" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Model, BIOS, Acer servisleri ve WMI durumunu dosyaya yazar. Hata bildirirken ekleyin; seri numarası ve kullanıcı adı içermez." />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="BtnHardwareReport" Grid.Column="1" Content="Raporu dışa aktar" Click="BtnHardwareReport_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                        </Grid>

                                        <Separator Background="{DynamicResource BorderDark}" Margin="0,12,0,12" />

                                        <!-- Backup: one file that survives a Windows reinstall or a new laptop -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Yedekleme" Style="{StaticResource RowTitle}" />
                                                    <ContentControl Style="{StaticResource InfoBadge}" Margin="6,0,0,0"
                                                                    ToolTip="Ayarları, fan eğrilerini, oyun ve RGB profillerini tek dosyaya yazar. Pencere konumu ve okul modu yedeğe girmez." />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="BtnRestoreBackup" Content="Geri yükle" Click="BtnRestoreBackup_Click" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="12,6" Cursor="Hand" FontSize="11" Margin="0,0,8,0" />
                                                <Button x:Name="BtnCreateBackup" Content="Yedekle" Click="BtnCreateBackup_Click" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontWeight="SemiBold" Padding="12,6" Cursor="Hand" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- MINIMALIST NON-BLOCKING TOAST NOTIFICATION BANNER -->
            <Border x:Name="ToastBanner" Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="4" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtToastIcon" Text="●" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtToastMessage" Text="İşlem tamamlandı." Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
