# Linux packaging files are executed or parsed on Linux. A CRLF checkout gives bash a "bad interpreter" and udev a
# rule with a stray carriage return at the end of every line, so these are pinned to LF on every platform.
packaging/linux/*.sh      text eol=lf
packaging/linux/*.desktop text eol=lf
packaging/linux/*.rules   text eol=lf
packaging/linux/*.svg     text eol=lf
tools/linux-capture/*.sh   text eol=lf
packaging/linux/*.in       text eol=lf
packaging/linux/*.socket   text eol=lf
packaging/linux/*.policy   text eol=lf
packaging/linux/*.yaml     text eol=lf
