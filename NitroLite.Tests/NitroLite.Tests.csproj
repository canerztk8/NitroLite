<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- CA1707: a test name is a sentence, and the underscores are what make a failure readable in the runner's
         output. CA1861: the constant arrays are inline expected values in asserts, allocated once per test run. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />
    <ProjectReference Include="..\NitroLite.Linux\NitroLite.Linux.csproj" />
    <!-- The Windows half of the unified backend. Referenced directly rather than through NitroLite.Desktop so the
         scanner and the platform snapshot can be tested without going through the composition root. -->
    <ProjectReference Include="..\NitroLite.Windows\NitroLite.Windows.csproj" />
    <!-- The cross-platform view model. It holds no Avalonia types, so a test can construct it and drive it against an
         in-memory /sys tree with no display attached; this reference is what makes that possible without adding an
         Avalonia package to this project. -->
    <ProjectReference Include="..\NitroLite.Desktop\NitroLite.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
