# Windows writes this as battery-report.html; the underscore spelling is what a
# hand-typed `powercfg /batteryreport /output battery_report.html` produces. Both
# carry the computer name and the battery serial number, so both stay out.
battery-report.html
battery_report.html
battery*.html

