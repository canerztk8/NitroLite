<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows, not net10.0: this assembly is the Windows half of the hardware layer and it is allowed to
         use the registry, System.Management and P/Invoke. It carries no WPF and no XAML, so the Avalonia front end can
         reference it on Windows without dragging a second UI framework into the process. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NitroLite.Windows</RootNamespace>
    <AssemblyName>NitroLite.Windows</AssemblyName>
    <Version>1.3.1</Version>
    <Authors>NitroLite Team</Authors>

    <!-- The Linux CI restores NitroLite.Desktop, which multi-targets and therefore pulls this project in. Without this
         the restore fails with NETSDK1100 before the net10.0 half is ever reached. It is a no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      Four analyzer rules are off in this project, each for a reason that is about this code rather than about the
      rule being wrong.

      CA1305  Every hit is one of two shapes: a `StringBuilder.AppendLine($"…")` in a report builder, where the
              current culture is what the person reading the report expects, or a `Convert.To*(object)` on a boxed
              numeric that came out of WMI, where the provider is ignored anyway. The rule stays on in
              NitroLite.Core, where a culture-sensitive format would reach a file or a comparison.
      CA1822  "Mark members as static". These are members of a service that is injected and replaced in tests; the
              instance call is the seam. Making them static would break every call site to save nothing.
      CA1707  "Remove the underscores from member names". The hits are the ATK protocol constants — VID_ATK,
              CMD_GET_CURRENT_CONFIG — which are spelled the way the vendor's own header spells them.
      CA1838  "Avoid StringBuilder parameters for P/Invokes". The two hits are GetWindowText and
              QueryFullProcessImageName, whose documented signature takes a character buffer; the copy it costs is
              irrelevant at one call a second.
    -->
    <NoWarn>$(NoWarn);CA1305;CA1822;CA1707;CA1838</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The hardware contract, the settings file, the fan curve, the thermal rules and the language catalogues. -->
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI: the Acer root\WMI classes, the SMBIOS identity and the battery class. -->
    <PackageReference Include="System.Management" Version="10.0.14" />

    <!-- PowerModeChanged, which the battery watchdog and the power automation subscribe to. The WPF project got it
         transitively from UseWPF; a class library has to ask for it. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF front end still owns the pages, and the test suite drives both front ends. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NitroLite</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NitroLite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
