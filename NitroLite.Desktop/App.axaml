<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NitroLite.Desktop.App"
             RequestedThemeVariant="Light">

  <!--
    The warm-cream design system, ported from the WPF window it replaces.

    Every value here is copied from the WPF source rather than approximated: the type scale (10 / 11.5 / 12 / 13.5 /
    15 / 18), the 8px card corner with a 14/12 inset, the 2px control corner, the 3px ruled track, the 8x16 square
    slider thumb, the 34x18 switch, the 215px rail. The palette lives in Themes/ThemePalette.cs and is swapped under a
    live window by DesktopThemeManager, so a theme change repaints everything without a restart.

    The vocabulary is the WPF one: a printed caption, a recorded figure, a section title, a row title, a card, an
    inset panel, a segmented pill, a mode tile. Sizes are deliberately few so a control added later has an obvious
    class to use instead of inventing a colour or a radius.
  -->
  <Application.Resources>

    <!--
      The UI typeface. The settings page swaps this key through DesktopThemeManager.ApplyFont, and the Window style
      below reads it with DynamicResource, so a font change repaints every text in the tree without a restart. The
      value here is the default face; the tail of the list is script coverage, not a style choice — the app ships in
      eight languages and Hindi needs a Devanagari face.

      The first entry is not a name but an avares URI: Quicksand travels inside the assembly, so it is resolved from
      the folder it was compiled into rather than from the machine's font directory. That is what makes the window
      look the same on Windows, on Linux, and on a machine that has installed nothing. Quicksand has no Cyrillic, so
      Russian falls through to the tail — the face it was drawn in before the bundled one existed.
    -->
    <FontFamily x:Key="UiFontFamily">avares://NitroLite.Desktop/Assets/Fonts#Quicksand, Nirmala UI, Noto Sans Devanagari, sans-serif</FontFamily>

    <!-- A 3px ruled track, the filled part in ink, an 8x16 square ink thumb. -->
    <ControlTheme x:Key="NitroSlider" TargetType="Slider">
      <Setter Property="Height" Value="18" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Height="18" VerticalAlignment="Center" Margin="4,0" Background="Transparent">
            <Border Height="3" Background="{DynamicResource CardBorderBrush}" VerticalAlignment="Center" />
            <!-- The filled part of the track. It follows the thumb rather than the Track's decrease button, which
                 the Fluent theme's RepeatButton theme refuses to paint. -->
            <Border Height="3" Background="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Width="{Binding #PART_Thumb.Bounds.X}" />
            <!-- Orientation is not optional. Track's default is Vertical, and a vertical track arranges the two
                 RepeatButtons with zero height — so the slider has no hit area at all and neither a click nor a drag
                 reaches it. The Fluent theme binds it for the same reason. -->
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <!-- The two buttons are the track's click area: Slider moves the thumb to the point that was pressed,
                   and it listens on these two, not on the track. They carry their own template because the Fluent
                   RepeatButton theme paints nothing here, and a control that paints nothing cannot be hit — which is
                   why clicking the track used to do nothing at all. -->
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Focusable="False" Padding="0"
                              MinHeight="0" MinWidth="0">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Focusable="False" Padding="0"
                              MinHeight="0" MinWidth="0">
                  <RepeatButton.Template>
                    <ControlTemplate>
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Thumb Name="PART_Thumb" Width="8" Height="16">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="{DynamicResource TextPrimaryBrush}" CornerRadius="1" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- ============================================================ surfaces -->

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="UserControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ============================================================ type scale -->

    <!-- A printed label: small, uppercase, faint. Field names and captions. -->
    <Style Selector="TextBlock.caps">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A recorded figure. -->
    <Style Selector="TextBlock.figure">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The fan readouts: the same face, two steps up. -->
    <Style Selector="TextBlock.figurebig">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.rowtitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The tick or cross in front of a capability row. The glyph itself is the state, so the colour carries the
         meaning and the row needs no second word. -->
    <Style Selector="TextBlock.capglyph">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Width" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.capglyph.ok">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBlock.capglyph.no">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- The page heading: one per page, above the cards. -->
    <Style Selector="TextBlock.pagetitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Vector glyphs from the Windows icon font, exactly as the WPF window drew them. -->
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.navicon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style Selector="TextBlock.cardicon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ============================================================ containers -->

    <!-- A section is a card on the paper: a ground one tone off the page, one hairline frame, an 8px corner. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- An inset inside a card: the thermal-floor note, the udev command box. -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <!-- A reading in the left rail: a figure that is also a shortcut to the page that owns it. -->
    <Style Selector="Border.sidestat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="Border.sidestat:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <!-- The same reading, as a button: the rail's rows are clickable, so they are buttons that look like the border
         above. The template's own presenter has to be cleared as well, or Fluent's hover fill shows through. -->
    <Style Selector="Button.sidestat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.sidestat /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.sidestat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <Style Selector="Button.sidestat:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <!-- The signature's name: a link that is only a link on hover, so the rail's foot stays quiet. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.link /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.link:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The AKTİF chip: a transparent ground with one vermilion rule, so it reads as a stamp not a button. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- A quiet status pill: the panel tone, no frame. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pill > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- A zone swatch is a control, not a colour chip: it answers the pointer with an ink frame. -->
    <Style Selector="Border.zone">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.zone:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- The deck is the only way to aim the palette now that the zone buttons are gone, so the bar it is aimed at
         keeps the same ink frame the pointer draws. Without it the only sign of the selection is the pill's caption,
         which is a word away from the bar the user just clicked. -->
    <Style Selector="Border.zone.zoneactive">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ============================================================ the rail -->

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.nav /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.nav:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.navitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="Border.navitem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Border.navitem.selected">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    </Style>

    <!-- The 5px ink square that marks the selected page. -->
    <Style Selector="Rectangle.navmark">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Rectangle.navmark.selected">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.navitem TextBlock.navlabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.navitem.selected TextBlock.navlabel">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.navitem TextBlock.navicon">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.navitem.selected TextBlock.navicon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ============================================================ mode tiles -->

    <!--
      A mode is a compact tile, not a full-width row: the name, a two-word label and the AKTİF chip. The active tile
      is marked by the vermilion frame plus the chip; the fill never changes, so state is built by de-emphasis rather
      than by a coloured band.
    -->
    <Style Selector="Button.modetile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.modetile /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.modetile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.modetile:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.modetile:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.modetile">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
    </Style>

    <Style Selector="Border.modetile:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Border.modetile.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.modetile:disabled TextBlock.modetitle">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Border.modetile TextBlock.modetitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The dot is the selection marker that does not depend on telling two reds apart. -->
    <Style Selector="Border.modetile Ellipse.selecteddot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Border.modetile.selected Ellipse.selecteddot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ============================================================ segmented pills -->

    <!--
      A segmented choice: fan mode, CPU boost. The chosen option is pressed into the paper — a deeper ground, full ink
      type and a 2px ink rule under it — rather than painted red. Vermilion stays reserved for what is live right now.
    -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.segitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.segitem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.segitem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button.segitem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.segitem.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <Style Selector="Button.segitem.selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>

    <Style Selector="Button.segitem:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- A standalone segmented button: the curve presets, the MUX apply. -->
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.seg /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button.seg:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <Style Selector="Button.seg:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--
      A segmented chip that stays down: the sensor pair under the temperature colour. It wears the segmented button's
      clothes so the row reads as the same kind of control, but it is a toggle because both halves can be on at once —
      one sensor paints the whole keyboard, two of them split it — and a plain button cannot say that.
    -->
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.seg /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="ToggleButton.seg:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <!-- Down means "the colour follows this sensor", so the chip takes the ink frame the selected ramp chip uses. -->
    <Style Selector="ToggleButton.seg:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.seg:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--
      A temperature tile that is also the sensor switch. The pair of segmented chips that used to sit above the tiles was
      a second row saying the same two words, so the reading became the control: clicking the number you are already
      looking at is the shorter way to say "the colour follows this one". The tile that is off dims rather than
      disappearing, because the two are a choice and the one not taken has to stay legible enough to take, and the tile
      that is on keeps full strength with the accent frame the selected controls on this page wear.
    -->
    <Style Selector="ToggleButton.tempchip">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="ToggleButton.tempchip /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.tempchip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="ToggleButton.tempchip:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="ToggleButton.tempchip:checked">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.tempchip:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.tempchip:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!--
      A ramp chip: the gradient a temp-reactive profile paints, with its name under it. A card rather than a segmented
      button, because the thing being chosen is a picture and the label only names it; the selected chip keeps the ink
      frame the segmented row uses so the two read as the same kind of choice.
    -->
    <Style Selector="Button.ramp">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ramp /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.ramp:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button.ramp:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <Style Selector="Button.ramp.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>

    <Style Selector="Button.ramp.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <!-- ============================================================ buttons -->

    <!-- Flat button: no chrome, no bevel. Hover is a paper tone, never a colour. -->
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- A framed button: the update notice, the MUX apply. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <!--
      A framed button that is also a switch: the OSD toggle. Off it is the same frame as .primary, so it reads as a
      button and not as a label; on it fills with the palette's accent and takes the accent's own contrast colour for
      the type. That is the whole state signal, and it works in all eight palettes because both colours come from the
      palette rather than from a literal.

      The hover does not touch the fill. AccentHover is the accent lifted towards white, which on a bright accent leaves
      dark type on a washed-out ground — the one state where the label stopped being readable. A hovered switch instead
      draws its own outline in the contrast colour: the fill and the type stay exactly as legible as they were, and the
      button still answers the pointer.
    -->
    <Style Selector="Button.primary.on">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary.on /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.primary.on:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary.on:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.primary.on:pressed">
      <Setter Property="BorderBrush" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary.on:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <!--
      The Ko-fi button. Ko-fi's own widget is a solid blue pill with a white cup and white type, and people recognise
      that shape before they read the label, so this one keeps the brand blue in every theme instead of following the
      palette. It is the only button in the app that ignores the theme, which is the point: it is a third-party mark,
      not a piece of our chrome. The cup is drawn as a Path in the markup, so nothing is fetched at runtime.
    -->
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#29ABE0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.kofi /template/ ContentPresenter">
      <Setter Property="Background" Value="#29ABE0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E96C6" />
    </Style>

    <Style Selector="Button.kofi:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#187FA9" />
    </Style>

    <!--
      A destructive button: the same frame as .primary, but the rule and the label are the danger colour, so "delete"
      never reads like "apply". The wash under the pointer is the danger at 14 %, which keeps the button legible on the
      cream page and on every dark palette without a second colour. The frame is what carries the meaning: a red label
      on a flat button reads as a link, and a link is not what a delete is.
    -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>

    <Style Selector="Button.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>

    <Style Selector="Button.danger:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- A theme card: the swatch strip is the button, so the frame is the only chrome it carries. The chosen one is
         framed in the accent; the rest are framed in nothing, which is what makes the choice readable at a glance
         without a tick or a label. -->
    <Style Selector="Button.themecard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.themecard /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.themecard:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button.themecard.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The window buttons: 28x28, no frame, a paper tone under the pointer. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.caption /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.caption.close:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- A colour swatch: a 26px square that answers the pointer with an ink frame. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.swatch /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================================================ the switch -->

    <!--
      A checkbox as a switch: a 34x18 track with a 12px paper thumb. The track is the only thing that fills, and it
      fills with the accent, so "on" is legible at a glance without a second colour.
    -->
    <Style Selector="ToggleButton.toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Name="track" Width="34" Height="18" CornerRadius="9"
                    Background="{DynamicResource CardBorderBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Grid>
                <Ellipse Name="thumb" Width="12" Height="12"
                         Fill="{DynamicResource PageBrush}"
                         HorizontalAlignment="Left" Margin="2,0,0,0" />
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ToggleButton.toggle:pointerover /template/ Border#track">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ToggleButton.toggle:checked /template/ Border#track">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.toggle:checked /template/ Ellipse#thumb">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <Style Selector="ToggleButton.toggle:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ============================================================ slider -->

    <!-- The WPF slider: a 3px ruled track, the filled part in ink, an 8x16 square ink thumb. The Fluent theme's own
         Slider theme wins over an application-level Style, so the whole template is replaced through Theme. The
         selector is :is(Slider) rather than Slider because the pages use NitroSlider, which adds the track's click
         area, and a plain type selector would not match a derived control. -->
    <Style Selector=":is(Slider)">
      <Setter Property="Theme" Value="{StaticResource NitroSlider}" />
    </Style>

    <!-- ============================================================ progress bar -->

    <!-- A 3px ruled track with a solid fill. The fill follows Foreground, so the bar never needs a second template. -->
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Height="3">
            <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5"
                    HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- ============================================================ combo box -->

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6,26,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <!-- ============================================================ text box -->

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
    </Style>

    <!-- ============================================================ scroll bar -->

    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="10" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource CardBorderStrongBrush}" CornerRadius="2" Margin="2,0" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- ============================================================ tooltip -->

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- ============================================================ the (?) badge -->

    <Style Selector="Border.infobadge">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="7.5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.infobadge:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="Border.infobadge > TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ the collapsible card header -->

    <!--
      A card whose body folds. The header is a ToggleButton rather than an Expander because the Expander's own template
      brings a Fluent frame, a Fluent chevron and a Fluent padding, all three of which would have to be overridden to
      look like the rest of the window. A toggle with no chrome is the same behaviour with none of that: the whole row
      is the switch, and the chevron is the only thing it adds.
    -->
    <Style Selector="ToggleButton.sectionhead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton.sectionhead /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.sectionhead:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.sectionhead:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The two chevrons are two glyphs rather than one rotated one: a rotate transform on a 11px glyph is a
         sub-pixel render on every theme, and swapping the character is exact. -->
    <Style Selector="TextBlock.chevron">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
  </Application.Styles>
</Application>
