<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NitroLite.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- The palette. Deliberately small: one accent, three text weights and two surfaces, so a control added later
         has an obvious colour to use instead of inventing one. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#0E1116" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Ubuntu, Noto Sans, sans-serif" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F2F5F9" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F2F5F9" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A94A6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F2F5F9" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#161B23" />
      <Setter Property="BorderBrush" Value="#232A35" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#1E2530" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2F81F7" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A93F8" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1E2530" />
      <Setter Property="Foreground" Value="#D7DEE8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#28313E" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="160" />
    </Style>
  </Application.Styles>
</Application>
