<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One UI, two backends. net10.0 is the Linux build and sees only NitroLite.Core and NitroLite.Linux; the
         net10.0-windows build sees NitroLite.Core and NitroLite.Windows. Neither target can accidentally compile
         against the other platform's hardware layer, because the reference is per-target. -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NitroLite.Desktop</RootNamespace>
    <AssemblyName>NitroLite.Desktop</AssemblyName>
    <Version>1.2.5-f</Version>
    <Authors>NitroLite Team</Authors>

    <!-- Compiled bindings: a binding path that does not exist is a build error instead of a silently empty control.
         Every view declares x:DataType, which is also what makes the XAML readable without the view model open. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- The Linux CI restores this project, which evaluates both targets. Without this the restore fails with
         NETSDK1100 before the net10.0 half is ever built. It is a no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- The Linux manifest: asInvoker, because the udev rule grants the session user write access and a manifest that
         asked for elevation would make the app unusable on a desktop with no sudo prompt. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The same asInvoker manifest the WPF front end ships, shared rather than copied so the two Windows builds
         cannot drift apart on the execution level or the DPI awareness. -->
    <ApplicationManifest>..\NitroLite\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core for the hardware contract, the settings file, the fan curve and the eight language catalogues. -->
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- The sysfs backend. Nothing Windows is referenced here at all. -->
    <ProjectReference Include="..\NitroLite.Linux\NitroLite.Linux.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The WMI and Acer-service backend, plus the Windows system services school mode needs. -->
    <ProjectReference Include="..\NitroLite.Windows\NitroLite.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The udev rule travels inside the assembly so the settings page can hand the user a working install command on
         a machine that only has the published build. LogicalName is fixed because UdevGuide looks it up by name. -->
    <EmbeddedResource Include="..\packaging\linux\99-nitrolite.rules"
                      LogicalName="NitroLite.Desktop.99-nitrolite.rules" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon. Shared with the Windows build rather than copied, so the two front ends cannot drift apart, and
         an AvaloniaResource rather than an EmbeddedResource because TrayIcon takes a WindowIcon, which is loaded
         through AssetLoader from avares://. -->
    <AvaloniaResource Include="..\NitroLite\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

</Project>
