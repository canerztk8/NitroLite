<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One UI, two backends. net10.0 is the Linux build and sees only NitroLite.Core and NitroLite.Linux; the
         net10.0-windows build sees NitroLite.Core and NitroLite.Windows. Neither target can accidentally compile
         against the other platform's hardware layer, because the reference is per-target. -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NitroLite.Desktop</RootNamespace>
    <AssemblyName>NitroLite.Desktop</AssemblyName>
    <Version>1.3.3</Version>
    <Authors>NitroLite Team</Authors>

    <!-- Compiled bindings: a binding path that does not exist is a build error instead of a silently empty control.
         Every view declares x:DataType, which is also what makes the XAML readable without the view model open. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      CA1822 is off in this project. It fires on every view-model property that a binding reads — FreeLabel,
      TemperatureLabel, Languages, UiFonts — because a getter that returns a constant does not touch instance state.
      Those members have to stay instance members: a compiled binding resolves them on the view model instance, and a
      static property is not a binding target. The rule is on everywhere else.
    -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>

    <!-- The Linux CI restores this project, which evaluates both targets. Without this the restore fails with
         NETSDK1100 before the net10.0 half is ever built. It is a no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One manifest for both targets, and it lives here rather than in the retired WPF project. asInvoker on both:
         the Linux build never needs elevation because the udev rule grants the session user write access, and the
         Windows build elevates a helper rather than itself. PerMonitorV2 is what keeps the window sharp at 125% and
         150% scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The icon Explorer and the taskbar show. The WPF project carried it; the Avalonia build is the only front end
         now, so it carries it instead. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Trimming. TrimMode=partial is the only mode this app can ship: the framework is trimmed, but every assembly that
    has not declared itself trimmable — Avalonia, System.Management and all four NitroLite assemblies — is copied
    whole. Full mode would remove the reflection Avalonia's XAML loader and System.Management's COM interop depend on,
    and the failure would be a MissingMethodException at run time rather than a build error.
  -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>

    <!-- System.Text.Json's reflection path is what reads settings.json, profiles.user.json and the worker protocol.
         The trimmer cannot see those types through a generic call, so the switch that keeps the path alive is set
         explicitly rather than left to the SDK default. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- Rooted so the trimmer keeps every member, not only the ones it can see being called. The XAML loader resolves
         view-model properties by name, and the WMI executor resolves methods on a dynamic ManagementObject. -->
    <TrimmerRootAssembly Include="NitroLite.Core" />
    <TrimmerRootAssembly Include="NitroLite.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true' And '$(TargetFramework)' == 'net10.0-windows'">
    <TrimmerRootAssembly Include="NitroLite.Windows" />
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true' And '$(TargetFramework)' == 'net10.0'">
    <TrimmerRootAssembly Include="NitroLite.Linux" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core for the hardware contract, the settings file, the fan curve and the eight language catalogues. -->
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- The sysfs backend. Nothing Windows is referenced here at all. -->
    <ProjectReference Include="..\NitroLite.Linux\NitroLite.Linux.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The WMI and Acer-service backend, plus the Windows system services school mode needs. -->
    <ProjectReference Include="..\NitroLite.Windows\NitroLite.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The udev rule travels inside the assembly so the settings page can hand the user a working install command on
         a machine that only has the published build. LogicalName is fixed because UdevGuide looks it up by name. -->
    <EmbeddedResource Include="..\packaging\linux\99-nitrolite.rules"
                      LogicalName="NitroLite.Desktop.99-nitrolite.rules" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon and the window icon. An AvaloniaResource rather than an EmbeddedResource because TrayIcon takes
         a WindowIcon, which is loaded through AssetLoader from avares://. -->
    <AvaloniaResource Include="app.ico" Link="Assets\app.ico" />

    <!-- The lockup the header prints instead of the product name, in the two grounds the palettes need: the ink mark
         for the paper themes, the white one for Dark, Midnight OLED and the rest of the dark set. Two flat PNGs rather
         than the kit's SVG because the build carries no SVG renderer, and adding one would be a package reference for
         a wordmark that never scales. Straight copies of docs/brand/logo-2026/kit/lockups, not redrawn. -->
    <AvaloniaResource Include="Assets\logo-horizontal-*.png" />

    <!-- The bundled typefaces: Quicksand, Exo 2, Oxanium, Rubik, JetBrains Mono, Rajdhani, Space Grotesk and
         Chakra Petch, each in the three weights the type scale actually uses — Regular for body text, SemiBold for
         titles and labels, Bold for the numbers. Carried inside the assembly rather than looked up on the machine, so the window is drawn in the
         same face on Windows and on Linux and on a machine that has installed nothing. An AvaloniaResource because
         Avalonia resolves an embedded family through avares://, the same route the icons take. The wildcard picks
         up every .ttf in the folder, so adding a face is dropping its three files here. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />

    <!-- The OFL requires the licence to travel with the font. Copied next to the executable rather than embedded,
         because a licence nobody can read is not a licence. Kept out of the published package on purpose: the
         release script appends this same text to THIRD-PARTY-NOTICES.md, and the package's allowlist has no room
         for a second file, so shipping it twice would fail the release. -->
    <None Update="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
