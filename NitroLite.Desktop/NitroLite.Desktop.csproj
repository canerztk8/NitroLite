<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One UI, two backends. net10.0 is the Linux build and sees only NitroLite.Core and NitroLite.Linux; the
         net10.0-windows build sees NitroLite.Core and NitroLite.Windows. Neither target can accidentally compile
         against the other platform's hardware layer, because the reference is per-target. -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NitroLite.Desktop</RootNamespace>
    <AssemblyName>NitroLite.Desktop</AssemblyName>
    <Version>1.2.5-f</Version>
    <Authors>NitroLite Team</Authors>

    <!-- Compiled bindings: a binding path that does not exist is a build error instead of a silently empty control.
         Every view declares x:DataType, which is also what makes the XAML readable without the view model open. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      CA1822 is off in this project. It fires on every view-model property that a binding reads — FreeLabel,
      TemperatureLabel, Languages, UiFonts — because a getter that returns a constant does not touch instance state.
      Those members have to stay instance members: a compiled binding resolves them on the view model instance, and a
      static property is not a binding target. The rule is on everywhere else.
    -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>

    <!-- The Linux CI restores this project, which evaluates both targets. Without this the restore fails with
         NETSDK1100 before the net10.0 half is ever built. It is a no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One manifest for both targets, and it lives here rather than in the retired WPF project. asInvoker on both:
         the Linux build never needs elevation because the udev rule grants the session user write access, and the
         Windows build elevates a helper rather than itself. PerMonitorV2 is what keeps the window sharp at 125% and
         150% scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The icon Explorer and the taskbar show. The WPF project carried it; the Avalonia build is the only front end
         now, so it carries it instead. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core for the hardware contract, the settings file, the fan curve and the eight language catalogues. -->
    <ProjectReference Include="..\NitroLite.Core\NitroLite.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- The sysfs backend. Nothing Windows is referenced here at all. -->
    <ProjectReference Include="..\NitroLite.Linux\NitroLite.Linux.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- The WMI and Acer-service backend, plus the Windows system services school mode needs. -->
    <ProjectReference Include="..\NitroLite.Windows\NitroLite.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The udev rule travels inside the assembly so the settings page can hand the user a working install command on
         a machine that only has the published build. LogicalName is fixed because UdevGuide looks it up by name. -->
    <EmbeddedResource Include="..\packaging\linux\99-nitrolite.rules"
                      LogicalName="NitroLite.Desktop.99-nitrolite.rules" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon and the window icon. An AvaloniaResource rather than an EmbeddedResource because TrayIcon takes
         a WindowIcon, which is loaded through AssetLoader from avares://. -->
    <AvaloniaResource Include="app.ico" Link="Assets\app.ico" />

    <!-- One screenshot per palette, for the theme cards on the settings page. Carried over from the WPF front end
         unchanged: they were captured from the English UI, so one set serves all eight languages. An
         AvaloniaResource rather than an EmbeddedResource because the cards load them through AssetLoader from
         avares://, the same route the icons take. -->
    <AvaloniaResource Include="Assets\themes\*.jpg" />
  </ItemGroup>

</Project>
