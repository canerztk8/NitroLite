<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:core="using:NitroLite.Core"
             x:Class="NitroLite.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Margin="18" Spacing="14">

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.Device}" />

          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- A row whose value the probe could not read is dropped rather than drawn as a label with nothing
                 beside it, which reads as a broken page. -->
            <TextBlock Grid.Row="0" Classes="caption" Text="{Binding Labels.Model}" Margin="0,0,0,6"
                       IsVisible="{Binding HasDeviceName}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceModel}" Margin="0,0,0,6"
                       IsVisible="{Binding HasDeviceName}" />

            <TextBlock Grid.Row="1" Classes="caption" Text="{Binding Labels.Bios}" Margin="0,0,0,6"
                       IsVisible="{Binding HasDeviceBios}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceBios}" Margin="0,0,0,6"
                       IsVisible="{Binding HasDeviceBios}" />

            <TextBlock Grid.Row="2" Classes="caption" Text="{Binding Labels.Tier}" Margin="0,0,0,6" />
            <!-- The probe's own word is "none" or "acer-wmi"; neither belongs in front of a user. -->
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TierDisplay}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="3" Classes="caption" Text="{Binding Labels.DataFolder}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding DataFolder}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Appearance. The theme picker applies on selection rather than behind an Apply button: the whole point of a
           palette is that you can see it, and a preview that needs confirming is a preview you cannot judge. -->
      <Grid ColumnDefinitions="*,*">
        <Border Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{Binding Labels.Theme}" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      MinWidth="240"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" Text="{Binding Labels.ThemeApplied}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{Binding Labels.Language}" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      MinWidth="240"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:LocLanguage">
                  <TextBlock Text="{Binding NativeName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" Text="{Binding Labels.LanguageRestartHint}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{Binding Labels.CapabilitySummary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost"
                    Content="{Binding Labels.Rescan}"
                    Command="{Binding RescanCommand}" />
          </Grid>

          <!-- One row per capability, ticked in the theme's success colour. A block of monospaced text was readable
               but impossible to scan. -->
          <ItemsControl ItemsSource="{Binding CapabilityRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CapabilityRow">
                <Border Classes="caprow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="capglyph"
                               Classes.ok="{Binding Supported}"
                               Classes.no="{Binding !Supported}"
                               Text="{Binding Glyph}" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding Label}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding StateText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="caption"
                     Text="{Binding Labels.NoBackend}"
                     IsVisible="{Binding HasNoBackend}" />
        </StackPanel>
      </Border>

      <!-- The udev banner only appears when a write actually failed for lack of permission, so a user who already
           installed the rule never sees it. -->
      <Border Classes="card" IsVisible="{Binding NeedsUdevRule}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding Labels.UdevNeeded}" />
          <TextBlock Classes="caption" Text="{Binding Labels.UdevInstruction}" />
          <Border Classes="panel">
            <TextBox Text="{Binding UdevCommand}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Classes="mono"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0" />
          </Border>
          <Button Classes="primary"
                  Content="{Binding Labels.CopyCommand}"
                  Command="{Binding CopyUdevCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- The report is built from model-level facts only: no serial number, no UUID, no user name, no personal path.
           It is meant to be pasted into a public issue, so the hint says so before the user presses the button. -->
      <Border Classes="card" IsVisible="{Binding HardwareReportAvailable}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding Labels.HardwareReport}" />
          <TextBlock Classes="caption" Text="{Binding Labels.HardwareReportHint}" />
          <Button Classes="primary"
                  Content="{Binding Labels.CopyReport}"
                  Command="{Binding CopyHardwareReportCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Hidden when the probe had nothing to report, rather than shown as an empty card. -->
      <Border Classes="card" IsVisible="{Binding HasNotes}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding Labels.Notes}" />
          <TextBlock Classes="caption" Text="{Binding NotesText}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
