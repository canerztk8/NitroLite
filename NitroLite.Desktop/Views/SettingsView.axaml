<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:core="using:NitroLite.Core"
             xmlns:conv="using:NitroLite.Desktop.Converters"
             xmlns:sys="using:System"
             x:Class="NitroLite.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <!--
    Page 5: the services and the tools. A title, then a stack of cards whose header row carries the name, an optional
    (?) badge and the action on the right, with hairline rules between the rows inside.

    Two of the cards fold. The Acer card is the longest thing in the app — a service list, three repair buttons, the
    NitroSense controls and the Nitro key — and it is also the card most visits do not need, so it opens closed and the
    page reads as a short stack of headings. The startup card folds for the same reason: three switches that are set
    once and then never touched again.

    The prose is gone. Every row that used to carry a sentence under it now carries the sentence in the (?) badge of the
    group it belongs to, which is where a reader who wants it will look and where a reader who does not will never see
    it. The one exception is the elevated sign-in row, whose "(recommended)" is a decision aid rather than an
    explanation.

    The game profile editor is deliberately not here. It lives on the modes page, where the mode and fan pickers it
    writes to are, and a second copy on this page meant two places to keep in step and two places for a user to look.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
        <TextBlock Classes="pagetitle" Text="{Binding Labels.ToolsPageTitle}" VerticalAlignment="Center" />
        <!-- A one-time action, so it is a link in the header rather than a card of its own. -->
        <Button Grid.Column="1" Classes="link" Content="{Binding Labels.OnboardingReopen}"
                Command="{Binding ReopenOnboardingCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </Grid>

      <!-- ============================================================ Acer background and system hardware -->

      <!-- One card for the machine's own plumbing: the services, the repair tools and the key all answer "what is this
           laptop doing behind the window", and three cards for that was three headings for one subject. -->
      <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding AcerHardwareAvailable}">
        <StackPanel>
          <ToggleButton Classes="sectionhead" IsChecked="{Binding AcerSectionExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Classes="cardicon" Text="&#xE9F5;" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Grid.Column="1" Classes="section" Text="{Binding Labels.AcerHardware}" />
              <Border Grid.Column="2" Classes="infobadge" Margin="6,0,0,0"
                      ToolTip.Tip="{Binding AcerHardwareHint}">
                <TextBlock Text="?" />
              </Border>
              <TextBlock Grid.Column="3" Classes="chevron" Text="&#xE70D;"
                         IsVisible="{Binding !AcerSectionExpanded}" />
              <TextBlock Grid.Column="3" Classes="chevron" Text="&#xE70E;"
                         IsVisible="{Binding AcerSectionExpanded}" />
            </Grid>
          </ToggleButton>

          <StackPanel IsVisible="{Binding AcerSectionExpanded}" Margin="0,12,0,0">

            <!-- the services -->
            <StackPanel IsVisible="{Binding ServicesAvailable}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Classes="caps" Text="{Binding Labels.AcerServices}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Classes="danger" Content="{Binding Labels.DisableServices}" Padding="12,7" FontSize="11"
                          Command="{Binding DisableServicesCommand}" IsEnabled="{Binding !ServicesBusy}" />
                  <Button Classes="primary" Content="{Binding Labels.RestoreServices}" Margin="6,0,0,0"
                          Padding="12,7" FontSize="11" Command="{Binding RestoreServicesCommand}"
                          IsEnabled="{Binding !ServicesBusy}" />
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding AcerServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AcerServiceRow">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="rowtitle" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding StateText}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="hint" Text="{Binding Labels.NoAcerServices}" IsVisible="{Binding HasNoAcerServices}" />

              <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,8" />

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="rowtitle" Text="{Binding Labels.NitroSense}" VerticalAlignment="Center" />
                  <Border Classes="pill" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NitroSenseStateText}" />
                  </Border>
                </StackPanel>
                <Button Grid.Column="1" Classes="danger" Content="{Binding Labels.KillNitroSense}" Padding="12,7"
                        FontSize="11" Command="{Binding KillNitroSenseCommand}" IsEnabled="{Binding NitroSenseRunning}" />
              </Grid>

              <TextBlock Classes="hint" Text="{Binding ServicesStatus}" Margin="0,8,0,0"
                         IsVisible="{Binding HasServicesStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- the repair tools -->
            <StackPanel IsVisible="{Binding RepairToolsAvailable}">
              <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10"
                      IsVisible="{Binding ServicesAvailable}" />

              <TextBlock Classes="caps" Text="{Binding Labels.RepairToolsGroup}" Margin="0,0,0,6" />

              <WrapPanel>
                <Button Classes="primary" Content="{Binding Labels.FixLighting}" Margin="0,0,6,6" Padding="12,7"
                        FontSize="11" Command="{Binding FixLightingCommand}" IsEnabled="{Binding !ToolsBusy}" />
                <Button Classes="primary" Content="{Binding Labels.FixAcerServices}" Margin="0,0,6,6" Padding="12,7"
                        FontSize="11" Command="{Binding FixAcerServicesCommand}" IsEnabled="{Binding !ToolsBusy}" />
                <Button Classes="primary" Content="{Binding Labels.RestoreMux}" Margin="0,0,6,6" Padding="12,7"
                        FontSize="11" Command="{Binding RestoreMuxCommand}" IsEnabled="{Binding !ToolsBusy}" />
              </WrapPanel>

              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.WindowsOptimization}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Classes="danger" Content="{Binding Labels.Optimize}" Padding="12,7" FontSize="11"
                          Command="{Binding OptimizeCommand}" IsEnabled="{Binding !ToolsBusy}" />
                  <Button Classes="danger" Content="{Binding Labels.RestoreOptimize}" Margin="6,0,0,0" Padding="12,7"
                          FontSize="11" Command="{Binding RestoreOptimizeCommand}" IsEnabled="{Binding !ToolsBusy}" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="hint" Text="{Binding RepairToolsStatus}" Margin="0,8,0,0"
                         IsVisible="{Binding HasRepairToolsStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- the Nitro key -->
            <!-- One switch, and only on a machine that has the button. There is no shortcut to record: the key is
                 physical and has one meaning, so a key-binding editor here would be a different feature wearing the
                 same name. The three explanations live in the (?) badge; the only line the group prints is the
                 launcher's state, which is the one thing a user cannot work out by looking at the switches. -->
            <StackPanel IsVisible="{Binding NitroKeyAvailable}">
              <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Classes="caps" Text="{Binding Labels.NitroKey}" />
                <Border Classes="infobadge" Margin="6,0,0,0" ToolTip.Tip="{Binding NitroKeyHelp}">
                  <TextBlock Text="?" />
                </Border>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.NitroKeyToggle}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding NitroKeyEnabled}"
                              VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.RedirectNitroSense}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding RedirectNitroSenseEnabled}"
                              IsEnabled="{Binding CanRedirectNitroSense}" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.NitroSenseLauncherBlockTitle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding NitroSenseLauncherBlockAction}" Padding="12,7" FontSize="11"
                        Command="{Binding ToggleNitroSenseLauncherCommand}" IsEnabled="{Binding !ServicesBusy}"
                        VerticalAlignment="Center" />
              </Grid>

              <TextBlock Classes="hint" Text="{Binding NitroSenseLauncherBlockStateText}" Margin="0,6,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ how the app starts -->

      <!-- One card for one decision, and one switch for it: the elevated entry is strictly better than the plain one on
           Windows, so only the elevated one is offered there. Linux has no elevated entry, so the plain one is the whole
           feature and keeps its row. -->
      <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding StartupAvailable}">
        <StackPanel>
          <ToggleButton Classes="sectionhead" IsChecked="{Binding StartupSectionExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="cardicon" Text="&#xE7E8;" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Grid.Column="1" Classes="section" Text="{Binding Labels.StartupAndIntegration}" />
              <TextBlock Grid.Column="2" Classes="chevron" Text="&#xE70D;"
                         IsVisible="{Binding !StartupSectionExpanded}" />
              <TextBlock Grid.Column="2" Classes="chevron" Text="&#xE70E;"
                         IsVisible="{Binding StartupSectionExpanded}" />
            </Grid>
          </ToggleButton>

          <StackPanel IsVisible="{Binding StartupSectionExpanded}" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowRunAtStartupRow}">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.RunAtStartup}" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding RunAtStartupOn}"
                            VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding AutoStartAvailable}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.AutoStart}" VerticalAlignment="Center" />
                <TextBlock Classes="hint" Text="{Binding Labels.Recommended}" Margin="6,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding AutoStartOn}"
                            VerticalAlignment="Center" />
            </Grid>

            <TextBlock Classes="hint" Text="{Binding AutoStartStatus}" Margin="0,4,0,0"
                       IsVisible="{Binding HasAutoStartStatus}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.StartMinimized}" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding StartMinimizedOn}"
                            VerticalAlignment="Center" />
            </Grid>

            <TextBlock Classes="hint" Text="{Binding Labels.TrayUnavailableHint}" Margin="0,4,0,0"
                       IsVisible="{Binding TrayUnavailable}" TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8,0,8" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.AtkMouseIntegration}" VerticalAlignment="Center" />
              <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding AtkMouseIntegrationOn}"
                            VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ updates, diagnostics and backup -->

      <!-- Three groups under one heading, each with a caption. The buttons used to sit in three unlabelled rows, which
           is what made the card read as a pile: nothing said which of the eight actions was a report, which was a
           backup, and which was the update. -->
      <Border Classes="card" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE895;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.UpdatesAndDiagnostics}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding UpdateAvailable}">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.AutoUpdateCheck}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding UpdateVersionText}" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
            <ToggleButton Grid.Column="2" Classes="toggle" IsChecked="{Binding AutoUpdateCheckOn}"
                          VerticalAlignment="Center" />
          </Grid>

          <WrapPanel Margin="0,8,0,0">
            <Button Classes="primary" Content="{Binding Labels.CheckNow}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding CheckUpdatesCommand}" />
            <Button Classes="primary" Content="{Binding UpdateNowText}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding UpdateNowCommand}" IsVisible="{Binding HasPendingUpdate}" />
            <Button Classes="primary" Content="{Binding Labels.ReleaseNotes}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding ReleaseNotesCommand}" />
          </WrapPanel>

          <TextBlock Classes="hint" Text="{Binding UpdateStatus}" IsVisible="{Binding HasUpdateStatus}"
                     TextWrapping="Wrap" />

          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10" />

          <TextBlock Classes="caps" Text="{Binding Labels.DiagnosticsGroup}" Margin="0,0,0,6" />

          <WrapPanel>
            <Button Classes="primary" Content="{Binding Labels.ReportBug}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding ReportBugCommand}" />
            <Button Classes="primary" Content="{Binding Labels.OpenLogs}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding OpenLogsCommand}" />
            <Button Classes="primary" Content="{Binding Labels.CopyReport}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding CopyHardwareReportCommand}"
                    ToolTip.Tip="{Binding Labels.HardwareReportHint}"
                    IsVisible="{Binding HardwareReportAvailable}" />
            <Button Classes="primary" Content="{Binding Labels.ExportReport}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding ExportHardwareReportCommand}"
                    IsVisible="{Binding HardwareReportAvailable}" />
            <Button Classes="primary" Content="{Binding Labels.ReportCompatibility}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding ReportCompatibilityCommand}"
                    ToolTip.Tip="{Binding Labels.HardwareReportHint}"
                    IsVisible="{Binding HardwareReportAvailable}" />
            <Button Classes="primary" Content="{Binding Labels.CreateBundle}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding CreateDiagnosticsCommand}"
                    IsVisible="{Binding DiagnosticsAvailable}" />
          </WrapPanel>

          <TextBlock Classes="hint" Text="{Binding DiagnosticsNote}" Margin="0,4,0,0"
                     IsVisible="{Binding HasDiagnosticsNote}" TextWrapping="Wrap" />

          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10"
                  IsVisible="{Binding SnapshotDiffAvailable}" />

          <!-- The two-step NitroSense diff: read-only, and the only diagnostic that needs the user to change a setting
               in Acer's own tool between the two clicks. -->
          <StackPanel IsVisible="{Binding SnapshotDiffAvailable}">
            <TextBlock Classes="caps" Text="{Binding Labels.SnapshotDiffTitle}" Margin="0,0,0,6" />
            <TextBlock Classes="hint" Text="{Binding Labels.SnapshotDiffHint}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <WrapPanel>
              <Button Classes="primary" Content="{Binding Labels.SnapshotCaptureA}" Margin="0,0,6,6" Padding="12,7"
                      FontSize="11" Command="{Binding CaptureSnapshotACommand}" />
              <Button Classes="primary" Content="{Binding Labels.SnapshotCaptureB}" Margin="0,0,6,6" Padding="12,7"
                      FontSize="11" Command="{Binding CaptureSnapshotBDiffCommand}" />
            </WrapPanel>

            <TextBlock Classes="hint" Text="{Binding SnapshotDiffStatus}" Margin="0,4,0,0"
                       IsVisible="{Binding HasSnapshotDiffStatus}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10" />

          <TextBlock Classes="caps" Text="{Binding Labels.Backup}" Margin="0,0,0,6" />

          <WrapPanel>
            <Button Classes="primary" Content="{Binding Labels.CreateBackup}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding CreateBackupCommand}" />
            <Button Classes="primary" Content="{Binding Labels.RestoreBackup}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding RestoreBackupCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ the device -->

      <Border Classes="card" Margin="0,0,0,14">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="cardicon" Text="&#xE772;" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Classes="section" Text="{Binding Labels.DeviceCapabilities}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.Rescan}" Padding="12,7"
                    FontSize="11" Command="{Binding RescanCommand}" />
          </Grid>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- A row whose value the probe could not read is dropped rather than drawn as a label with nothing
                 beside it, which reads as a broken page. -->
            <TextBlock Grid.Row="0" Classes="caps" Text="{Binding Labels.Model}" Margin="0,0,0,4"
                       IsVisible="{Binding HasDeviceName}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding DeviceModel}"
                       Margin="0,0,0,4" IsVisible="{Binding HasDeviceName}" />

            <TextBlock Grid.Row="1" Classes="caps" Text="{Binding Labels.Bios}" Margin="0,0,0,4"
                       IsVisible="{Binding HasDeviceBios}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding DeviceBios}"
                       Margin="0,0,0,4" IsVisible="{Binding HasDeviceBios}" />

            <TextBlock Grid.Row="2" Classes="caps" Text="{Binding Labels.Tier}" Margin="0,0,0,4" />
            <!-- The probe's own word is "none" or "acer-wmi"; neither belongs in front of a user. -->
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding TierDisplay}"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="3" Classes="caps" Text="{Binding Labels.DataFolder}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding DataFolder}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,4" />

          <!-- One row per capability, ticked in the theme's success colour. A block of monospaced text was readable
               but impossible to scan. -->
          <ItemsControl ItemsSource="{Binding CapabilityRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CapabilityRow">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                  <TextBlock Classes="capglyph" Classes.ok="{Binding Ok}"
                             Classes.no="{Binding No}" Text="{Binding Glyph}" />
                  <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Label}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="2" Classes="hint" Text="{Binding StateText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The direct-WMI backend is the fallback for a machine whose Acer service is missing or broken. The
               switch is the emergency rollback the setting exists for: off pins every read and write to the Acer
               service socket, which is the behaviour before the hardware abstraction existed. The controller reads
               the setting on every call, so the change takes effect without a restart. -->
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0" IsVisible="{Binding DirectWmiAvailable}">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.UseDirectWmiBackend}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Labels.UseDirectWmiBackendHint}"
                       Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleButton Grid.Column="2" Classes="toggle" IsChecked="{Binding UseDirectWmiBackend}"
                          VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0" IsVisible="{Binding DirectWmiAvailable}">
            <TextBlock Classes="caps" Text="{Binding Labels.DirectWmi}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding DirectWmiStatus}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.StartCheck}" Padding="12,7"
                    FontSize="11" Command="{Binding StartDirectWmiCommand}" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Labels.NoBackend}" Margin="0,8,0,0"
                     IsVisible="{Binding ShowNoBackendBanner}" />
        </StackPanel>
      </Border>

      <!--
        The Linux setup card. Drawn only when there is something to do: nodes that need the udev rule, a user who is
        not in the input group, or a kernel step that would unlock more of the machine. The permissions are one button
        and one password prompt; the copyable command stays underneath for a desktop without pkexec.
      -->
      <Border Classes="card" Margin="0,0,0,14" IsVisible="{Binding ShowLinuxSetupCard}">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{Binding Labels.LinuxSetupTitle}" />
          <TextBlock Classes="hint" Text="{Binding LinuxModelNote}" TextWrapping="Wrap" FontWeight="SemiBold"
                     IsVisible="{Binding HasLinuxModelNote}" />

          <StackPanel Spacing="8" IsVisible="{Binding ShowGrantAccess}">
            <TextBlock Classes="hint" Text="{Binding Labels.LinuxGrantHint}" TextWrapping="Wrap" />
            <Button Classes="primary" Content="{Binding Labels.LinuxGrantButton}" HorizontalAlignment="Left"
                    IsVisible="{Binding CanElevate}" IsEnabled="{Binding LinuxSetupIdle}"
                    AutomationProperties.AutomationId="GrantLinuxAccess"
                    Command="{Binding GrantLinuxAccessCommand}" />
            <TextBlock Classes="hint" Text="{Binding Labels.UdevInstruction}" TextWrapping="Wrap" />
            <Border Classes="panel">
              <TextBox Text="{Binding UdevCommand}" IsReadOnly="True" TextWrapping="Wrap" Classes="mono"
                       Background="Transparent" BorderThickness="0" Padding="0" />
            </Border>
            <Button Content="{Binding Labels.CopyCommand}" HorizontalAlignment="Left"
                    Command="{Binding CopyUdevCommand}" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding ShowPredatorV4}" Margin="0,6,0,0">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.LinuxPredatorV4Title}" />
            <TextBlock Classes="hint" Text="{Binding Labels.LinuxPredatorV4Hint}" TextWrapping="Wrap" />
            <Button Content="{Binding Labels.LinuxPredatorV4Button}" HorizontalAlignment="Left"
                    IsVisible="{Binding CanElevate}" IsEnabled="{Binding LinuxSetupIdle}"
                    AutomationProperties.AutomationId="EnablePredatorV4"
                    Command="{Binding EnablePredatorV4Command}" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding ShowLinuwuSense}" Margin="0,6,0,0">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.LinuxLinuwuTitle}" />
            <TextBlock Classes="hint" Text="{Binding Labels.LinuxLinuwuHint}" TextWrapping="Wrap" />
            <Button Content="{Binding Labels.LinuxLinuwuButton}" HorizontalAlignment="Left"
                    Command="{Binding OpenLinuwuSenseCommand}" />
          </StackPanel>

          <StackPanel Spacing="8" Margin="0,6,0,0">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.LinuxCaptureTitle}" />
            <TextBlock Classes="hint" Text="{Binding Labels.LinuxCaptureHint}" TextWrapping="Wrap" />
            <Button Content="{Binding Labels.LinuxCaptureButton}" HorizontalAlignment="Left"
                    IsEnabled="{Binding LinuxSetupIdle}"
                    AutomationProperties.AutomationId="SendLinuxInfo"
                    Command="{Binding SendLinuxInfoCommand}" />
          </StackPanel>

          <TextBlock Classes="hint" Text="{Binding LinuxSetupStatus}" TextWrapping="Wrap" FontWeight="SemiBold"
                     IsVisible="{Binding HasLinuxSetupStatus}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ NitroLite's own settings -->

      <!-- Language and typeface side by side, then the palettes. They are the settings a user changes once and then
           stops thinking about, so they do not belong above the tools the page exists for. No prose: a picker with a
           caption and a list is a picker a reader already understands. -->
      <Border Classes="card" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE713;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.NitroLiteSettings}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Classes="caps" Text="{Binding Labels.Language}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:LocLanguage">
                    <TextBlock Text="{Binding NativeName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- Each item is drawn in the face it names, and so is the closed box: the picker is its own preview, and a
                 font list written in one font tells a reader nothing about the other twelve. -->
            <StackPanel Grid.Column="1">
              <TextBlock Classes="caps" Text="{Binding Labels.UiFont}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding UiFonts}" SelectedItem="{Binding SelectedUiFont}"
                        HorizontalAlignment="Stretch" FontFamily="{Binding SelectedUiFont.Stack}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:UiFontChoice">
                    <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Stack}" FontSize="13" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>

          <TextBlock Classes="caps" Text="{Binding Labels.Theme}" Margin="0,14,0,6" />

          <!-- One card per palette, built from ThemeCatalog rather than written here, so adding a palette is still
               one enum member and one dictionary. The five swatches are the whole card: page, card, rule, ink and
               accent, in the order the palette defines them. -->
          <ItemsControl ItemsSource="{Binding ThemeCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeCardViewModel">
                <Button Classes="themecard" Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Label}"
                        Margin="0,0,8,8">
                  <StackPanel Width="120">
                    <ItemsControl ItemsSource="{Binding Swatches}" HorizontalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <Border Width="20" Height="20" CornerRadius="2" Margin="0,0,3,0"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardBorderStrongBrush}"
                                  Background="{Binding Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,6,0,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============================================================ support -->

      <!-- The last card. It replaced a "Notes" block that printed the probe's own diagnostics, which was a developer's
           note in a user's window. This one says who wrote the app and what it cost, which is the only thing that
           belongs at the bottom of a settings page. -->
      <Border Classes="card">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Classes="cardicon" Text="&#xEB51;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.Support}" />
          </StackPanel>

          <TextBlock Classes="body" Text="{Binding Labels.SupportBody}" />

          <WrapPanel Margin="0,10,0,0">
            <!-- The Ko-fi mark: a solid blue pill with the cup and the label, the shape people already know from
                 every other project's README. The cup is a Path, not an image, so the button costs no download and
                 stays crisp at any DPI. -->
            <Button Classes="kofi" Margin="0,0,6,6" Command="{Binding SupportKofiCommand}"
                    ToolTip.Tip="{Binding Labels.SupportKofi}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Canvas Width="14" Height="14" VerticalAlignment="Center">
                  <Path Fill="#FFFFFF" Data="M1,3.4 H11 V8.4 A3.4,3.4 0 0 1 7.6,11.8 H4.4 A3.4,3.4 0 0 1 1,8.4 Z" />
                  <Path Stroke="#FFFFFF" StrokeThickness="1.3" Data="M11,4.8 H12.1 A2.1,2.1 0 0 1 12.1,9 H11" />
                  <Path Stroke="#FFFFFF" StrokeThickness="1.1" StrokeLineCap="Round"
                        Data="M4.2,0.9 C5.4,1.7 3.4,2.3 4.6,3.1" />
                  <Path Stroke="#FFFFFF" StrokeThickness="1.1" StrokeLineCap="Round"
                        Data="M7.6,0.9 C8.8,1.7 6.8,2.3 8,3.1" />
                </Canvas>
                <TextBlock Text="{Binding Labels.SupportKofi}" Foreground="#FFFFFF" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- GitHub Sponsors: the heart in the programme's own pink, drawn as a Path for the same reason the cup
                 is. The button itself keeps the theme's colours, so it reads as the second way to give, not a second
                 brand block next to the Ko-fi one. -->
            <Button Margin="0,0,6,6" Padding="12,7" Command="{Binding SupportSponsorsCommand}"
                    ToolTip.Tip="{Binding Labels.SupportSponsors}"
                    AutomationProperties.Name="{Binding Labels.SupportSponsors}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Canvas Width="14" Height="14" VerticalAlignment="Center">
                  <Path Fill="#DB61A2"
                        Data="M7,12.6 C7,12.6 1.2,9.1 1.2,5.1 A3,3 0 0 1 7,3.9 A3,3 0 0 1 12.8,5.1 C12.8,9.1 7,12.6 7,12.6 Z" />
                </Canvas>
                <TextBlock Text="{Binding Labels.SupportSponsors}" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="primary" Content="{Binding Labels.SupportGitHub}" Margin="0,0,6,6" Padding="12,7"
                    FontSize="11" Command="{Binding SupportGitHubCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
