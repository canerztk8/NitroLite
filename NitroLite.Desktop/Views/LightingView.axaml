<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             xmlns:conv="using:NitroLite.Desktop.Converters"
             xmlns:core="using:NitroLite.Core"
             x:Class="NitroLite.Desktop.Views.LightingView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!--
      The rainbow the deck shows for an effect that paints its own colours. A gradient rather than four fixed hues,
      because the point is "this effect ignores your colour", and four hues would read as four chosen colours.
    -->
    <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#FF0000" />
      <GradientStop Offset="0.25" Color="#FFAA00" />
      <GradientStop Offset="0.5" Color="#00FFA3" />
      <GradientStop Offset="0.75" Color="#00E5FF" />
      <GradientStop Offset="1" Color="#BD00FF" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <!--
    Page 3: the keyboard. The four-zone deck leads — the four bars on a darker ground with thin key rows under them, so
    the block reads as a keyboard rather than as four swatches — then the quick palette, then the temperature mode,
    then the saved profiles, then the effect and its two sliders. The palette sits above everything that stores a
    colour because a colour is the thing a user reaches for first; the temperature ramps sit with the profiles because
    they are the other way of answering the same question — which colour the keyboard shows — and a saved profile is
    what the mode falls back to when it is switched off.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <TextBlock Classes="pagetitle" Text="{Binding Labels.LightingPageTitle}" TextWrapping="Wrap"
                   Margin="0,0,16,0" />
        <Button Grid.Column="1" Classes="primary" Content="{Binding Labels.TurnOffLighting}" Padding="12,6"
                FontSize="11" VerticalAlignment="Center" IsEnabled="{Binding LightingAvailable}"
                Command="{Binding TurnOffLightingCommand}" />
      </Grid>

      <!-- ============================================================ the four-zone deck -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="rowtitle" Text="{Binding Labels.ZonePreview}" Margin="0,0,0,10" />

          <Border Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10,10,10,8">
            <StackPanel>
              <UniformGrid Columns="4">
                <StackPanel Margin="0,0,6,0">
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone1Active}" Tag="1"
                          PointerPressed="OnZonePressed"
                          Background="{Binding Zone1, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone1Active}" Tag="1"
                          PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone1}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="3,0">
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone2Active}" Tag="2"
                          PointerPressed="OnZonePressed"
                          Background="{Binding Zone2, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone2Active}" Tag="2"
                          PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone2}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="3,0">
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone3Active}" Tag="3"
                          PointerPressed="OnZonePressed"
                          Background="{Binding Zone3, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone3Active}" Tag="3"
                          PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone3}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone4Active}" Tag="4"
                          PointerPressed="OnZonePressed"
                          Background="{Binding Zone4, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Classes.zoneactive="{Binding IsZone4Active}" Tag="4"
                          PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone4}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
              </UniformGrid>

              <!-- The key rows: decoration only, never a click target. They are what turns four bars into a deck. -->
              <StackPanel Margin="0,10,0,0" Spacing="4" IsHitTestVisible="False">
                <Grid ColumnDefinitions="*,*,*,*" Height="4">
                  <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                  <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*" Height="4">
                  <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                  <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="hint" Text="{Binding ZonePreviewNote}" Margin="3,8,3,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasZonePreviewNote}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ the quick palette -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE790;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.ColorPalette}" />
            <Border Classes="pill" Margin="10,0,0,0">
              <TextBlock Text="{Binding ActiveZoneText}" />
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <ItemsControl ItemsSource="{Binding ColorPalette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColorSwatch">
                  <Button Classes="swatch" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}">
                    <Border Width="24" Height="24" CornerRadius="2"
                            Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                            BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              The picker. The eight swatches are the colours that read well on both palettes; this is every colour
              there is, and it sits immediately left of the hex box so the two ways of naming a colour are adjacent.
              It shows the active target's colour, so it doubles as the readout for whichever zone the deck focused.
              The rule before it is what keeps it from reading as a ninth swatch.
            -->
            <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="2,2" />

            <Button Classes="swatch" Width="28" Height="28" Click="OnPickColorClick"
                    AutomationProperties.AutomationId="PickColor"
                    ToolTip.Tip="{Binding Labels.CustomColor}">
              <Border Width="24" Height="24" CornerRadius="2"
                      Background="{Binding ActiveColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                      BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1" />
            </Button>

            <TextBox Width="110" Text="{Binding ActiveColor}" Watermark="#00E5FF"
                     AutomationProperties.AutomationId="ActiveColorHex" />

            <Button Classes="primary" Content="{Binding Labels.ApplyToAllZones}" Padding="12,7" FontSize="11"
                    Command="{Binding ApplyAllZonesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ temp-reactive lighting -->

      <!--
        The colour that follows the processor. It sits here, directly over the saved profiles, because it is a way of
        choosing a colour rather than a subject of its own: the three ramps are shapes the app offers, and the custom
        entry is the shape the user builds stop by stop. It is not hidden behind a capability flag: the flag comes
        from a WMI probe that needs elevation and answers "no keyboard" without it, which hid this card on the machine
        it was written for.
      -->
      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.ReactiveLighting}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding ReactiveLightingEnabled}"
                          VerticalAlignment="Center" AutomationProperties.AutomationId="ReactiveLighting" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Labels.ReactiveLightingHint}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />

          <!-- The live reading: what the keyboard is showing now, and the number that produced it. -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"
                      IsVisible="{Binding ReactiveLightingEnabled}">
            <Border Width="26" Height="26" CornerRadius="2"
                    Background="{Binding ReactiveLightingColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
            <TextBlock Classes="hint" Text="{Binding ReactiveLightingNow}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- The three ramps, each painted as the gradient it is, then the entry the user builds. -->
          <TextBlock Classes="caps" Text="{Binding Labels.ReactiveProfiles}" Margin="0,14,0,6" />
          <ItemsControl ItemsSource="{Binding ReactiveProfileChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReactiveProfileChoice">
                <Button Classes="ramp" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                        Margin="0,0,8,8">
                  <StackPanel Width="118" Spacing="6">
                    <Border Height="8" CornerRadius="2"
                            Background="{Binding Stops, Converter={x:Static conv:RampToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The custom ramp's editor: one row per stop, a temperature and the colour held there. -->
          <StackPanel IsVisible="{Binding ReactiveCustomEditorVisible}" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caps" Text="{Binding Labels.ReactiveStops}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="seg" Content="{Binding Labels.AddReactiveStop}" Padding="10,4"
                      FontSize="11" Command="{Binding AddReactiveStopCommand}" />
            </Grid>

            <TextBlock Classes="hint" Text="{Binding Labels.ReactiveCustomHint}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding ReactiveStops}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReactiveStopViewModel">
                  <Grid ColumnDefinitions="46,*,Auto,92,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Classes="figure" FontSize="11" Text="{Binding TemperatureText}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <controls:NitroSlider Grid.Column="1" Minimum="{Binding MinTemperature}"
                                          Maximum="{Binding MaxTemperature}" TickFrequency="1"
                                          IsSnapToTickEnabled="True" Value="{Binding TemperatureC}"
                                          VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="swatch" Width="26" Height="26" Margin="10,0,0,0"
                            Tag="{Binding}" Click="OnPickReactiveStopColor" ToolTip.Tip="{Binding PickLabel}">
                      <Border Width="22" Height="22" CornerRadius="2"
                              Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                              BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                    </Button>
                    <TextBox Grid.Column="3" Margin="8,0" Text="{Binding Color}" Watermark="#00B4FF" />
                    <Button Grid.Column="4" Classes="seg" Content="{Binding RemoveLabel}" Padding="8,3"
                            FontSize="10" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ saved profiles -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="rowtitle" Text="{Binding Labels.RgbProfiles}" Margin="0,0,0,10" />

          <Grid ColumnDefinitions="*,*,Auto,Auto">
            <ComboBox ItemsSource="{Binding RgbProfiles}" SelectedItem="{Binding SelectedRgbProfile}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:RgbPreset">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="1" Margin="10,0" Text="{Binding NewProfileName}"
                     Watermark="{Binding Labels.ProfileName}" />

            <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.SaveProfile}"
                    Padding="12,7" FontSize="11" Command="{Binding SaveRgbProfileCommand}" />
            <!-- The factory profiles and the custom entry are not the user's to delete: the button is disabled
                 for them rather than firing into a refusal the list has to explain afterwards. -->
            <Button Grid.Column="3" Classes="danger" Content="{Binding Labels.DeleteProfile}"
                    Padding="12,7" FontSize="11" Margin="6,0,0,0"
                    IsEnabled="{Binding CanDeleteRgbProfile}"
                    Command="{Binding DeleteRgbProfileCommand}" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding RgbProfileStatus}" Margin="0,8,0,0"
                     IsVisible="{Binding HasRgbProfileStatus}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ effect and its sliders -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Classes="caps" Text="{Binding Labels.Effects}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EffectChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel IsVisible="{Binding ShowDirectionPanel}" Margin="0,12,0,0">
                <TextBlock Classes="caps" Text="{Binding Labels.EffectDirection}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding SelectedDirection}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DirectionChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Brightness}" />
                <TextBlock Grid.Column="1" Text="{Binding BrightnessLabel}" FontWeight="Bold"
                           FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}" />
              </Grid>
              <controls:NitroSlider Minimum="0" Maximum="{Binding MaxBrightness}" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding BrightnessLevel}" Margin="0,4,0,0" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="caps" Text="{Binding Labels.EffectSpeed}" />
                <TextBlock Grid.Column="1" Text="{Binding SpeedLabel}" FontWeight="Bold"
                           FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}" />
              </Grid>
              <controls:NitroSlider Minimum="1" Maximum="{Binding MaxSpeed}" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding SpeedLevel}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============================================================ the extra switches -->

      <Border Classes="card" IsVisible="{Binding ShowExtrasCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE7E8;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.Extras}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding BacklightTimeoutAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding BacklightTimeoutOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.BacklightTimeoutHint}" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding CoolBoostAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding CoolBoostOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.CoolBoost}" Margin="8,0,0,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding LcdOverdriveAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding LcdOverdriveOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.LcdOverdrive}" Margin="8,0,0,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding WinKeyLockAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding WinKeyLockOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.WinKeyLock}" Margin="8,0,0,0" />
          </StackPanel>

          <!-- Nothing to switch: one line instead of an empty grey box. -->
          <TextBlock Classes="hint" Text="{Binding Labels.NotOnThisMachine}"
                     IsVisible="{Binding NoExtrasAvailable}" />

          <!-- The third lighting path's state. Hidden until the SDK has actually been asked. -->
          <TextBlock Classes="hint" Text="{Binding OpenRgbStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasOpenRgbStatus}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
