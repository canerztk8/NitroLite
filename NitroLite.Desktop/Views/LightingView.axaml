<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             xmlns:conv="using:NitroLite.Desktop.Converters"
             xmlns:core="using:NitroLite.Core"
             x:Class="NitroLite.Desktop.Views.LightingView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!--
      The rainbow the deck shows for an effect that paints its own colours. A gradient rather than four fixed hues,
      because the point is "this effect ignores your colour", and four hues would read as four chosen colours.
    -->
    <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#FF2A55" />
      <GradientStop Offset="0.25" Color="#FFAA00" />
      <GradientStop Offset="0.5" Color="#00FFA3" />
      <GradientStop Offset="0.75" Color="#00E5FF" />
      <GradientStop Offset="1" Color="#BD00FF" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <!--
    Page 3: the keyboard. The WPF page led with the four-zone deck — the four bars on a darker ground with thin key
    rows under them, so the block reads as a keyboard rather than as four swatches — then the saved profiles, then the
    quick palette, then the effect and its two sliders. Same order here.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <TextBlock Classes="pagetitle" Text="{Binding Labels.LightingPageTitle}" TextWrapping="Wrap"
                   Margin="0,0,16,0" />
        <Button Grid.Column="1" Classes="primary" Content="{Binding Labels.TurnOffLighting}" Padding="12,6"
                FontSize="11" VerticalAlignment="Center" IsEnabled="{Binding LightingAvailable}"
                Command="{Binding TurnOffLightingCommand}" />
      </Grid>

      <!-- ============================================================ the four-zone deck -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="rowtitle" Text="{Binding Labels.ZonePreview}" Margin="0,0,0,10" />

          <Border Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10,10,10,8">
            <StackPanel>
              <UniformGrid Columns="4">
                <StackPanel Margin="0,0,6,0">
                  <Border Classes="zone" Tag="1" PointerPressed="OnZonePressed"
                          Background="{Binding Zone1, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Tag="1" PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone1}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="3,0">
                  <Border Classes="zone" Tag="2" PointerPressed="OnZonePressed"
                          Background="{Binding Zone2, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Tag="2" PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone2}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="3,0">
                  <Border Classes="zone" Tag="3" PointerPressed="OnZonePressed"
                          Background="{Binding Zone3, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Tag="3" PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone3}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="6,0,0,0">
                  <Border Classes="zone" Tag="4" PointerPressed="OnZonePressed"
                          Background="{Binding Zone4, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          IsVisible="{Binding ZoneSolid}" />
                  <Border Classes="zone" Tag="4" PointerPressed="OnZonePressed"
                          Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                  <TextBlock Classes="caps" Text="{Binding Labels.Zone4}" HorizontalAlignment="Center"
                             Margin="0,6,0,0" />
                </StackPanel>
              </UniformGrid>

              <!-- The key rows: decoration only, never a click target. They are what turns four bars into a deck. -->
              <StackPanel Margin="0,10,0,0" Spacing="4" IsHitTestVisible="False">
                <Grid ColumnDefinitions="*,*,*,*" Height="4">
                  <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                  <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*" Height="4">
                  <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                  <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                  <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="hint" Text="{Binding ZonePreviewNote}" Margin="3,8,3,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasZonePreviewNote}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ saved profiles -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="rowtitle" Text="{Binding Labels.RgbProfiles}" Margin="0,0,0,10" />

          <Grid ColumnDefinitions="*,*,Auto,Auto,Auto">
            <ComboBox ItemsSource="{Binding RgbProfiles}" SelectedItem="{Binding SelectedRgbProfile}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:RgbPreset">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="1" Margin="10,0" Text="{Binding NewProfileName}"
                     Watermark="{Binding Labels.ProfileName}" />

            <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.Apply}"
                    Padding="12,7" FontSize="11" Command="{Binding ApplyRgbProfileCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="{Binding Labels.SaveProfile}"
                    Padding="12,7" FontSize="11" Margin="6,0,0,0" Command="{Binding SaveRgbProfileCommand}" />
            <Button Grid.Column="4" Classes="danger" Content="{Binding Labels.DeleteProfile}"
                    Padding="12,7" FontSize="11" Margin="6,0,0,0"
                    Command="{Binding DeleteRgbProfileCommand}" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding RgbProfileStatus}" Margin="0,8,0,0"
                     IsVisible="{Binding HasRgbProfileStatus}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ the quick palette -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE790;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.ColorPalette}" />
            <Border Classes="pill" Margin="10,0,0,0">
              <TextBlock Text="{Binding ActiveZoneText}" />
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <ItemsControl ItemsSource="{Binding ColorPalette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColorSwatch">
                  <Button Classes="swatch" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}">
                    <Border Width="24" Height="24" CornerRadius="2"
                            Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                            BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Width="110" Text="{Binding PrimaryColor}" Watermark="#00E5FF" />

            <Button Classes="primary" Content="{Binding Labels.CustomColor}" Padding="12,7" FontSize="11"
                    Command="{Binding CustomColorCommand}" />
            <Button Classes="primary" Content="{Binding Labels.ApplyToAllZones}" Padding="12,7" FontSize="11"
                    Command="{Binding ApplyAllZonesCommand}" />
          </StackPanel>

          <!-- Which zone the palette writes to. The four buttons are the same choice the deck above shows. -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
            <Button Classes="seg" Classes.selected="{Binding IsPrimaryZoneActive}"
                    Command="{Binding SelectPrimaryZoneCommand}" Content="{Binding Labels.PrimaryColor}" />
            <Button Classes="seg" Classes.selected="{Binding IsZone1Active}"
                    Command="{Binding SelectZone1Command}" Content="{Binding Labels.Zone1}" />
            <Button Classes="seg" Classes.selected="{Binding IsZone2Active}"
                    Command="{Binding SelectZone2Command}" Content="{Binding Labels.Zone2}" />
            <Button Classes="seg" Classes.selected="{Binding IsZone3Active}"
                    Command="{Binding SelectZone3Command}" Content="{Binding Labels.Zone3}" />
            <Button Classes="seg" Classes.selected="{Binding IsZone4Active}"
                    Command="{Binding SelectZone4Command}" Content="{Binding Labels.Zone4}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ effect and its sliders -->

      <Border Classes="card" Margin="0,0,0,16">
        <StackPanel>
          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Classes="caps" Text="{Binding Labels.Effects}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EffectChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel IsVisible="{Binding ShowDirectionPanel}" Margin="0,12,0,0">
                <TextBlock Classes="caps" Text="{Binding Labels.EffectDirection}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding SelectedDirection}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DirectionChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Brightness}" />
                <TextBlock Grid.Column="1" Text="{Binding BrightnessLabel}" FontWeight="Bold"
                           FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}" />
              </Grid>
              <controls:NitroSlider Minimum="0" Maximum="{Binding MaxBrightness}" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding BrightnessLevel}" Margin="0,4,0,0" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Classes="caps" Text="{Binding Labels.EffectSpeed}" />
                <TextBlock Grid.Column="1" Text="{Binding SpeedLabel}" FontWeight="Bold"
                           FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}" />
              </Grid>
              <controls:NitroSlider Minimum="1" Maximum="{Binding MaxSpeed}" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding SpeedLevel}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============================================================ the extra switches -->

      <Border Classes="card" IsVisible="{Binding ShowExtrasCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Classes="cardicon" Text="&#xE7E8;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.Extras}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding BacklightTimeoutAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding BacklightTimeoutOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.BacklightTimeoutHint}" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding CoolBoostAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding CoolBoostOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.CoolBoost}" Margin="8,0,0,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding LcdOverdriveAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding LcdOverdriveOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.LcdOverdrive}" Margin="8,0,0,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsVisible="{Binding WinKeyLockAvailable}">
            <ToggleButton Classes="toggle" IsChecked="{Binding WinKeyLockOn}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.WinKeyLock}" Margin="8,0,0,0" />
          </StackPanel>

          <!-- Nothing to switch: one line instead of an empty grey box. -->
          <TextBlock Classes="hint" Text="{Binding Labels.NotOnThisMachine}"
                     IsVisible="{Binding NoExtrasAvailable}" />

          <!-- The third lighting path's state. Hidden until the SDK has actually been asked. -->
          <TextBlock Classes="hint" Text="{Binding OpenRgbStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasOpenRgbStatus}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
