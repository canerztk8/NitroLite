<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             xmlns:conv="using:NitroLite.Desktop.Converters"
             xmlns:core="using:NitroLite.Core"
             x:Class="NitroLite.Desktop.Views.LightingView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!--
      The rainbow the deck shows for an effect that paints its own colours. A gradient rather than four fixed hues,
      because the point is "this effect ignores your colour", and four hues would read as four chosen colours.
    -->
    <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#FF0000" />
      <GradientStop Offset="0.25" Color="#FFAA00" />
      <GradientStop Offset="0.5" Color="#00FFA3" />
      <GradientStop Offset="0.75" Color="#00E5FF" />
      <GradientStop Offset="1" Color="#BD00FF" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <!--
    Page 3: the keyboard. The four-zone deck leads — the four bars on a darker ground with thin key rows under them, so
    the block reads as a keyboard rather than as four swatches — then the quick palette, then the saved profiles, then
    the effect and its two sliders, and finally the two automatic colours: the temperature ramp and the charging colour.
    The palette sits above everything that stores a colour because a colour is the thing a user reaches for first; the
    temperature ramps sit with the profiles because they are the other way of answering the same question — which
    colour the keyboard shows — and a saved profile is what the mode falls back to when it is switched off.

    The header carries the two switches that belong to the keyboard rather than to a colour: the 30-second timeout and
    the blackout. The blackout is the page's own off switch: while it is on, the body below is disabled and covered,
    because a page full of controls over a dark keyboard is a page that promises writes the firmware will not make.
  -->
  <Grid RowDefinitions="Auto,*">

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Classes="pagetitle" Text="{Binding Labels.LightingPageTitle}" TextWrapping="Wrap"
                 Margin="0,0,16,0" />

      <!--
        The 30-second timeout, moved out of the extras card and into the header: it is a keyboard switch, like the
        blackout beside it, and the sentence that explains it is the tooltip rather than a line that would push the
        page title off the row.
      -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  Margin="0,0,14,0" IsVisible="{Binding BacklightTimeoutAvailable}"
                  ToolTip.Tip="{Binding Labels.BacklightTimeoutHint}">
        <TextBlock Classes="caps" Text="{Binding Labels.BacklightTimeoutShort}" VerticalAlignment="Center" />
        <ToggleButton Classes="toggle" IsChecked="{Binding BacklightTimeoutOn}" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="BacklightTimeout"
                      AutomationProperties.Name="{Binding Labels.BacklightTimeout}" />
      </StackPanel>

      <Button Grid.Column="2" Classes="primary" Classes.on="{Binding IsLightingBlackedOut}"
              Content="{Binding LightingBlackoutButtonText}" Padding="12,6" FontSize="11"
              VerticalAlignment="Center" IsEnabled="{Binding LightingAvailable}"
              AutomationProperties.AutomationId="LightingBlackout"
              Command="{Binding ToggleLightingBlackoutCommand}" />
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" IsEnabled="{Binding LightingControlsEnabled}">
        <StackPanel>

          <!-- ============================================================ the four-zone deck -->

          <Border Classes="card" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Classes="rowtitle" Text="{Binding Labels.ZonePreview}" Margin="0,0,0,10" />

              <Border Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="10,10,10,8">
                <StackPanel>
                  <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,6,0">
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone1Active}" Tag="1"
                              PointerPressed="OnZonePressed"
                              Background="{Binding Zone1Preview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                              IsVisible="{Binding ZoneSolid}" />
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone1Active}" Tag="1"
                              PointerPressed="OnZonePressed"
                              Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                      <TextBlock Classes="caps" Text="{Binding Labels.Zone1}" HorizontalAlignment="Center"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Margin="3,0">
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone2Active}" Tag="2"
                              PointerPressed="OnZonePressed"
                              Background="{Binding Zone2Preview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                              IsVisible="{Binding ZoneSolid}" />
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone2Active}" Tag="2"
                              PointerPressed="OnZonePressed"
                              Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                      <TextBlock Classes="caps" Text="{Binding Labels.Zone2}" HorizontalAlignment="Center"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Margin="3,0">
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone3Active}" Tag="3"
                              PointerPressed="OnZonePressed"
                              Background="{Binding Zone3Preview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                              IsVisible="{Binding ZoneSolid}" />
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone3Active}" Tag="3"
                              PointerPressed="OnZonePressed"
                              Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                      <TextBlock Classes="caps" Text="{Binding Labels.Zone3}" HorizontalAlignment="Center"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone4Active}" Tag="4"
                              PointerPressed="OnZonePressed"
                              Background="{Binding Zone4Preview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                              IsVisible="{Binding ZoneSolid}" />
                      <Border Classes="zone" Classes.zoneactive="{Binding IsZone4Active}" Tag="4"
                              PointerPressed="OnZonePressed"
                              Background="{StaticResource RainbowBrush}" IsVisible="{Binding ZoneRainbow}" />
                      <TextBlock Classes="caps" Text="{Binding Labels.Zone4}" HorizontalAlignment="Center"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                  </UniformGrid>

                  <!-- The key rows: decoration only, never a click target. They are what turns four bars into a deck. -->
                  <StackPanel Margin="0,10,0,0" Spacing="4" IsHitTestVisible="False">
                    <Grid ColumnDefinitions="*,*,*,*" Height="4">
                      <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                      <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                      <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                      <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" Height="4">
                      <Border Grid.Column="0" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="0,0,6,0" />
                      <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                      <Border Grid.Column="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="3,0" />
                      <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="6,0,0,0" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Classes="hint" Text="{Binding ZonePreviewNote}" Margin="3,8,3,0" TextWrapping="Wrap"
                         IsVisible="{Binding HasZonePreviewNote}" />
            </StackPanel>
          </Border>

          <!-- ============================================================ the quick palette -->

          <Border Classes="card" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Classes="cardicon" Text="&#xE790;" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Classes="section" Text="{Binding Labels.ColorPalette}" />
                <Border Classes="pill" Margin="10,0,0,0">
                  <TextBlock Text="{Binding ActiveZoneText}" />
                </Border>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <ItemsControl ItemsSource="{Binding ColorPalette}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                      <Button Classes="swatch" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}"
                              AutomationProperties.Name="{Binding Name}">
                        <Border Width="24" Height="24" CornerRadius="2"
                                Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                  The picker. The eight swatches are the colours that read well on both palettes; this is every colour
                  there is, and it sits immediately left of the hex box so the two ways of naming a colour are adjacent.
                  It shows the active target's colour, so it doubles as the readout for whichever zone the deck focused.
                  The rule before it is what keeps it from reading as a ninth swatch.
                -->
                <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="2,2" />

                <Button Classes="swatch" Width="28" Height="28" Click="OnPickColorClick"
                        AutomationProperties.AutomationId="PickColor"
                        ToolTip.Tip="{Binding Labels.CustomColor}">
                  <Border Width="24" Height="24" CornerRadius="2"
                          Background="{Binding ActiveColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1" />
                </Button>

                <TextBox Width="110" Text="{Binding ActiveColor}" Watermark="#00E5FF"
                         AutomationProperties.AutomationId="ActiveColorHex" />

                <Button Classes="primary" Content="{Binding Labels.ApplyToAllZones}" Padding="12,7" FontSize="11"
                        Command="{Binding ApplyAllZonesCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ============================================================ saved profiles -->

          <Border Classes="card" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Classes="rowtitle" Text="{Binding Labels.RgbProfiles}" Margin="0,0,0,10" />

              <Grid ColumnDefinitions="*,*,Auto,Auto">
                <ComboBox ItemsSource="{Binding RgbProfiles}" SelectedItem="{Binding SelectedRgbProfile}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:RgbPreset">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="1" Margin="10,0" Text="{Binding NewProfileName}"
                         Watermark="{Binding Labels.ProfileName}" />

                <Button Grid.Column="2" Classes="primary" Content="{Binding Labels.SaveProfile}"
                        Padding="12,7" FontSize="11" Command="{Binding SaveRgbProfileCommand}" />
                <!-- The factory profiles and the custom entry are not the user's to delete: the button is disabled
                     for them rather than firing into a refusal the list has to explain afterwards. -->
                <Button Grid.Column="3" Classes="danger" Content="{Binding Labels.DeleteProfile}"
                        Padding="12,7" FontSize="11" Margin="6,0,0,0"
                        IsEnabled="{Binding CanDeleteRgbProfile}"
                        Command="{Binding DeleteRgbProfileCommand}" />
              </Grid>

              <TextBlock Classes="hint" Text="{Binding RgbProfileStatus}" Margin="0,8,0,0"
                         IsVisible="{Binding HasRgbProfileStatus}" />
            </StackPanel>
          </Border>

          <!-- ============================================================ effect and its sliders -->

          <Border Classes="card" Margin="0,0,0,16">
            <StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Classes="caps" Text="{Binding Labels.Effects}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EffectChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <StackPanel IsVisible="{Binding ShowDirectionPanel}" Margin="0,12,0,0">
                    <TextBlock Classes="caps" Text="{Binding Labels.EffectDirection}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding SelectedDirection}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DirectionChoice">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caps" Text="{Binding Labels.Brightness}" />
                    <TextBlock Grid.Column="1" Text="{Binding BrightnessLabel}" FontWeight="Bold"
                               FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Grid>
                  <controls:NitroSlider Minimum="0" Maximum="{Binding MaxBrightness}" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding BrightnessLevel}" Margin="0,4,0,0" />

                  <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <TextBlock Classes="caps" Text="{Binding Labels.EffectSpeed}" />
                    <TextBlock Grid.Column="1" Text="{Binding SpeedLabel}" FontWeight="Bold"
                               FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Grid>
                  <controls:NitroSlider Minimum="1" Maximum="{Binding MaxSpeed}" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding SpeedLevel}" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ============================================================ temp-reactive lighting -->

          <!--
            The colour that follows the processor. It sits last with the charging colour, after the controls that hold a
            colour of the user's own, because it is the other way of answering "which colour does the keyboard show" —
            and it is what the extras card used to occupy: the two automatic colours are the special modes, the saved
            profile is where they fall back to when they are switched off. It is not hidden behind a capability flag:
            the flag comes from a WMI probe that needs elevation and answers "no keyboard" without it, which hid this
            card on the machine it was written for.

            The card is disabled while the effect list stands on OFF, and its switch goes off with it: neither mode
            paints a keyboard that takes no colour, and a switch left on over one promises a write the firmware will not
            make. The preference stays in the settings file, so picking a lit effect again brings the mode back.
          -->
          <Border Classes="card" Margin="0,0,0,16" IsEnabled="{Binding AutomaticColoursEnabled}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.ReactiveLighting}" VerticalAlignment="Center" />

                <!--
                  What the keys are showing, in the header: two swatches while the halves follow different sensors, one
                  otherwise, and only while the mode is on. It used to be a row of its own in the middle of the card,
                  under a line naming the sensors that the tiles below already name.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ReactiveLightingEnabled}"
                              ToolTip.Tip="{Binding ReactiveLightingNow}">
                    <Border Width="22" Height="22" CornerRadius="2"
                            Background="{Binding ReactiveLightingColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                            BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                    <Border Width="22" Height="22" CornerRadius="2" IsVisible="{Binding ReactiveSplit}"
                            Background="{Binding ReactiveLightingColorRight, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                            BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                  </StackPanel>
                  <ToggleButton Classes="toggle" IsChecked="{Binding ReactiveLightingEnabled}"
                                VerticalAlignment="Center" AutomationProperties.AutomationId="ReactiveLighting" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="hint" Text="{Binding Labels.ReactiveLightingHint}" Margin="0,8,0,0"
                         TextWrapping="Wrap" />

              <!--
                One band, two questions: which sensor paints, and how the two halves meet. They used to be two blocks,
                each with a caption and a paragraph under it, which is what made the card read as a panel of switches
                rather than as a choice between two sensors. The split chips sit beside the sensors because they only
                mean anything once both are on, and they stay in place (disabled rather than removed) with one.
              -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="caps" Text="{Binding Labels.ReactiveSensorsTitle}"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="caps" Text="{Binding Labels.ReactiveSplitMode}"
                           HorizontalAlignment="Right" Margin="16,0,0,6" />

                <StackPanel Grid.Row="1" Grid.Column="0">
                  <!-- The two halves sit side by side: they are a pair, and stacking them doubled the card's height. -->
                  <Grid ColumnDefinitions="*,*">
                    <Border Classes="sensor" Classes.off="{Binding !ReactiveCpuSensor}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                IsVisible="{Binding ReactiveCpuSensor}"
                                Background="{Binding ReactiveLightingColor, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                          <TextBlock Classes="caps" Text="CPU" VerticalAlignment="Center" />
                          <TextBlock Classes="figurebig" Text="{Binding ReactiveCpuReading}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ReactiveCpuSensor}"
                                      AutomationProperties.AutomationId="ReactiveSensorCpu"
                                      AutomationProperties.Name="{Binding Labels.ReactiveCpuSwitch}" />
                      </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="sensor" Classes.off="{Binding !ReactiveGpuSensor}"
                            Margin="8,0,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                IsVisible="{Binding ReactiveGpuSensor}"
                                Background="{Binding ReactiveLightingColorRight, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                          <TextBlock Classes="caps" Text="GPU" VerticalAlignment="Center" />
                          <TextBlock Classes="figurebig" Text="{Binding ReactiveGpuReading}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Classes="toggle" VerticalAlignment="Center"
                                      IsChecked="{Binding ReactiveGpuSensor}"
                                      AutomationProperties.AutomationId="ReactiveSensorGpu"
                                      AutomationProperties.Name="{Binding Labels.ReactiveGpuSwitch}" />
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding ReactiveSplit}">
                    <Button Classes="seg" Classes.selected="{Binding ReactiveSplitEven}"
                            Content="{Binding Labels.ReactiveSplitEven}"
                            Command="{Binding SelectReactiveSplitEvenCommand}"
                            AutomationProperties.AutomationId="ReactiveSplitEven"
                            AutomationProperties.Name="{Binding Labels.ReactiveSplitEven}" />
                    <Button Classes="seg" Classes.selected="{Binding ReactiveSplitBlend}"
                            Content="{Binding Labels.ReactiveSplitBlend}"
                            Command="{Binding SelectReactiveSplitBlendCommand}"
                            AutomationProperties.AutomationId="ReactiveSplitBlend"
                            AutomationProperties.Name="{Binding Labels.ReactiveSplitBlend}" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!--
                One line, chosen by the state it describes: nothing selected is the one answer that is a warning, and
                with both halves live the sentence that matters is how they meet, not how a lone sensor behaves. Three
                boxes share one cell, so the card never carries two paragraphs of help at once.
              -->
              <Grid Margin="0,8,0,0">
                <TextBlock Classes="hint" Text="{Binding Labels.ReactiveNoSensor}"
                           IsVisible="{Binding !HasReactiveSensors}"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding Labels.ReactiveSplitHint}"
                           IsVisible="{Binding ReactiveSplit}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding Labels.ReactiveSensorsHint}"
                           IsVisible="{Binding ReactiveSingleSensor}" TextWrapping="Wrap" />
              </Grid>

              <!--
                The level this mode paints at. Its own slider: the page's brightness belongs to the colour the user chose,
                and a temperature colour that followed it would dim and brighten with a different control. It stays on the
                card while the mode is off - disabled rather than hidden - because this is the control the user comes here
                for, and a card that grows a slider when a switch is flipped is a card that has to be read twice.
              -->
              <StackPanel Margin="0,12,0,0" Classes="gated" Classes.off="{Binding !ReactiveLightingEnabled}"
                          IsEnabled="{Binding ReactiveLightingEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caps" Text="{Binding Labels.ReactiveBrightnessTitle}" />
                  <TextBlock Grid.Column="1" Text="{Binding ReactiveBrightnessLabel}" FontWeight="Bold" FontSize="11"
                             HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                </Grid>
                <controls:NitroSlider Minimum="1" Maximum="{Binding MaxBrightness}" TickFrequency="1"
                                      IsSnapToTickEnabled="True" Value="{Binding ReactiveBrightness}" Margin="0,4,0,0"
                                      AutomationProperties.AutomationId="ReactiveBrightness" />
              </StackPanel>

              <!--
                The section title, and the half the chips below it belong to. The chips sit in this header rather than
                beside the temperature rows, because the ramp is the only thing they can change: the colours of the two
                halves are set by the readings above, and the shape they meet in is set by the split chips.
              -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,6">
                <TextBlock Classes="caps" Text="{Binding ReactiveRampCaption}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsEnabled="{Binding ReactiveSplit}">
                  <Button Classes="seg" Classes.selected="{Binding ReactiveRampForCpu}"
                          Content="{Binding Labels.ReactiveRampCpuChip}"
                          Padding="9,2" FontSize="10"
                          Command="{Binding SelectReactiveRampForCpuCommand}"
                          AutomationProperties.AutomationId="ReactiveRampForCpu"
                          AutomationProperties.Name="{Binding Labels.ReactiveRampForCpu}" />
                  <Button Classes="seg" Classes.selected="{Binding ReactiveRampForGpu}"
                          Content="{Binding Labels.ReactiveRampGpuChip}"
                          Padding="9,2" FontSize="10"
                          Command="{Binding SelectReactiveRampForGpuCommand}"
                          AutomationProperties.AutomationId="ReactiveRampForGpu"
                          AutomationProperties.Name="{Binding Labels.ReactiveRampForGpu}" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding ReactiveProfileChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!--
                      Four to a row rather than a wrap of fixed-width cards: seven chips used to break 5 + 2 and leave
                      half the row empty, which read as two groups of ramps rather than one list. A uniform row keeps
                      the preview bars the same width, so they can be compared at a glance.
                    -->
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReactiveProfileChoice">
                    <Button Classes="ramp" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                            Margin="0,0,8,8" AutomationProperties.Name="{Binding Label}">
                      <StackPanel Spacing="6">
                        <Border Height="8" CornerRadius="2"
                                Background="{Binding Stops, Converter={x:Static conv:RampToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" MinHeight="30" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!--
                The solid entry's colour: one colour whatever the temperature is, for a half that should say "processor"
                or "graphics" rather than "61 °C". The same eight swatches as the rest of the page, the picker, and a hex
                box, so it is chosen the way every other colour here is chosen.
              -->
              <StackPanel IsVisible="{Binding ReactiveSolidVisible}" Margin="0,6,0,0">
                <TextBlock Classes="hint" Text="{Binding Labels.ReactiveSolidHint}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                  <ItemsControl ItemsSource="{Binding ReactiveSolidChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ColorSwatch">
                        <Button Classes="swatch" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}"
                              AutomationProperties.Name="{Binding Name}">
                          <Border Width="24" Height="24" CornerRadius="2"
                                  Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                  BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="2,2" />

                  <Button Classes="swatch" Width="28" Height="28" Click="OnPickReactiveSolidColor"
                          AutomationProperties.AutomationId="PickReactiveSolidColor"
                          ToolTip.Tip="{Binding Labels.CustomColor}">
                    <Border Width="24" Height="24" CornerRadius="2"
                            Background="{Binding ReactiveSolidPreview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                            BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1" />
                  </Button>

                  <TextBox Width="110" Text="{Binding ReactiveSolidColor}" Watermark="#00B4FF"
                           AutomationProperties.AutomationId="ReactiveSolidColorHex" />
                </StackPanel>
              </StackPanel>

              <!-- The custom ramp's editor: one row per stop, a temperature and the colour held there. -->
              <StackPanel IsVisible="{Binding ReactiveCustomEditorVisible}" Margin="0,6,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caps" Text="{Binding Labels.ReactiveStops}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="seg" Content="{Binding Labels.AddReactiveStop}" Padding="10,4"
                          FontSize="11" Command="{Binding AddReactiveStopCommand}" />
                </Grid>

                <TextBlock Classes="hint" Text="{Binding Labels.ReactiveCustomHint}" Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <!-- The ramp as a picture, above the rows that build it: what the keyboard shows while it is edited. -->
                <Border Height="10" CornerRadius="2" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Background="{Binding CustomRampPreview, Converter={x:Static conv:RampToBrushConverter.Instance}}" />

                <ItemsControl ItemsSource="{Binding ReactiveStops}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReactiveStopViewModel">
                      <Grid ColumnDefinitions="62,*,Auto,92,Auto" Margin="0,0,0,6">
                        <!--
                          The temperature as a box and a slider: the slider for a feel of the whole range, the box for
                          the one number the user has in mind. Enter or leaving the box commits it, and the box is
                          rewritten to what the stop actually holds, so a clamped value cannot look accepted.
                        -->
                        <TextBox Grid.Column="0" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center"
                                 Text="{Binding TemperatureText, Mode=OneWay}"
                                 KeyDown="OnReactiveStopTemperatureKeyDown"
                                 LostFocus="OnReactiveStopTemperatureLostFocus"
                                 AutomationProperties.AutomationId="ReactiveStopTemperature" />
                        <controls:NitroSlider Grid.Column="1" Minimum="{Binding MinTemperature}"
                                              Maximum="{Binding MaxTemperature}" TickFrequency="1"
                                              IsSnapToTickEnabled="True" Value="{Binding TemperatureC}"
                                              VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="swatch" Width="26" Height="26" Margin="10,0,0,0"
                                Tag="{Binding}" Click="OnPickReactiveStopColor" ToolTip.Tip="{Binding PickLabel}">
                          <Border Width="22" Height="22" CornerRadius="2"
                                  Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                  BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                        </Button>
                        <TextBox Grid.Column="3" Margin="8,0" Text="{Binding Color}" Watermark="#00B4FF" />
                        <Button Grid.Column="4" Classes="seg" Content="{Binding RemoveLabel}" Padding="8,3"
                                FontSize="10" Command="{Binding RemoveCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ============================================================ the charging colour -->

          <!--
            The second automatic colour, directly under the first: the temperature ramp follows a sensor, this one
            follows the plug. It is a colour of its own rather than a tint of the page's, because the two answer
            different questions — the keys show the adapter's colour while the adapter is in, and the user's own the
            moment it comes out. The swatches are the same eight the palette offers, one row rather than a full card
            of their own. Like the ramp above it, the card is disabled while the effect list stands on OFF.
          -->
          <Border Classes="card" IsEnabled="{Binding AutomaticColoursEnabled}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="rowtitle" Text="{Binding Labels.ChargingColor}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Classes="toggle" IsChecked="{Binding ChargingColorEnabled}"
                              VerticalAlignment="Center" AutomationProperties.AutomationId="ChargingColor" />
              </Grid>

              <TextBlock Classes="hint" Text="{Binding Labels.ChargingColorHint}" Margin="0,8,0,0"
                         TextWrapping="Wrap" />

              <!-- What the keys are showing right now, in the same shape as the temperature card's live reading. -->
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"
                          IsVisible="{Binding HasChargingColorState}">
                <Border Width="26" Height="26" CornerRadius="2"
                        Background="{Binding ChargingColorPreview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                        BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                <TextBlock Classes="hint" Text="{Binding ChargingColorStateText}" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Classes="caps" Text="{Binding Labels.ChargingColorSwatches}" Margin="0,14,0,6" />

              <StackPanel Orientation="Horizontal" Spacing="12">
                <ItemsControl ItemsSource="{Binding ChargingColorChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                      <Button Classes="swatch" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}"
                              AutomationProperties.Name="{Binding Name}">
                        <Border Width="24" Height="24" CornerRadius="2"
                                Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The picker, the same pair the palette uses: every colour there is, then the hex box beside it. -->
                <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="2,2" />

                <Button Classes="swatch" Width="28" Height="28" Click="OnPickChargingColorClick"
                        AutomationProperties.AutomationId="PickChargingColor"
                        ToolTip.Tip="{Binding Labels.CustomColor}">
                  <Border Width="24" Height="24" CornerRadius="2"
                          Background="{Binding ChargingColorPreview, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                          BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="1" />
                </Button>

                <TextBox Width="110" Text="{Binding ChargingColor}" Watermark="#F59E0B"
                         AutomationProperties.AutomationId="ChargingColorHex" />
              </StackPanel>

              <!--
                The level this colour paints at. Its own slider for the same reason the temperature card has one: the
                page's brightness is the user's own colour's, and a plug that changed it would be a second brightness
                control nobody asked for.
              -->
              <StackPanel Margin="0,16,0,0" Classes="gated" Classes.off="{Binding !ChargingColorEnabled}"
                          IsEnabled="{Binding ChargingColorEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caps" Text="{Binding Labels.ChargingBrightnessTitle}" />
                  <TextBlock Grid.Column="1" Text="{Binding ChargingBrightnessLabel}" FontWeight="Bold" FontSize="11"
                             HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                </Grid>
                <controls:NitroSlider Minimum="1" Maximum="{Binding MaxBrightness}" TickFrequency="1"
                                      IsSnapToTickEnabled="True" Value="{Binding ChargingBrightness}" Margin="0,4,0,0"
                                      AutomationProperties.AutomationId="ChargingBrightness" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!--
        The blackout. It is a cover rather than a hidden page: the controls stay in place, greyed out underneath, so the
        user can see what they are turning back on. The button in the middle is the same command as the one in the
        header — the page's own off switch, in the place the eye lands when the content is gone.
      -->
      <Grid IsVisible="{Binding IsLightingBlackedOut}">
        <Border Background="{DynamicResource PageBrush}" Opacity="0.94" />

        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="28,24" MaxWidth="420" BorderBrush="{DynamicResource CardBorderStrongBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardicon" Text="&#xE7E8;" FontSize="24" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.LightingBlackoutTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.LightingBlackoutHint}" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button Classes="primary" Content="{Binding Labels.RestoreLighting}" Padding="14,8" FontSize="11"
                    HorizontalAlignment="Center" Margin="0,4,0,0"
                    AutomationProperties.AutomationId="RestoreLighting"
                    Command="{Binding ToggleLightingBlackoutCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
