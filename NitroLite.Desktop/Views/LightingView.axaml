<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:core="using:NitroLite.Core"
             x:Class="NitroLite.Desktop.Views.LightingView"
             x:DataType="vm:MainViewModel">

  <ScrollViewer>
    <StackPanel Margin="18" Spacing="14">

      <Border Classes="card" IsVisible="{Binding LightingAvailable}">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding Labels.KeyboardLighting}" />

          <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="caption" Text="{Binding Labels.Effect}" />
              <ComboBox ItemsSource="{Binding Effects}"
                        SelectedItem="{Binding SelectedEffect}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EffectChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="caption" Text="{Binding Labels.PrimaryColor}" />
              <TextBox Text="{Binding PrimaryColor}" Watermark="#00E5FF" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Spacing="2" Margin="0,0,12,0">
              <TextBlock Classes="caption" Text="{Binding Labels.Brightness}" />
              <Slider Minimum="1" Maximum="{Binding MaxBrightness}"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding BrightnessLevel}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,12,0">
              <TextBlock Classes="caption" Text="{Binding Labels.Speed}" />
              <Slider Minimum="1" Maximum="{Binding MaxSpeed}"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding SpeedLevel}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Classes="caption" Text="{Binding Labels.Direction}" />
              <Slider Minimum="0" Maximum="{Binding MaxDirection}"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding DirectionLevel}" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="caption" Text="{Binding Labels.ZoneColors}" />

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="4" Margin="0,0,12,8">
              <TextBlock Classes="caption" Text="{Binding Labels.Zone1}" />
              <TextBox Text="{Binding Zone1}" Watermark="#00E5FF" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,0,8">
              <TextBlock Classes="caption" Text="{Binding Labels.Zone2}" />
              <TextBox Text="{Binding Zone2}" Watermark="#00E5FF" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="caption" Text="{Binding Labels.Zone3}" />
              <TextBox Text="{Binding Zone3}" Watermark="#00E5FF" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
              <TextBlock Classes="caption" Text="{Binding Labels.Zone4}" />
              <TextBox Text="{Binding Zone4}" Watermark="#00E5FF" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary"
                    Content="{Binding Labels.Apply}"
                    Command="{Binding ApplyLightingCommand}" />
            <Button Classes="ghost"
                    Content="{Binding Labels.TurnOff}"
                    Command="{Binding TurnOffLightingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !LightingAvailable}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="{Binding Labels.KeyboardLighting}" />
          <TextBlock Classes="caption" Text="{Binding Labels.NotOnThisMachine}" />
        </StackPanel>
      </Border>

      <!-- Saved profiles. The list is the same one the Windows build keeps in rgb_presets.json, so a user who moves
           between the two front ends finds their own presets already there. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.RgbProfiles}" />

          <ComboBox ItemsSource="{Binding RgbProfiles}"
                    SelectedItem="{Binding SelectedRgbProfile}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:RgbPreset">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary"
                    Content="{Binding Labels.ApplyProfile}"
                    Command="{Binding ApplyRgbProfileCommand}" />
            <Button Classes="ghost"
                    Content="{Binding Labels.DeleteProfile}"
                    Command="{Binding DeleteRgbProfileCommand}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewProfileName}" Watermark="{Binding Labels.ProfileName}" />
            <Button Grid.Column="1" Classes="ghost" Margin="10,0,0,0"
                    Content="{Binding Labels.SaveProfile}"
                    Command="{Binding SaveRgbProfileCommand}" />
          </Grid>

          <TextBlock Classes="caption" Text="{Binding RgbProfileStatus}" />
          <TextBlock Classes="caption" Text="{Binding RgbProfileLoadError}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding Labels.Extras}" />

          <!-- Each row hides itself when the probe did not find the node, so the page never offers a switch that
               would write to a file that is not there. -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CoolBoostAvailable}">
            <TextBlock Text="{Binding Labels.CoolBoost}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CoolBoostOn}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding LcdOverdriveAvailable}">
            <TextBlock Text="{Binding Labels.LcdOverdrive}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LcdOverdriveOn}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BacklightTimeoutAvailable}">
            <TextBlock Text="{Binding Labels.BacklightTimeout}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding BacklightTimeoutOn}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding BatteryLimitAvailable}">
            <TextBlock Text="{Binding Labels.BatteryLimit}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding BatteryLimitOn}" />
          </Grid>

          <TextBlock Classes="caption"
                     Text="{Binding Labels.NotOnThisMachine}"
                     IsVisible="{Binding NoExtrasAvailable}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
