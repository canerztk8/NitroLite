<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NitroLite.Desktop.ViewModels"
        xmlns:views="using:NitroLite.Desktop.Views"
        x:Class="NitroLite.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Labels.AppTitle}"
        Width="1060"
        Height="730"
        MinWidth="1060"
        MinHeight="730"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Background="{DynamicResource PageBrush}">

  <!--
    The shell, measured against the WPF window it replaces: a 44px printed header, a resizable rail, and the page inset
    26/20. The window is 1060x730 and refuses to go smaller, because that is the size at which the five pages were
    laid out and every card still fits without a scrollbar.

    The rail is a list of buttons rather than a TabControl so the marker, the glyph and the label are one control, and
    so the live SİSTEM card can sit under the list without being a page of its own. Its width is a bound column
    definition, which is what lets the splitter write the new width straight into the settings file.
  -->
  <Grid>

  <Border x:Name="ShellRoot" Background="{DynamicResource PageBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="44,*">

      <!-- ============================================================ title bar -->

      <Border Grid.Row="0" Background="{DynamicResource PageBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
              PointerPressed="OnCaptionPressed">
        <Grid Margin="18,0" ColumnDefinitions="Auto,*,Auto">

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- The lockup replaces the product name the header used to set. Two images share one cell: the ink mark
                 is what the paper palettes print, the white mark takes over under Dark and Midnight OLED. The swap
                 happens in code behind from ActualThemeVariant, because a palette change repaints a live window and
                 no resource lookup here would follow it. 24px tall puts the wordmark's x-height where the 13px title
                 cap sat, so the version beside it keeps its baseline and the header keeps its weight. -->
            <Panel VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Labels.AppTitle}">
              <Image x:Name="HeaderLogoInk" Height="24" Stretch="Uniform" VerticalAlignment="Center"
                     Source="avares://NitroLite.Desktop/Assets/logo-horizontal-ink.png" />
              <Image x:Name="HeaderLogoPaper" Height="24" Stretch="Uniform" VerticalAlignment="Center"
                     IsVisible="False"
                     Source="avares://NitroLite.Desktop/Assets/logo-horizontal-paper.png" />
            </Panel>
            <TextBlock Text="{Binding VersionText}" FontSize="10" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

            <!-- The update notice, in the header where the WPF window put it: a user who never opens the tools page
                 still has to be able to see that a release exists and act on it. Both buttons are the same notice,
                 so the notes never appear without the update they describe. -->
            <Button x:Name="BtnUpdateNow" Classes="primary" Content="{Binding Labels.Update}"
                    Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,3" FontSize="10"
                    IsVisible="{Binding HasPendingUpdate}" Command="{Binding UpdateNowCommand}" />
            <Button x:Name="BtnReleaseNotes" Classes="primary" Content="{Binding Labels.ReleaseNotes}"
                    Margin="6,0,0,0" VerticalAlignment="Center" Padding="8,3" FontSize="10"
                    IsVisible="{Binding UpdateAvailable}" Command="{Binding ReleaseNotesCommand}"
                    ToolTip.Tip="{Binding Labels.ReleaseNotesHint}" />
          </StackPanel>

          <!-- The live figures are printed, not boxed: they sit on the paper like a printed header. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Labels.BatteryCaption}" Classes="caps" Margin="0,0,6,0" />
              <TextBlock Text="{Binding BatteryPercentText}" Classes="figure" FontSize="11" />
            </StackPanel>

            <!-- The mode figure doubles as the quickest way to change it: the same list the mode page offers, and gated
                 the same way the page's cards are. Open on a machine without mode control, or while the probe was still
                 running, a click wrote, the selection snapped back and a failure banner followed. -->
            <Button Padding="6,3" Margin="0,0,14,0" Background="Transparent"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="2" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Labels.ModeCaption}">
              <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="ModeControlAvailable" />
                  <Binding Path="IsHardwareReady" />
                </MultiBinding>
              </Button.IsEnabled>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Labels.ModeCaption}" Classes="caps" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ModeBadgeText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <ItemsControl ItemsSource="{Binding Modes}" MinWidth="150">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModeChoice">
                        <Button Classes="nav" Command="{Binding SelectCommand}">
                          <Border Classes="navitem">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Grid.Column="0" Classes="navicon" Text="{Binding Icon}" />
                              <TextBlock Grid.Column="1" Classes="navlabel" Text="{Binding Label}" />
                            </Grid>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>

            <!-- The window has no system chrome, so it draws its own three buttons, as the WPF window did. -->
            <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="{Binding Labels.Minimize}">
              <TextBlock Text="&#x2013;" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="{Binding Labels.Maximize}">
              <TextBlock Text="&#xE922;" Classes="icon" FontSize="9"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="{Binding Labels.HideToTray}">
              <TextBlock Text="&#x2715;" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================================================ rail + page -->

      <Grid Grid.Row="1" x:Name="RailGrid">
        <Grid.ColumnDefinitions>
          <!-- The width lives on the column and is written by the window, not bound: a ColumnDefinition is an
               AvaloniaObject with no DataContext, so a {Binding SidebarWidth} on it never resolves and the rail falls
               back to its content's width. MinWidth/MaxWidth are what stop a drag at the ends — the splitter clamps
               against them itself, so the rail cannot be pulled past the limit and left there. -->
          <ColumnDefinition MinWidth="175" MaxWidth="290" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0"
                Padding="10,16,10,12">
          <Grid RowDefinitions="Auto,*,Auto,Auto">

            <StackPanel Grid.Row="0">
              <TextBlock Text="{Binding Labels.NavCaption}" Classes="caps" Margin="10,0,0,8" />

              <ItemsControl ItemsSource="{Binding NavTabs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavTab">
                    <Button Classes="nav" Command="{Binding SelectCommand}"
                            AutomationProperties.AutomationId="{Binding AutomationId}">
                      <Border Classes="navitem" Classes.selected="{Binding IsSelected}">
                        <!-- The mark takes 12px, the icon and the label share the rest, exactly as in the WPF rail:
                             a separate Auto column for the icon would leave the longest label too narrow to fit. -->
                        <Grid ColumnDefinitions="12,*">
                          <Rectangle Grid.Column="0" Classes="navmark" Classes.selected="{Binding IsSelected}" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Classes="navicon" Text="{Binding Icon}" />
                            <TextBlock Classes="navlabel" Text="{Binding Label}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- The live readout: a small card on the rail, so the figures read as one block rather than as loose
                 lines under the navigation. It stays put whichever page is showing, and every row is a shortcut to
                 the page or the quick menu that owns it. -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="6,7,6,4" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{Binding Labels.SystemCaption}" Classes="caps" Margin="4,0,0,6" />

                <Button Classes="sidestat" Click="OnSideStatClick" Tag="monitoring"
                        ToolTip.Tip="{Binding Labels.NavMonitoring}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Labels.Cpu}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemCpuText}" Classes="figure"
                               HorizontalAlignment="Right" />
                  </Grid>
                </Button>

                <Button Classes="sidestat" Click="OnSideStatClick" Tag="monitoring"
                        ToolTip.Tip="{Binding Labels.NavMonitoring}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Labels.Gpu}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemGpuText}" Classes="figure"
                               HorizontalAlignment="Right" />
                  </Grid>
                </Button>

                <Button Classes="sidestat" Click="OnSideStatClick" Tag="monitoring"
                        ToolTip.Tip="{Binding Labels.NavMonitoring}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Labels.FanCaption}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemFanText}" Classes="figure"
                               HorizontalAlignment="Right" />
                  </Grid>
                </Button>

                <!-- BOOST opens the same three pills the GPU & CPU card carries, so the mode can be changed from any
                     page without a trip to the modes tab. -->
                <Button Classes="sidestat" ToolTip.Tip="{Binding Labels.TrayCpuBoost}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Labels.BoostCaption}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemBoostText}" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop">
                      <ItemsControl ItemsSource="{Binding CpuBoostChoices}" MinWidth="140">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CpuBoostChoice">
                            <Button Classes="nav" Command="{Binding SelectCommand}">
                              <Border Classes="navitem" Classes.selected="{Binding IsSelected}">
                                <TextBlock Classes="navlabel" Text="{Binding Label}" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <!-- The mouse row only exists on a machine whose mouse answered. A row that offered four
                     configurations on a laptop with no ATK mouse would be four buttons that write nowhere. -->
                <Button Classes="sidestat" IsVisible="{Binding ShowSystemMouseRow}"
                        ToolTip.Tip="{Binding Labels.MouseProfiles}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Labels.MouseCaption}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemMouseText}" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop">
                      <ItemsControl ItemsSource="{Binding MouseProfileOptions}" MinWidth="160">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MouseProfileOption">
                            <Button Classes="nav" Command="{Binding SelectCommand}">
                              <Border Classes="navitem" Classes.selected="{Binding IsSelected}">
                                <TextBlock Classes="navlabel" Text="{Binding Label}" />
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <!-- The active game. The row only exists while a game is running: with none, there is nothing to put
                     there, and a line reading "—" is a line the user has to read to learn nothing. It is the last row
                     in the box, so it appears at the bottom the moment a game starts. Trimmed rather than wrapped: a
                     long process name must not push the rail's own layout around. -->
                <Button Classes="sidestat" Click="OnSideStatClick" Tag="modes"
                        IsVisible="{Binding ShowSystemGameRow}"
                        ToolTip.Tip="{Binding Labels.GameProfiles}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding Labels.GameCaption}" Classes="caps" />
                    <TextBlock Grid.Column="1" Text="{Binding SystemGameText}" FontSize="11"
                               Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>

            <!-- The signature sits at the very bottom of the rail, under the readout. The name is a link to the
                 project, which is what the WPF window's signature did. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="10,0,10,10">
              <TextBlock Text="&#x2665;" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding Labels.SignaturePrefix}" FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              <Button Classes="link" Click="OnSignatureClick" ToolTip.Tip="{Binding Labels.SignatureLinkHint}">
                <TextBlock Text="{Binding Labels.SignatureName}" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- The rail's resize handle. Four pixels wide and transparent: the cursor is the affordance, as in the WPF
             window, and a visible bar between the rail and the page would read as a second border. A double click puts
             the rail back to its default width, which is the only way to undo a drag that went too far. -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" ToolTip.Tip="{Binding Labels.RailSplitterHint}"
                      DoubleTapped="OnRailSplitterDoubleTapped" />

        <!-- The page. Only this column scrolls, so the rail and the header stay put. -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="26,20,26,0">

          <StackPanel Grid.Row="0">

            <!-- The capability probe runs on the thread pool, so the window is up before the list of what this
                 machine can do is. The page below is disabled until it lands: a control clicked against a list that
                 has not been read yet would write a value the machine may not have. -->
            <Border IsVisible="{Binding IsHardwareBusy}"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2" Margin="0,0,0,14">
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0" Background="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Column="1" Margin="12,9,12,10">
                  <TextBlock Text="{Binding Labels.HardwareScanning}" Classes="caps"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Labels.HardwareScanningDetail}" FontSize="11" Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Standing note while the backend is unreachable. The toast alone is gone after three seconds, and a
                 window whose every hardware control silently does nothing reads as broken. -->
            <Border IsVisible="{Binding ShowNoBackendBanner}"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2" Margin="0,0,0,14">
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" />
                <StackPanel Grid.Column="1" Margin="12,9,12,10">
                  <TextBlock Text="{Binding Labels.NoBackend}" Classes="caps"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding NoBackendDetail}" FontSize="11" Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <Grid x:Name="PageHost" Grid.Row="1" IsEnabled="{Binding IsHardwareReady}">
            <!-- The five pages are built on the first visit instead of with the window: five pages of cards is more
                 than a thousand controls, and four of them were being measured and themed while nobody was looking at
                 them. The shell adds the one that is open (MainWindow.axaml.cs, EnsureCurrentPage) and binds its
                 IsVisible to the same flag the page used to carry here, so navigation still behaves the same. -->
            <Grid x:Name="PageHostPages" />

            <!-- The last thing that happened, printed at the foot of the page the way the WPF window did it. The
                 action button is optional: a message that can be acted on carries one, a plain confirmation does
                 not. It is a banner, not a footer: it fades in over the page, fades out again on its own timer, and
                 only takes the pointer while it carries a button. A banner that stayed would sit on top of the page
                 it is reporting about. -->
            <Border x:Name="ToastBanner" IsVisible="{Binding HasStatus}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24" MaxWidth="720" Padding="16,9"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
                    CornerRadius="4" Opacity="0" IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
              </Border.Transitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25CF;" FontSize="13" FontWeight="Bold" Margin="0,0,8,0"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" MaxWidth="560"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Classes="primary" IsVisible="{Binding HasToastAction}"
                        Content="{Binding ToastActionLabel}" Padding="12,5" FontSize="11"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ToastActionCommand}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>

  <!-- The resize grip. The window draws its own chrome, so there is no frame to grab; this is the frame. It is a
       Border rather than a Button because it must not take focus or answer the keyboard, and it is 14px because that
       is the smallest square a pointer can find without aiming. -->
  <Border x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="0,0,3,3" Background="Transparent" Cursor="BottomRightCorner"
          PointerPressed="OnResizeGripPressed" ToolTip.Tip="{Binding Labels.ResizeHint}">
    <Path Data="M 13,1 L 1,13 M 13,6 L 6,13 M 13,11 L 11,13"
          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" Opacity="0.55" />
  </Border>

  <!-- The first-run walkthrough sits above the shell, not beside it: the window behind it stays visible so the user
       can see what is being configured. -->
  <views:OnboardingOverlay x:Name="Onboarding" IsVisible="{Binding ShowOnboarding}" />

  </Grid>
</Window>
