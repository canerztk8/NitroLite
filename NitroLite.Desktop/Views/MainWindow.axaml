<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NitroLite.Desktop.ViewModels"
        xmlns:views="using:NitroLite.Desktop.Views"
        x:Class="NitroLite.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NitroLite"
        Width="1120"
        Height="800"
        MinWidth="960"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">

  <!-- Three rows: a fixed header, the tab body, a fixed status line. Only the middle row scrolls, so the device name
       and the last write result stay visible while the user is deep in the fan curve. -->
  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="{Binding Labels.AppTitle}" />
          <!-- Hidden rather than shown empty: a machine whose DMI did not answer has no name to put in the pill. -->
          <Border Classes="pill" IsVisible="{Binding HasDeviceName}">
            <TextBlock Classes="caption" Text="{Binding DeviceModel}" />
          </Border>
        </StackPanel>

        <!-- The last write result. It is a badge rather than plain text because "written" and "failed" have to be
             distinguishable at a glance from across the room. -->
        <Border Grid.Column="2" Classes="badge">
          <TextBlock Text="{Binding Status}" />
        </Border>
      </Grid>
    </Border>

    <!-- The tab strip is the navigation rail: the TabControl's background is the rail colour, and the content host is
         repainted to the page colour in App.axaml so the rail ends where the navigation ends. Each header is an icon
         plus its label; the icon inherits the tab's Foreground, so it turns accent-coloured when the tab is selected. -->
    <TabControl Grid.Row="1"
                TabStripPlacement="Left"
                Background="{DynamicResource RailBrush}"
                Padding="0">
      <TabItem AutomationProperties.Name="{Binding Labels.Dashboard}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
            <TextBlock Text="{Binding Labels.Dashboard}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:DashboardView />
      </TabItem>
      <TabItem AutomationProperties.Name="{Binding Labels.Lighting}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M2,6 H22 V18 H2 Z M4,8 H7 V10 H4 Z M9,8 H12 V10 H9 Z M14,8 H17 V10 H14 Z M19,8 H20 V10 H19 Z M4,12 H7 V14 H4 Z M9,12 H12 V14 H9 Z M14,12 H17 V14 H14 Z M19,12 H20 V14 H19 Z M6,15 H18 V17 H6 Z" />
            <TextBlock Text="{Binding Labels.Lighting}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:LightingView />
      </TabItem>
      <TabItem AutomationProperties.Name="{Binding Labels.GameProfiles}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M21.58,16.09 L20.49,8.43 C20.21,6.46 18.52,5 16.53,5 H7.47 C5.48,5 3.79,6.46 3.51,8.43 L2.42,16.09 C2.2,17.63 3.39,19 4.94,19 C5.75,19 6.5,18.63 7.01,18.01 L9,16 H15 L16.99,18.01 C17.5,18.63 18.25,19 19.06,19 C20.61,19 21.8,17.63 21.58,16.09 Z M11,11 H9 V13 H8 V11 H6 V10 H8 V8 H9 V10 H11 Z M15.5,10 A1.5,1.5 0 1,1 15.51,10 Z M19,12 A1,1 0 1,1 19.01,12 Z" />
            <TextBlock Text="{Binding Labels.GameProfiles}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:GameProfilesView />
      </TabItem>
      <TabItem AutomationProperties.Name="{Binding Labels.Settings}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M12,4 A8,8 0 1,1 11.99,4 Z M12,8 A4,4 0 1,1 11.99,8 Z M10,0 H14 V4 H10 Z M10,20 H14 V24 H10 Z M0,10 H4 V14 H0 Z M20,10 H24 V14 H20 Z" />
            <TextBlock Text="{Binding Labels.Settings}" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <views:SettingsView />
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="20,7">
      <TextBlock Classes="muted" Text="{Binding Status}" />
    </Border>
  </Grid>
</Window>
