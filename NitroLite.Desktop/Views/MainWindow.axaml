<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NitroLite.Desktop.ViewModels"
        xmlns:views="using:NitroLite.Desktop.Views"
        x:Class="NitroLite.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Labels.AppTitle}"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="False">

  <!--
    The shell, laid out like the WPF window it replaces: a 44px printed header, a 225px rail, and the page.

    The rail is a list of buttons rather than a TabControl so the selected marker, the icon and the label are one
    control, and so the live SİSTEM card can sit under the list without being a page of its own.
  -->
  <Grid RowDefinitions="44,*,Auto">

    <!-- ============================================================ title bar -->

    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="18,0"
            PointerPressed="OnCaptionPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="{Binding Labels.AppTitle}" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" Classes="caps" VerticalAlignment="Center" />
        </StackPanel>

        <!-- The live figures are printed, not boxed: they sit on the paper like a printed header. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Labels.BatteryCaption}" Classes="caps" />
            <TextBlock Text="{Binding BatteryPercentText}" Classes="figure" FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Labels.ModeCaption}" Classes="caps" />
            <TextBlock Text="{Binding ModeBadgeText}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- The window has no system chrome, so it draws its own three buttons, as the WPF window did. -->
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
            <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="{Binding Labels.Minimize}">
              <PathIcon Data="M0,4.5 H10 V5.5 H0 Z" Width="10" Height="10" />
            </Button>
            <Button Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="{Binding Labels.Maximize}">
              <PathIcon Data="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z" Width="10" Height="10" />
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="{Binding Labels.HideToTray}">
              <PathIcon Data="M0.7,0 L5,4.3 L9.3,0 L10,0.7 L5.7,5 L10,9.3 L9.3,10 L5,5.7 L0.7,10 L0,9.3 L4.3,5 L0,0.7 Z"
                        Width="10" Height="10" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ rail + page -->

    <Grid Grid.Row="1" ColumnDefinitions="225,*">

      <Border Grid.Column="0" Background="{DynamicResource RailBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0"
              Padding="10,14,10,10">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

          <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Labels.NavCaption}" Classes="caps" Margin="8,0,0,7" />

            <ItemsControl ItemsSource="{Binding NavTabs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavTab">
                  <Button Classes="nav" Command="{Binding SelectCommand}">
                    <Border Classes="navitem" Classes.selected="{Binding IsSelected}">
                      <Grid ColumnDefinitions="12,Auto,*">
                        <Rectangle Grid.Column="0" Classes="navmark" Classes.selected="{Binding IsSelected}" />
                        <PathIcon Grid.Column="1" Data="{Binding Icon}" />
                        <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding Label}" Margin="9,0,0,0" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The live readout: a small card on the rail, so the figures read as one block rather than as loose
               lines under the navigation. It stays put whichever page is showing. -->
          <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="6,7,6,4" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding Labels.SystemCaption}" Classes="caps" Margin="8,0,0,6" />

              <Border Classes="sidestat">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Labels.Cpu}" Classes="caps" />
                  <TextBlock Grid.Column="1" Text="{Binding SystemCpuText}" Classes="figure" />
                </Grid>
              </Border>

              <Border Classes="sidestat">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Labels.Gpu}" Classes="caps" />
                  <TextBlock Grid.Column="1" Text="{Binding SystemGpuText}" Classes="figure" />
                </Grid>
              </Border>

              <Border Classes="sidestat">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Labels.FanCaption}" Classes="caps" />
                  <TextBlock Grid.Column="1" Text="{Binding SystemFanText}" Classes="figure" />
                </Grid>
              </Border>

              <Border Classes="sidestat">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Labels.BoostCaption}" Classes="caps" />
                  <TextBlock Grid.Column="1" Text="{Binding SystemBoostText}" FontSize="11"
                             FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- The active game, or the sentence that says there is none. Trimmed rather than wrapped: a long
                   process name must not push the rail's own layout around. -->
              <Border Classes="sidestat">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="{Binding Labels.GameCaption}" Classes="caps" />
                  <TextBlock Grid.Column="1" Text="{Binding SystemGameText}" FontSize="10"
                             Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                             Margin="6,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- The signature sits at the very bottom of the rail, under the readout. -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="&#x2665;" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Labels.SignaturePrefix}" FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Labels.SignatureName}" FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- The page. Only this column scrolls, so the rail and the header stay put. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="22,16,22,0">

        <!-- Standing note while the backend is unreachable. The toast alone is gone after three seconds, and a window
             whose every hardware control silently does nothing reads as broken. -->
        <Border Grid.Row="0" IsVisible="{Binding ShowNoBackendBanner}"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
          <Grid ColumnDefinitions="3,*">
            <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="1" Margin="12,8,12,9">
              <TextBlock Text="{Binding Labels.NoBackend}" Classes="caps"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding NoBackendDetail}" Classes="hint" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <views:DashboardView IsVisible="{Binding IsModesPage}" />
          <views:MonitoringView IsVisible="{Binding IsMonitoringPage}" />
          <views:LightingView IsVisible="{Binding IsLightingPage}" />
          <views:BatteryView IsVisible="{Binding IsBatteryPage}" />
          <views:SettingsView IsVisible="{Binding IsToolsPage}" />
        </Grid>
      </Grid>
    </Grid>

    <!-- ============================================================ status line -->

    <Border Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="18,5">
      <TextBlock Text="{Binding Status}" Classes="hint" />
    </Border>
  </Grid>
</Window>
