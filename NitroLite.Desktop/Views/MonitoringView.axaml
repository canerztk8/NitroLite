<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             x:Class="NitroLite.Desktop.Views.MonitoringView"
             x:DataType="vm:MainViewModel">

  <!--
    Page 2: the readings. The WPF page put the processor and the graphics card side by side as two cards of labelled
    rows, each row a name, a figure and a 4px bar, then a wider card for the machine as a whole. That is the shape
    here too; the rows that only a Windows sensor can answer (package watts, VRAM, clock) are simply not offered,
    because a row that always prints a placeholder is worse than no row.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <TextBlock Classes="pagetitle" Text="{Binding Labels.MonitoringPageTitle}" Margin="0,0,0,14"
                 TextWrapping="Wrap" />

      <!-- ============================================================ processor and graphics -->

      <UniformGrid Columns="2" Margin="0,0,0,14">

        <Border Classes="card" Margin="0,0,6,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.Cpu}" TextWrapping="Wrap" />
              <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top">
                <TextBlock Text="{Binding FanRpmSourceText}" />
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <TextBlock Classes="hint" Text="{Binding Labels.Temperatures}" />
              <TextBlock Grid.Column="1" Text="{Binding CpuTemperatureText}" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding CpuTemperature}"
                         Margin="0,0,0,6" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <TextBlock Classes="hint" Text="{Binding Labels.FanRpm}" />
              <TextBlock Grid.Column="1" Text="{Binding CpuFanRpmText}" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding CpuFanBarPercent}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Margin="6,0,0,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.Gpu}" TextWrapping="Wrap" />
              <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top">
                <TextBlock Text="{Binding FanRpmSourceText}" />
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <TextBlock Classes="hint" Text="{Binding Labels.Temperatures}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuTemperatureText}" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding GpuTemperature}"
                         Margin="0,0,0,6" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
              <TextBlock Classes="hint" Text="{Binding Labels.FanRpm}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuFanRpmText}" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding GpuFanBarPercent}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ============================================================ the machine as a whole -->

      <Border Classes="card" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,*">

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="rowtitle" Text="{Binding Labels.Sys}" VerticalAlignment="Center" />
              <Border Classes="infobadge" Margin="6,0,0,0" ToolTip.Tip="{Binding Labels.ThermalFloorSummary}">
                <TextBlock Text="?" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding SysTemperatureText}" FontSize="18" FontWeight="Bold" Margin="0,4" />
            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding SysTemperature}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock Classes="rowtitle" Text="{Binding Labels.BatteryStatus}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6">
              <TextBlock Text="{Binding BatteryPercentText}" FontSize="15" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="{Binding BatteryStateText}" FontSize="11"
                         FontWeight="Bold" HorizontalAlignment="Right"
                         Foreground="{DynamicResource SuccessBrush}" />
            </Grid>
            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding BatteryBarPercent}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================================================ the last minute -->

      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="section" Text="{Binding Labels.TelemetryCharts}" />
            <TextBlock Grid.Column="1" Classes="caps" Text="{Binding Labels.Last60Seconds}" />
          </Grid>

          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,12,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Cpu}" />
                <TextBlock Grid.Column="1" Classes="figure" FontSize="11" Text="{Binding CpuTemperatureText}" />
              </Grid>
              <Border Height="34" Margin="0,4,0,0" Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      CornerRadius="2" ClipToBounds="True">
                <controls:SparklineChart Values="{Binding CpuTemperatureHistory}"
                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                         Baseline="{DynamicResource CardBorderStrongBrush}" />
              </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Gpu}" />
                <TextBlock Grid.Column="1" Classes="figure" FontSize="11" Text="{Binding GpuTemperatureText}" />
              </Grid>
              <Border Height="34" Margin="0,4,0,0" Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      CornerRadius="2" ClipToBounds="True">
                <controls:SparklineChart Values="{Binding GpuTemperatureHistory}"
                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                         Baseline="{DynamicResource CardBorderStrongBrush}" />
              </Border>
            </StackPanel>

            <StackPanel Margin="0,0,12,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Sys}" />
                <TextBlock Grid.Column="1" Classes="figure" FontSize="11" Text="{Binding SysTemperatureText}" />
              </Grid>
              <Border Height="34" Margin="0,4,0,0" Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      CornerRadius="2" ClipToBounds="True">
                <controls:SparklineChart Values="{Binding SysTemperatureHistory}"
                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                         Baseline="{DynamicResource CardBorderStrongBrush}" />
              </Border>
            </StackPanel>

            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.FanRpm}" />
                <TextBlock Grid.Column="1" Classes="figure" FontSize="11" Text="{Binding CpuFanRpmText}" />
              </Grid>
              <Border Height="34" Margin="0,4,0,0" Background="{DynamicResource PanelBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      CornerRadius="2" ClipToBounds="True">
                <controls:SparklineChart Values="{Binding CpuFanHistory}"
                                         Stroke="{DynamicResource TextPrimaryBrush}"
                                         Baseline="{DynamicResource CardBorderStrongBrush}" />
              </Border>
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
