<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             x:Class="NitroLite.Desktop.Views.GameProfilesView"
             x:DataType="vm:MainViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Margin="18" Spacing="14">

      <!-- The master switch. It is the same setting the dashboard's game card toggles, so the two can never disagree. -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{Binding Labels.AutoGameMode}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGameModeOn}" />
          </Grid>
          <TextBlock Classes="caption" Text="{Binding Labels.AutoGameModeHint}" />
          <Border Classes="pill" HorizontalAlignment="Left">
            <TextBlock Classes="caption" Text="{Binding GameStatusText}" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Adding a rule. The process name is what /proc reports, so the hint says so: "cs2" and "Cyberpunk2077.exe"
           are both valid, and a user who types the window title will never match anything. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.AddGame}" />
          <TextBlock Classes="caption" Text="{Binding Labels.GameProfilesHint}" />

          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="label" Text="{Binding Labels.NewGameExe}" />
              <TextBox Text="{Binding NewGameExe}" Watermark="cs2" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="label" Text="{Binding Labels.NewGameName}" />
              <TextBox Text="{Binding NewGameName}" Watermark="Counter-Strike 2" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="{Binding Labels.TargetMode}" />
              <ComboBox ItemsSource="{Binding GameModeChoices}"
                        SelectedItem="{Binding NewGameMode}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModeChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*,Auto">
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="label" Text="{Binding Labels.TargetFanMode}" />
              <ComboBox ItemsSource="{Binding GameFanChoices}"
                        SelectedItem="{Binding NewGameFanMode}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FanModeChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Button Grid.Column="2" Classes="primary"
                    Content="{Binding Labels.AddGame}"
                    Command="{Binding AddGameProfileCommand}"
                    VerticalAlignment="Bottom" />
          </Grid>

          <TextBlock Classes="caption"
                     Text="{Binding GameProfileStatus}"
                     IsVisible="{Binding HasGameProfileStatus}" />
        </StackPanel>
      </Border>

      <!-- The rules themselves. Each row is one game: what it is called, what /proc calls it, and what it switches
           to. Deleting is one click and takes effect on the next detection pass. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.GameProfiles}" />

          <ItemsControl ItemsSource="{Binding GameProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameProfileRow">
                <Border Classes="panel" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="h2" Text="{Binding DisplayName}" />
                      <TextBlock Classes="mono" Text="{Binding ExeName}" />
                    </StackPanel>

                    <Border Grid.Column="1" Classes="badge" Margin="10,0,0,0">
                      <TextBlock Text="{Binding ModeLabel}" />
                    </Border>

                    <Border Grid.Column="2" Classes="badge" Margin="8,0,0,0">
                      <TextBlock Text="{Binding FanLabel}" />
                    </Border>

                    <Button Grid.Column="3" Classes="danger" Margin="12,0,0,0"
                            Content="{Binding DeleteLabel}"
                            Command="{Binding DeleteCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="caption"
                     Text="{Binding Labels.NoGameProfiles}"
                     IsVisible="{Binding HasNoGameProfiles}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
