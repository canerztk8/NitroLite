<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             x:Class="NitroLite.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel">

  <!--
    Page 1: the control centre. The WPF window's tight, scroll-free arrangement: the 60-second band, the mode tiles,
    the fan card, the GPU/CPU card and the game card, in that order, with no full-width rows and no Apply buttons.
  -->
  <ScrollViewer>
    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Margin="0,0,0,16" Spacing="12">

      <TextBlock Classes="pagetitle" Text="{Binding Labels.NavModes}" />

      <!-- ============================================================ the 60-second band -->

      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="caps" Text="{Binding Labels.Last60Seconds}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Classes="caps" Text="{Binding SparklineRangeText}" VerticalAlignment="Center" />
            <TextBlock Classes="figure" FontSize="11" Text="{Binding SparklineNowText}"
                       VerticalAlignment="Center" />
            <Button Classes="seg" Command="{Binding ToggleSparklineBandCommand}"
                    Content="{Binding SparklineBandToggleText}" />
          </StackPanel>
        </Grid>

        <!-- 36px: enough for the trace to keep its shape, thin enough that the cards below stay reachable. The line
             only, no wash: at this height a filled area reads as a bar chart of one value. -->
        <Border Height="36" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2"
                ClipToBounds="True" IsVisible="{Binding SparklineBandVisible}">
          <controls:SparklineChart Values="{Binding CpuTemperatureHistory}"
                                   Stroke="{DynamicResource AccentBrush}"
                                   Baseline="{DynamicResource CardBorderStrongBrush}" />
        </Border>
      </StackPanel>

      <!-- ============================================================ power modes -->

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Classes="section" Text="{Binding Labels.PowerModes}" />

          <ItemsControl ItemsSource="{Binding Modes}" IsEnabled="{Binding ModeControlAvailable}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Modes.Count}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModeChoice">
                <Button Classes="modetile" Command="{Binding SelectCommand}" Margin="0,0,8,0">
                  <Border Classes="modetile" Classes.selected="{Binding IsSelected}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
                      <Ellipse Grid.Row="0" Grid.Column="0" Classes="selecteddot" Margin="0,0,6,0" />
                      <PathIcon Grid.Row="0" Grid.Column="1" Data="{Binding Icon}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Classes="modetitle" Text="{Binding Label}"
                                 Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Border Grid.Row="0" Grid.Column="3" Classes="badge" IsVisible="{Binding IsSelected}"
                              Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveLabel}" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Classes="hint"
                                 Text="{Binding ShortHint}" Margin="0,3,0,0" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============================================================ fan control -->

      <Border Classes="card">
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{Binding Labels.FanControl}" VerticalAlignment="Center" />

            <!-- One segmented pill, top right: the whole fan choice in one line. -->
            <Border Grid.Column="1" Classes="segmented" IsEnabled="{Binding FanControlAvailable}">
              <ItemsControl ItemsSource="{Binding FanSegments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FanSegmentChoice">
                    <Button Classes="seg" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>

          <!-- The two big readouts, each with its own fill bar. -->
          <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="3" Margin="0,0,14,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Cpu}" />
                <Border Grid.Column="1" Classes="pill">
                  <TextBlock Classes="caps" Text="{Binding FanRpmSourceText}" />
                </Border>
              </Grid>
              <TextBlock Classes="figurebig" Text="{Binding CpuFanRpmText}" />
              <ProgressBar Classes="fanbar" Minimum="0" Maximum="100" Value="{Binding CpuFanBarPercent}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="3">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.Gpu}" />
                <Border Grid.Column="1" Classes="pill">
                  <TextBlock Classes="caps" Text="{Binding FanRpmSourceText}" />
                </Border>
              </Grid>
              <TextBlock Classes="figurebig" Text="{Binding GpuFanRpmText}" />
              <ProgressBar Classes="fanbar" Minimum="0" Maximum="100" Value="{Binding GpuFanBarPercent}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="hint" Text="{Binding Labels.FanProtection}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding FanProtectionOn}" />
          </Grid>

          <!-- The manual speeds only mean something in Özel. -->
          <Border Classes="panel" IsVisible="{Binding CustomFanVisible}">
            <StackPanel Spacing="2">
              <TextBlock Classes="caps" Text="{Binding Labels.CustomFanSpeed}" Margin="0,0,0,4" />
              <Grid ColumnDefinitions="*,48">
                <TextBlock Classes="hint" Text="{Binding Labels.CpuFanPercent}" />
                <TextBlock Grid.Column="1" Classes="figure" Text="{Binding CustomCpuPercentText}"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CustomCpuPercent}" />
              <Grid ColumnDefinitions="*,48">
                <TextBlock Classes="hint" Text="{Binding Labels.GpuFanPercent}" />
                <TextBlock Grid.Column="1" Classes="figure" Text="{Binding CustomGpuPercentText}"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CustomGpuPercent}" />
            </StackPanel>
          </Border>

          <!-- The curve opens right under the card when Eğri is the chosen pill. -->
          <Border Classes="panel" IsVisible="{Binding CurveEditorVisible}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caps" Text="{Binding Labels.FanCurve}" />
                <TextBlock Grid.Column="1" Classes="figure" FontSize="11" Text="{Binding CurvePreview}" />
              </Grid>

              <Grid ColumnDefinitions="*,*">
                <controls:FanCurvePreview Height="150"
                                          Points="{Binding CurvePoints}"
                                          CurrentTemperature="{Binding CurrentTemperature}"
                                          SurfaceBrush="{DynamicResource CardBrush}"
                                          BandBrush="{DynamicResource DangerSoftBrush}"
                                          CurveBrush="{DynamicResource AccentBrush}"
                                          MarkerBrush="{DynamicResource WarningBrush}"
                                          GridBrush="{DynamicResource CardBorderBrush}"
                                          TextBrush="{DynamicResource TextMutedBrush}"
                                          FloorBrush="{DynamicResource DangerBrush}" />

                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="1">
                  <ItemsControl ItemsSource="{Binding CurveAnchors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CurveAnchorViewModel">
                        <DockPanel Margin="0,1">
                          <TextBlock DockPanel.Dock="Left" Width="46" Classes="hint" Text="{Binding Label}" />
                          <TextBlock DockPanel.Dock="Right" Width="40" Classes="figure" FontSize="11"
                                     TextAlignment="Right" Text="{Binding EffectiveText}" />
                          <Slider Minimum="30" Maximum="100" Margin="8,0,8,0" MinWidth="50"
                                  TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Percent}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="{Binding Labels.ApplyCurve}"
                        Command="{Binding ApplyCurveCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ============================================================ GPU and CPU -->

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{Binding Labels.GpuAndCpu}" />

          <!-- CPU boost: three pills, one click each. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caps" Text="{Binding Labels.CpuBoostCaption}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="segmented" IsEnabled="{Binding CpuBoostAvailable}">
              <ItemsControl ItemsSource="{Binding CpuBoostChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CpuBoostChoice">
                    <Button Classes="seg" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>

          <!-- MUX switch: a compact picker and one Apply, because the write needs a reboot to take effect. -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MuxAvailable}">
            <TextBlock Classes="caps" Text="{Binding Labels.MuxSwitch}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding GpuModes}" SelectedItem="{Binding SelectedGpuMode}"
                        MinWidth="170">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GpuModeChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Content="{Binding Labels.ApplyMode}"
                      Command="{Binding ApplyGpuModeCommand}" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Labels.MuxHint}" IsVisible="{Binding MuxAvailable}" />
        </StackPanel>
      </Border>

      <!-- ============================================================ game profiles -->

      <Border Classes="card" IsVisible="{Binding AutoGameModeAvailable}">
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="section" Text="{Binding Labels.GameProfiles}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="badge" Margin="0,0,12,0">
              <TextBlock Text="{Binding GameStatusText}" />
            </Border>
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoGameModeOn}"
                          ToolTip.Tip="{Binding Labels.AutoGameDetect}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <ComboBox ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGameProfile}"
                      HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Labels.QuickGame}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GameProfileRow">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0"
                    Content="{Binding Labels.AddGame}" Command="{Binding AddGameProfileCommand}" />
            <Button Grid.Column="2" Classes="danger" Margin="8,0,0,0"
                    Content="{Binding Labels.DeleteProfile}"
                    Command="{Binding SelectedGameProfile.DeleteCommand}" />
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Labels.AutoGameModeHint}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
