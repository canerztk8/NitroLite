<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             x:Class="NitroLite.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel">

  <ScrollViewer>
    <!-- Capped and centred: on a 2K window an uncapped card row stretches until the numbers are a screen apart. -->
    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Margin="18" Spacing="14">

      <!-- A machine with no Acer nodes still opens a window; this is the sentence that explains it. -->
      <Border Classes="card" IsVisible="{Binding HasNoBackend}">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="{Binding Labels.NoBackend}" />
          <TextBlock Classes="caption" Text="{Binding NoBackendDetail}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="h2" Text="{Binding Labels.ThermalAndFans}" />

      <!-- The three thermals. Each card carries its own last-minute trace, so a reading that is climbing is visible
           without waiting for the number to change. The SYS card has no trace, so it gets a spacer instead: the three
           cards have to end on the same line. -->
      <Grid ColumnDefinitions="*,*,*">
        <Border Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{Binding Labels.Cpu}" />
            <TextBlock Classes="value" Text="{Binding CpuTemperatureText}" />
            <controls:SparklineChart Height="34"
                                     Values="{Binding CpuTemperatureHistory}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     Fill="{DynamicResource ChartFillBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <TextBlock Classes="muted" Text="{Binding Labels.LastMinute}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{Binding Labels.Gpu}" />
            <TextBlock Classes="value" Text="{Binding GpuTemperatureText}" />
            <controls:SparklineChart Height="34"
                                     Values="{Binding GpuTemperatureHistory}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     Fill="{DynamicResource ChartFillBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <TextBlock Classes="muted" Text="{Binding Labels.LastMinute}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{Binding Labels.Sys}" />
            <TextBlock Classes="value" Text="{Binding SysTemperatureText}" />
            <controls:SparklineChart Height="34"
                                     Values="{Binding SysTemperatureHistory}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     Fill="{DynamicResource ChartFillBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <TextBlock Classes="muted" Text="{Binding Labels.LastMinute}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,*">
        <Border Classes="card" Margin="0,0,10,0">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="{Binding Labels.Cpu}" VerticalAlignment="Center" />
              <!-- "ölçüldü" vs "tahmini": the difference decides whether the stall watchdog may act, so it is shown
                   rather than hidden in a log. -->
              <Border Grid.Column="1" Classes="pill">
                <TextBlock Classes="caption" Text="{Binding FanRpmSourceText}" />
              </Border>
            </Grid>
            <TextBlock Classes="value" Text="{Binding CpuFanRpmText}" />
            <controls:SparklineChart Height="34"
                                     Values="{Binding CpuFanHistory}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     Fill="{DynamicResource ChartFillBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <TextBlock Classes="muted" Text="{Binding Labels.LastMinute}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="{Binding Labels.Gpu}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="pill">
                <TextBlock Classes="caption" Text="{Binding FanRpmSourceText}" />
              </Border>
            </Grid>
            <TextBlock Classes="value" Text="{Binding GpuFanRpmText}" />
            <controls:SparklineChart Height="34"
                                     Values="{Binding GpuFanHistory}"
                                     Stroke="{DynamicResource AccentBrush}"
                                     Fill="{DynamicResource ChartFillBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <TextBlock Classes="muted" Text="{Binding Labels.LastMinute}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Operating mode. One card per mode the firmware advertises, and the click is the whole gesture: there is no
           Apply button, so the list can never show one mode while the machine runs another. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.OperatingMode}" />

          <ItemsControl ItemsSource="{Binding Modes}" IsEnabled="{Binding ModeControlAvailable}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Modes.Count}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModeChoice">
                <Button Classes="modecardbutton"
                        Command="{Binding SelectCommand}"
                        Margin="0,0,8,0">
                  <Border Classes="modecard" Classes.selected="{Binding IsSelected}">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <PathIcon Grid.Row="0" Grid.Column="0" Data="{Binding Icon}" HorizontalAlignment="Left" />
                      <Ellipse Grid.Row="0" Grid.Column="1" Classes="selecteddot" IsVisible="{Binding IsSelected}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="modetitle"
                                 Text="{Binding Label}" Margin="0,6,0,0" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted"
                                 Text="{Binding Description}" Margin="0,6,0,0" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Fan mode, the same way. The custom-speed sliders only appear for the custom card, because they are the only
           thing that card means. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding Labels.FanMode}" />

          <ItemsControl ItemsSource="{Binding FanModes}" IsEnabled="{Binding FanControlAvailable}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding FanModes.Count}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FanModeChoice">
                <Button Classes="modecardbutton"
                        Command="{Binding SelectCommand}"
                        Margin="0,0,8,0">
                  <Border Classes="modecard" Classes.selected="{Binding IsSelected}">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <PathIcon Grid.Row="0" Grid.Column="0" Data="{Binding Icon}" HorizontalAlignment="Left" />
                      <Ellipse Grid.Row="0" Grid.Column="1" Classes="selecteddot" IsVisible="{Binding IsSelected}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="modetitle"
                                 Text="{Binding Label}" Margin="0,6,0,0" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted"
                                 Text="{Binding Description}" Margin="0,6,0,0" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="panel" IsVisible="{Binding CustomFanVisible}">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="{Binding Labels.CustomFanSpeed}" />
              <Grid ColumnDefinitions="*,48">
                <TextBlock Classes="caption" Text="{Binding Labels.CpuFanPercent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CustomCpuPercentText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CustomCpuPercent}" />
              <Grid ColumnDefinitions="*,48">
                <TextBlock Classes="caption" Text="{Binding Labels.GpuFanPercent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CustomGpuPercentText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CustomGpuPercent}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*">
        <Border Classes="card" Margin="0,0,10,0" IsVisible="{Binding MuxAvailable}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{Binding Labels.MuxSwitch}" />
            <ComboBox ItemsSource="{Binding GpuModes}"
                      SelectedItem="{Binding SelectedGpuMode}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GpuModeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" Text="{Binding Labels.MuxHint}" />
            <Button Classes="primary"
                    Content="{Binding Labels.Apply}"
                    Command="{Binding ApplyGpuModeCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.ColumnSpan="{Binding SchoolModeColumnSpan}" Classes="card" IsVisible="{Binding SchoolModeAvailable}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{Binding Labels.SchoolMode}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SchoolModeOn}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding Labels.SchoolModeHint}" />
            <TextBlock Classes="caption" Text="{Binding SchoolModeDetail}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Automatic game switching. The card is only shown when the composition root wired a process scanner, so a
           build without one does not offer a switch that can never fire. -->
      <Border Classes="card" IsVisible="{Binding AutoGameModeAvailable}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{Binding Labels.GameMode}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGameModeOn}" />
          </Grid>
          <TextBlock Classes="caption" Text="{Binding Labels.AutoGameModeHint}" />
          <Border Classes="pill" HorizontalAlignment="Left">
            <TextBlock Classes="caption" Text="{Binding GameStatusText}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="{Binding Labels.FanCurve}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CurvePreview}" VerticalAlignment="Center" />
          </Grid>

          <!-- Even split: the drawing and the six sliders are equally important, and the old 2:3 left the sliders
               squeezed against the card edge. -->
          <Grid ColumnDefinitions="*,*">
            <controls:FanCurvePreview Height="210"
                                      Points="{Binding CurvePoints}"
                                      CurrentTemperature="{Binding CurrentTemperature}"
                                      SurfaceBrush="{DynamicResource PanelBrush}"
                                      BandBrush="{DynamicResource DangerSoftBrush}"
                                      CurveBrush="{DynamicResource AccentBrush}"
                                      MarkerBrush="{DynamicResource WarningBrush}"
                                      GridBrush="{DynamicResource CardBorderBrush}"
                                      TextBrush="{DynamicResource TextMutedBrush}"
                                      FloorBrush="{DynamicResource DangerBrush}" />

            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
              <ItemsControl ItemsSource="{Binding CurveAnchors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CurveAnchorViewModel">
                    <!-- Docked rather than a four-column Grid: the fixed columns of a Grid overflow the card once the
                         window is near its minimum width, and the slider's thumb is centred on the track's start, so
                         it hangs half outside the control. Docking gives the label an exact width and the slider the
                         rest, and the margin keeps the thumb off the label at every width. -->
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Left" Width="52"
                                 Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock DockPanel.Dock="Right" Width="120" Classes="caption"
                                 Text="{Binding SafetyText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                      <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                 Text="{Binding EffectiveText}" VerticalAlignment="Center" />
                      <Slider Minimum="30" Maximum="100"
                              Margin="10,0,10,0"
                              MinWidth="60"
                              TickFrequency="1" IsSnapToTickEnabled="True"
                              Value="{Binding Percent}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>

          <Border Classes="panel">
            <StackPanel Spacing="2">
              <TextBlock Classes="caption" Text="{Binding Labels.ThermalFloors}" />
              <TextBlock Classes="caption" Text="{Binding ThermalFloorSummary}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox IsChecked="{Binding CurveEnabled}"
                      Content="{Binding Labels.EnableCurve}"
                      VerticalAlignment="Center" />
            <Button Classes="primary"
                    Content="{Binding Labels.ApplyCurve}"
                    Command="{Binding ApplyCurveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
