<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroLite.Desktop.ViewModels"
             xmlns:controls="using:NitroLite.Desktop.Controls"
             x:Class="NitroLite.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel">

  <!--
    Page 1: the control centre, in the WPF window's tight, scroll-free arrangement. The 60-second band, the mode
    tiles, the fan card, the GPU/CPU card and the game card, in that order, with no full-width rows and no Apply
    buttons. The page title is 18px and the cards are 12px apart, which is what makes the whole page fit in 730px.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel>

      <TextBlock Classes="pagetitle" Text="{Binding Labels.NavModes}" />

      <!-- The backend is unreachable. The page stays readable and this line says which controls are off and why: a
           page that greys out with no explanation reads as a broken window rather than as a machine without an Acer
           service. Only the controls that write to the hardware are disabled; the readouts keep updating. -->
      <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="2"
              Background="{DynamicResource DangerSoftBrush}"
              BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
              IsVisible="{Binding HasModeLockNote}">
        <TextBlock Classes="hint" Text="{Binding Labels.ModeLockNote}"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </Border>

      <!-- A control was written this session and the machine did not confirm it. One line, with the same
           compatibility-report action the settings page has: a toggle that silently does nothing is the one thing a
           user cannot debug alone, and this is where they were using it. -->
      <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="2"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource CardBorderStrongBrush}" BorderThickness="1"
              IsVisible="{Binding HasVerificationHint}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="hint" Text="{Binding VerificationHintText}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Margin="10,0,0,0" Padding="10,4" FontSize="11"
                  Content="{Binding Labels.ReportCompatibility}"
                  Command="{Binding ReportCompatibilityCommand}"
                  IsVisible="{Binding HardwareReportAvailable}"
                  ToolTip.Tip="{Binding Labels.HardwareReportHint}" />
        </Grid>
      </Border>

      <!-- ============================================================ the 60-second band -->

      <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto">

        <Grid Grid.Row="0" Margin="0,0,0,4" ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="caps" Text="{Binding Labels.Last60Seconds}" />
          <!-- The captions are part of the view-model strings, so they are not repeated here. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Classes="figure" FontSize="10" Text="{Binding SparklineRangeText}"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0" />
            <TextBlock Classes="figure" FontSize="11" Text="{Binding SparklineNowText}" />
            <Button Padding="8,0,0,0" Margin="10,0,0,0" Background="Transparent" BorderThickness="0"
                    Command="{Binding ToggleSparklineBandCommand}"
                    ToolTip.Tip="{Binding Labels.HideCaption}">
              <TextBlock Classes="caps" Text="{Binding SparklineBandToggleText}" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 36px: enough for the trace to keep its shape, thin enough that the cards below stay reachable. The line
             only, no wash: at this height a filled area reads as a bar chart of one value. -->
        <Border Grid.Row="1" Height="36" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="2"
                ClipToBounds="True" IsVisible="{Binding SparklineBandVisible}">
          <Grid>
            <controls:SparklineChart Values="{Binding CpuTemperatureHistory}"
                                     Stroke="{DynamicResource TextPrimaryBrush}"
                                     Baseline="{DynamicResource CardBorderStrongBrush}" />
            <!-- Before the first sample the frame would be an empty rectangle, which reads as a broken chart. -->
            <TextBlock Classes="hint" Text="{Binding SparklineEmptyText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsVisible="{Binding SparklineEmpty}" />
          </Grid>
        </Border>
      </Grid>

      <!-- ============================================================ helper folder warning -->
      <!-- The hardware helper was refused because of the install folder. Without this the reason lived only in a
           settings row, and every control on this page simply failed. -->
      <Border Classes="card" Margin="0,10,0,0" IsVisible="{Binding ShowHelperFolderWarning}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Classes="cardicon" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.HelperFolderWarningTitle}" />
          </StackPanel>
          <TextBlock Classes="hint" Text="{Binding Labels.HelperFolderWarningBody}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- ============================================================ power modes -->

      <Border Classes="card" Margin="0,10,0,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Classes="cardicon" Text="&#xE945;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding PowerModeHeading}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Modes}" IsEnabled="{Binding ModeControlAvailable}"
                        Margin="0,0,-6,-6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Modes.Count}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModeChoice">
                <Button Classes="modetile" Command="{Binding SelectCommand}" Margin="0,0,6,6"
                        HorizontalAlignment="Stretch">
                  <Border Classes="modetile" Classes.selected="{Binding IsSelected}">
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Grid.Column="0" Classes="selecteddot" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <TextBlock Classes="cardicon" Text="{Binding Icon}" />
                          <TextBlock Classes="modetitle" Text="{Binding Label}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="badge" IsVisible="{Binding IsSelected}"
                                Margin="6,0,0,0">
                          <TextBlock Text="{Binding ActiveLabel}" />
                        </Border>
                      </Grid>
                      <TextBlock Classes="hint" Text="{Binding ShortHint}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============================================================ fan control -->

      <Border Classes="card" Margin="0,0,0,8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

          <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="cardicon" Text="&#xE9D9;" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Classes="section" Text="{Binding Labels.FanControl}" />
            </StackPanel>

            <!-- One frame around the four options: they are one choice, not four buttons. -->
            <Border Grid.Column="2" Classes="segmented" IsEnabled="{Binding FanControlAvailable}">
              <ItemsControl ItemsSource="{Binding FanSegments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FanSegmentChoice">
                    <Button Classes="segitem" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,32,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="caps" Text="{Binding Labels.Cpu}" />
              <!-- Shrinks instead of clipping "2364 RPM (%39)" when the section is narrow. -->
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,2,0,6">
                <TextBlock Classes="figurebig" Text="{Binding CpuFanRpmText}" />
              </Viewbox>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuFanBarPercent}"
                           ToolTip.Tip="{Binding Labels.FanRpm}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Classes="caps" Text="{Binding Labels.Gpu}" />
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,2,0,6">
                <TextBlock Classes="figurebig" Text="{Binding GpuFanRpmText}" />
              </Viewbox>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding GpuFanBarPercent}"
                           ToolTip.Tip="{Binding Labels.FanRpm}" />
            </StackPanel>
          </Grid>

          <!-- The manual speeds only mean something in Özel. -->
          <Grid Grid.Row="2" Margin="0,16,0,0" IsVisible="{Binding CustomFanVisible}"
                ColumnDefinitions="44,*,52" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caps" Text="{Binding Labels.Cpu}"
                       Margin="0,0,10,0" />
            <controls:NitroSlider Grid.Row="0" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="1"
                    IsSnapToTickEnabled="True" Value="{Binding CustomCpuPercent}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="figure" Text="{Binding CustomCpuPercentText}"
                       HorizontalAlignment="Right" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caps" Text="{Binding Labels.Gpu}"
                       Margin="0,8,10,0" />
            <controls:NitroSlider Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="1"
                    IsSnapToTickEnabled="True" Value="{Binding CustomGpuPercent}"
                    VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="figure" Text="{Binding CustomGpuPercentText}"
                       HorizontalAlignment="Right" Margin="0,8,0,0" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="hint"
                       Text="{Binding Labels.FanCustomHint}" Margin="0,8,0,0" />
          </Grid>

          <!-- The curve opens right under the readouts when Eğri is the chosen pill. -->
          <StackPanel Grid.Row="3" Margin="0,16,0,0" IsVisible="{Binding CurveEditorVisible}">
            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

            <!-- The ready-made shapes sit above the editor, as in the WPF card: a user who wants a sane curve
                 should not have to drag five anchors to get one. -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
              <TextBlock Classes="caps" Text="{Binding Labels.CurvePresetsCaption}" VerticalAlignment="Center" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding CurvePresets}" Margin="10,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CurvePresetChoice">
                    <Button Classes="segitem" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" Content="{Binding Label}" Margin="0,0,6,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="caps" Text="{Binding Labels.FanCurve}" />
                <Border Classes="infobadge" Margin="6,0,0,0" ToolTip.Tip="{Binding Labels.ThermalFloorSummary}">
                  <TextBlock Text="?" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="figure" FontSize="11" Text="{Binding CurvePreview}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <!-- The trace: temperature across, fan speed up. -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,8,0,0"
                    Background="{DynamicResource PanelBrush}">
              <controls:FanCurvePreview Height="92"
                                        Points="{Binding CurvePoints}"
                                        CurrentTemperature="{Binding CurrentTemperature}"
                                        SurfaceBrush="{DynamicResource PanelBrush}"
                                        BandBrush="{DynamicResource DangerSoftBrush}"
                                        CurveBrush="{DynamicResource TextPrimaryBrush}"
                                        MarkerBrush="{DynamicResource AccentBrush}"
                                        GridBrush="{DynamicResource CardBorderBrush}"
                                        TextBrush="{DynamicResource TextMutedBrush}"
                                        FloorBrush="{DynamicResource DangerBrush}" />
            </Border>

            <!-- The six anchors in two columns of three, as the WPF card had them. A single column of six made the
                 card twice as tall as it needed to be and pushed the game card below the fold. -->
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding CurveAnchors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CurveAnchorViewModel">
                  <Grid ColumnDefinitions="34,*,42" Margin="0,0,12,6">
                    <TextBlock Grid.Column="0" Classes="figure" FontSize="11" Text="{Binding Label}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <controls:NitroSlider Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding Percent}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="figure" FontSize="11" Text="{Binding EffectiveText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No Apply button: the curve is stored and written to the fans as it is dragged. -->
            <TextBlock Classes="hint" Text="{Binding Labels.CurveAutoApplyHint}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>

          <!-- A fan that stops turning while the die is hot is a hardware fault, not a tuning choice, so the guard is
               offered in every fan mode. -->
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <ToggleButton Classes="toggle" IsChecked="{Binding FanProtectionOn}"
                          AutomationProperties.Name="{Binding Labels.FanProtection}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{Binding Labels.FanProtection}" Margin="8,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================================================ GPU and CPU -->

      <Border Classes="card" Margin="0,0,0,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Classes="cardicon" Text="&#xE9D2;" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="section" Text="{Binding Labels.GpuAndCpu}" />
          </StackPanel>

          <!-- CPU boost: three pills, one click each. -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="caps" Text="{Binding Labels.CpuBoostCaption}" />
              <Border Classes="infobadge" Margin="6,0,0,0" ToolTip.Tip="{Binding Labels.CpuBoostHint}">
                <TextBlock Text="?" />
              </Border>
            </StackPanel>
            <Border Grid.Column="2" Classes="segmented" IsEnabled="{Binding CpuBoostAvailable}">
              <ItemsControl ItemsSource="{Binding CpuBoostChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CpuBoostChoice">
                    <Button Classes="segitem" Classes.selected="{Binding IsSelected}"
                            Command="{Binding SelectCommand}" Content="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>

          <!-- MUX switch: a compact picker and one Apply, because the write needs a reboot to take effect. The row
               stays on screen on a machine without the switch and is disabled with a reason: a feature that vanishes
               reads as a bug, one that is greyed out with a note reads as an answer. -->
          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,10,0,10" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="caps" Text="{Binding Labels.MuxSwitch}" />
              <Border Classes="infobadge" Margin="6,0,0,0" ToolTip.Tip="{Binding Labels.MuxHint}">
                <TextBlock Text="?" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding GpuModes}" SelectedItem="{Binding SelectedGpuMode}"
                        MinWidth="170" IsEnabled="{Binding MuxAvailable}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GpuModeChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="primary" Content="{Binding Labels.ApplyMode}" Margin="6,0,0,0"
                      Command="{Binding ApplyGpuModeCommand}" IsEnabled="{Binding MuxAvailable}" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="hint" Text="{Binding Labels.MuxUnavailableNote}" Margin="0,6,0,0"
                     IsVisible="{Binding !MuxAvailable}" />

          <!-- A MUX write only takes effect after a reboot, so the card says so and keeps saying so until the
               machine has restarted. A silent write would look like a switch that does nothing. The badge is bound
               separately from the note because a refused write has something to say and nothing to restart for. -->
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding HasGpuModeNote}">
            <Border Classes="badge" Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                    IsVisible="{Binding ShowPendingGpuModeBadge}">
              <TextBlock Classes="caps" Text="{Binding Labels.RebootRequired}"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Classes="hint" Text="{Binding GpuModeNote}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================================ game profiles -->

      <Border Classes="card" IsVisible="{Binding AutoGameModeAvailable}">
        <StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="cardicon" Text="&#xE7FC;" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Classes="section" Text="{Binding Labels.GameProfiles}" />
              <!-- The state sits beside the title, as in the WPF card, rather than in a pill on the far right. -->
              <TextBlock Classes="hint" Text="{Binding GameStatusText}" Margin="10,0,0,0" />
            </StackPanel>
            <ToggleButton Grid.Column="2" Classes="toggle" IsChecked="{Binding AutoGameModeOn}"
                          AutomationProperties.Name="{Binding Labels.AutoGameDetect}"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="3" Classes="hint" Text="{Binding Labels.AutoGameDetect}"
                       VerticalAlignment="Center" />
          </Grid>

          <!-- The default mouse profile: the configuration the mouse is put into at launch, before any game rule
               has had a chance to override it. Hidden entirely when the ATK integration is off or no mouse answered.
               Picking a configuration applies it, so there is no separate Apply button. -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ShowMouseProfileUi}" Margin="0,0,0,10">
            <TextBlock Classes="caps" Text="{Binding Labels.DefaultMouseProfile}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding MouseProfileOptions}"
                      SelectedItem="{Binding SelectedMouseProfile}" MinWidth="150">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MouseProfileOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10"
                  IsVisible="{Binding ShowMouseProfileUi}" />

          <!-- Which rule the controls below are editing. The executable path is printed under the picker so two
               installs that share an executable name can be told apart. -->
          <Grid ColumnDefinitions="320,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Classes="caps" Text="{Binding Labels.GameToConfigure}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGameProfile}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameProfileRow">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="hint" Text="{Binding SelectedGameProfile.ExePath}" Margin="0,4,0,0"
                         IsVisible="{Binding SelectedGameProfile.HasExePath}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
              <Button Classes="primary" Content="{Binding GameScanButtonText}" Padding="12,7" FontSize="11"
                      Margin="0,0,6,0" Command="{Binding ScanGamesCommand}"
                      IsVisible="{Binding GameScanAvailable}" />
              <Button Classes="primary" Content="{Binding Labels.AddGameFromFile}" Padding="12,7" FontSize="11"
                      Margin="0,0,6,0" Command="{Binding AddGameFromFileCommand}"
                      IsVisible="{Binding GameScanAvailable}" />
              <Button Classes="danger" Content="{Binding Labels.DeleteProfile}" Padding="12,7" FontSize="11"
                      Command="{Binding DeleteSelectedGameCommand}" />
            </StackPanel>
          </Grid>

          <!-- What the last scan or delete did. A scan that finds nothing has to say so, or the button reads as
               broken. -->
          <TextBlock Classes="hint" Text="{Binding GameScanStatus}" Margin="0,0,0,8"
                     IsVisible="{Binding HasGameScanStatus}" TextWrapping="Wrap" />

          <!-- The per-game targets. Each is one click, and each writes straight into the rule. -->
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="2" Padding="10,8"
                  IsVisible="{Binding SelectedGameProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel>

              <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Classes="caps" Text="{Binding Labels.WorkingMode}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding GameModeChoices}" SelectedItem="{Binding SelectedGameMode}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModeChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                  <TextBlock Classes="caps" Text="{Binding Labels.GameCpuBoost}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding CpuBoostChoices}" SelectedItem="{Binding SelectedGameCpuBoost}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CpuBoostChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                  <TextBlock Classes="caps" Text="{Binding Labels.FanProfile}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding GameFanChoices}" SelectedItem="{Binding SelectedGameFanMode}"
                            AutomationProperties.AutomationId="CmbGameFanMode"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FanModeChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                            IsVisible="{Binding ShowMouseProfileUi}">
                  <TextBlock Classes="caps" Text="{Binding Labels.MouseProfiles}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding MouseProfileOptions}"
                            SelectedItem="{Binding SelectedGameMouseProfile}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MouseProfileOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <!-- A game can run its own curve for the length of its session. The editor appears when the fan picker
                   above is set to Özel Eğri, so there is no second switch that can disagree with the picker. -->
              <StackPanel Margin="0,10,0,0" IsVisible="{Binding ShowGameFanCurveEditor}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caps" Text="{Binding Labels.GameFanCurveCaption}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="primary" Content="{Binding Labels.CopyDesktopCurve}" Padding="10,4"
                          FontSize="11" Command="{Binding CopyDesktopCurveCommand}" />
                </Grid>

                <!-- The same six anchors as the desktop card, in three columns of two. -->
                <StackPanel Margin="0,8,0,0">
                  <ItemsControl ItemsSource="{Binding GameCurveAnchors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CurveAnchorViewModel">
                        <Grid ColumnDefinitions="30,*,38" Margin="0,0,14,8">
                          <TextBlock Grid.Column="0" Classes="figure" FontSize="10" Text="{Binding Label}"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                          <controls:NitroSlider Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="1"
                                  IsSnapToTickEnabled="True" Value="{Binding Percent}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="figure" FontSize="10" Text="{Binding EffectiveText}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- The rule's own switch. Every control above writes as it changes, so there is nothing left to save. -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                      IsVisible="{Binding SelectedGameProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ToggleButton Classes="toggle" IsChecked="{Binding GameAutoApply}"
                          AutomationProperties.Name="{Binding Labels.GameAutoApply}" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Labels.GameAutoApplyTooltip}" />
            <TextBlock Classes="hint" Text="{Binding Labels.GameAutoApply}" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
